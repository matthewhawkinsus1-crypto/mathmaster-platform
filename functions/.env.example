# PUBLIC DEPLOYMENT VALUES
# Copy the three public values below into functions/.env.mathmaster-aleks
# before deployment. Replace the project/hosting names if yours differ.
GOOGLE_OAUTH_REDIRECT_URI=https://us-central1-mathmaster-aleks.cloudfunctions.net/oauthCallback
FUNCTIONS_BASE_URL=https://us-central1-mathmaster-aleks.cloudfunctions.net
APP_BASE_URL=https://mathmaster-aleks.web.app

# Comma-separated Google accounts that are granted the teacher role the first
# time they sign in. This is the bootstrap for an empty `teacherDirectory`;
# once one teacher is in, they invite the rest from the Access tab. Leaving it
# set is harmless — entries here are always treated as authorized teachers.
INITIAL_TEACHER_EMAILS=

# SECRET VALUES
# Do not commit the actual values. Set deployed secrets with:
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_ID
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_SECRET
#   firebase functions:secrets:set LINK_ENCRYPTION_KEY
# Generate LINK_ENCRYPTION_KEY with: openssl rand -hex 32
#
# For local-only scripts outside the emulator, these environment names are
# also recognized, but deployed Functions read them from Secret Manager.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINK_ENCRYPTION_KEY=
