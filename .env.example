# Which My Math Path runtime this build uses.
#
#   firebaseProduction  the secure server Path. REQUIRED for any deployment
#                       real students can reach.
#   mockLocal           a developer sandbox. Only honoured in a development
#                       build (`npm run dev`), or in a production build that
#                       also sets VITE_MATHMASTER_ALLOW_MOCK_PATH=true.
#
# A production build with this unset, or set to anything else, does NOT fall
# back to the sandbox. It reports a configuration error on the Path screens,
# because silently serving fake questions to a class is worse than an outage.
VITE_MATHMASTER_EXECUTION_MODE=mockLocal

# Deliberate opt-in for demo/QA builds that want the sandbox in a production
# bundle. Leave this unset for anything a student can sign in to.
# VITE_MATHMASTER_ALLOW_MOCK_PATH=true
