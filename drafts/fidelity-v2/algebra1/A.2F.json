      "representation": "symbolic",
      "prompt": "Write the equation of the line perpendicular to $y={{m}}x{{b|signed}}$ that passes through $({{x}},{{y}})$. The perpendicular slope is ${{pm}}$.",
      "responseFields": [
        {
          "id": "equation",
          "label": "Perpendicular-line equation",
          "inputProfile": "equation",
          "expected": "y={{pm}}x{{newb|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "Perpendicular slopes are negative reciprocals.",
        "reasoning": [
          "The required slope is {{pm}}.",
          "Use the given point with that slope to obtain intercept {{newb}}."
        ],
        "answerSummary": "$y={{pm}}x{{newb|signed}}$"
      },
      "attemptFeedback": [
        "Use the perpendicular slope with the point; do not keep the original slope."
      ],
      "supportHints": [
        "After choosing the new slope, substitute the point to solve for the intercept."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "choice",
            "values": [
              1,
              -1,
              2,
              -2,
              0.5,
              -0.5
            ]
          },
          "b": {
            "type": "int",
            "min": -8,
            "max": 8
          },
          "x": {
            "type": "int",
            "min": -4,
            "max": 4
          },
          "newb": {
            "type": "int",
            "min": -8,
            "max": 8
          }
        },
        "derived": {
          "pm": "-1/m",
          "y": "pm*x+newb"
        }
      }
