      ],
      "solutionReview": {
        "headline": "Each term in one binomial multiplies each term in the other.",
        "reasoning": [
          "The outer and inner products combine to give the linear coefficient {{p}}+{{q}}={{B}}.",
          "The constants multiply to {{p}}({{q}})={{C}}."
        ],
        "answerSummary": "$x^2{{B|signed}}x{{C|signed}}$"
      },
      "attemptFeedback": [
        "Multiply all four term pairs, then combine the two linear terms."
      ],
      "supportHints": [
