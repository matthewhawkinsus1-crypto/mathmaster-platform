            {
              "id": "zero",
              "label": "Zero",
              "inputProfile": "number",
              "expected": "{{root}}"
            },
            {
              "id": "y-intercept",
              "label": "y-intercept",
              "inputProfile": "number",
              "expected": "{{b}}"
            },
            {
              "id": "verify",
              "label": "y-value when x={{root}}",
              "inputProfile": "number",
              "expected": "0"
            }
          ],
          "solutionReview": {
            "headline": "A zero is defined by output 0; the y-intercept is defined by input 0.",
            "reasoning": [
              "At x=0 the output is {{b}}, so {{b}} is the y-intercept.",
              "At x={{root}}, y={{m}}({{root}})+{{b}}=0, so {{root}} is the zero."
            ],
            "answerSummary": "Zero {{root}}; y-intercept {{b}}."
          },
          "attemptFeedback": [
            "Use the definitions x=0 and y=0 to separate the two intercept roles."
          ],
          "supportHints": [
            "A zero is an x-value, not the output at x=0."
          ]
