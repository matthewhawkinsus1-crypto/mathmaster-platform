          "coverageKey": "adaptive-d3b3-intercept-role-verification",
          "dok": 3,
          "difficultyBand": 3,
          "prompt": "For $y={{m}}x{{b|signed}}$, Student A says the zero is {{b}} because it is the number visible when x=0. Student B says the zero is {{root}} because substituting x={{root}} makes y=0. Determine which reasoning matches the definition of a zero, identify both intercepts, and verify the zero in the equation.",
          "responseFields": [
            {
              "id": "student",
              "label": "Which reasoning is valid?",
              "inputProfile": "choice",
              "choices": [
                {
                  "id": "b",
                  "label": "Student B"
                },
                {
                  "id": "a",
                  "label": "Student A"
                }
