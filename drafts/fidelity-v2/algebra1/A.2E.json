      "taskType": "procedural",
      "representation": "symbolic",
      "prompt": "Write the equation of the line parallel to $y={{m}}x{{b|signed}}$ that passes through $({{x}},{{y}})$.",
      "responseFields": [
        {
          "id": "equation",
          "label": "Parallel-line equation",
          "inputProfile": "equation",
          "expected": "y={{m}}x{{newb|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "Parallel lines keep the same slope.",
        "reasoning": [
          "The new line must have slope {{m}}.",
          "Substitute the given point to find the new intercept {{newb}}."
        ],
        "answerSummary": "$y={{m}}x{{newb|signed}}$"
      },
      "attemptFeedback": [
        "Keep the slope and use the point to determine a new intercept."
      ],
      "supportHints": [
        "Parallel lines have equal slopes but different intercepts unless they are the same line."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "int",
            "min": -6,
            "max": 6,
            "exclude": [
              0
            ]
          },
          "b": {
            "type": "int",
            "min": -8,
            "max": 8
          },
          "x": {
            "type": "int",
            "min": -5,
            "max": 5
          },
          "newb": {
            "type": "int",
            "min": -8,
            "max": 8
          }
        },
        "derived": {
          "y": "m*x+newb"
        },
        "constraints": [
          "newb != b"
        ]
      }
    },
