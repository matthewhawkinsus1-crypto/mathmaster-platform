          "id": "answer",
          "label": "Solution set",
          "inputProfile": "set",
          "expected": "{ {{r1}}, {{r2}} }"
        }
      ],
      "solutionReview": {
        "headline": "Taking a square root creates two branches.",
        "reasoning": [
          "From $(x-({{h}}))^2={{sq}}$, write $x-({{h}})=\\pm {{s}}$.",
          "Adding {{h}} gives the two solutions {{r1}} and {{r2}}."
        ],
        "answerSummary": "$\\{ {{r1}}, {{r2}} \\}$"
      },
      "attemptFeedback": [
        "Do not lose the positive/negative pair when taking the square root."
      ],
      "supportHints": [
        "If $u^2={{sq}}$, then $u=\\pm{{s}}$."
      ],
      "generator": {
        "parameters": {
