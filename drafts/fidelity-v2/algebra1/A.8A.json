            "max": 6,
            "exclude": [
              0
            ]
          },
          "t": {
            "type": "int",
            "min": 1,
            "max": 8
          }
        },
        "derived": {
          "mid": "2*p",
          "psq": "p*p",
          "tsq": "t*t",
          "rhs": "tsq-psq",
          "r1": "-p-t",
          "r2": "-p+t"
