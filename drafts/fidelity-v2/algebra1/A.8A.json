    {
      "id": "mm_A_8A_v2_solve-by-factoring",
      "active": true,
      "alignmentKeys": [
        "texas:A.8A"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.8A:v2-solve-by-factoring",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 2,
      "dok": 1,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.8A",
      "taskType": "procedural",
      "representation": "symbolic",
      "prompt": "Solve $x^2{{B|signed}}x{{C|signed}}=0$ by FACTORING. Write the complete solution set.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Solution set",
          "inputProfile": "set",
          "expected": "{ {{r1}}, {{r2}} }"
        }
      ],
      "solutionReview": {
        "headline": "Factoring turns one quadratic equation into two linear equations.",
        "reasoning": [
          "The quadratic factors as $(x-({{r1}}))(x-({{r2}}))=0$.",
          "Set each factor equal to zero to get $x={{r1}}$ and $x={{r2}}$."
        ],
        "answerSummary": "$\\{ {{r1}}, {{r2}} \\}$"
      },
      "attemptFeedback": [
        "Find two integers whose sum matches the middle coefficient and whose product matches the constant."
      ],
      "supportHints": [
        "After factoring, apply the zero-product property to both factors."
      ],
      "generator": {
        "parameters": {
          "r1": {
            "type": "int",
            "min": -8,
            "max": 2
          },
          "span": {
            "type": "int",
            "min": 1,
            "max": 8
          }
        },
        "derived": {
          "r2": "r1+span",
          "B": "-(r1+r2)",
          "C": "r1*r2"
        }
      },
      "variants": [
        {
          "coverageKey": "core-1b2"
        },
        {
          "coverageKey": "challenge-d3b4-dividing-by-variable-loses-root",
          "dok": 3,
          "difficultyBand": 4,
          "taskType": "errorAnalysis",
          "representation": "verbal",
          "prompt": "A student solves $x^2-{{r}}x=0$ by dividing both sides by x and reports only x={{r}}. Diagnose why that division can lose a valid solution, solve the original quadratic by factoring, and verify both roots in the original equation.",
          "responseFields": [
            {
              "id": "diagnosis",
              "label": "Why can dividing by x lose a solution?",
              "inputProfile": "choice",
              "choices": [
                {
                  "id": "zero-case",
                  "label": "Dividing by x assumes x is nonzero, so it discards the possible solution x=0."
                },
                {
                  "id": "always-safe",
                  "label": "Dividing by a variable is always safe, even when the variable may equal 0."
                }
              ],
              "expected": "zero-case"
            },
            {
              "id": "factorization",
              "label": "Factored equation",
              "inputProfile": "equation",
              "expected": "x(x-{{r}})=0"
            },
            {
              "id": "solution-set",
              "label": "Complete solution set",
              "inputProfile": "expression",
              "expected": "{ 0, {{r}} }"
            },
            {
              "id": "check-zero",
              "label": "Original left side at x=0",
              "inputProfile": "number",
              "expected": "0"
            },
            {
              "id": "check-r",
              "label": "Original left side at x={{r}}",
              "inputProfile": "number",
              "expected": "0"
            }
          ],
          "solutionReview": {
            "headline": "An algebraic step is not equivalent if it silently assumes a possible solution is nonzero.",
            "reasoning": [
              "$x^2-{{r}}x=x(x-{{r}})$.",
              "The zero-product property gives x=0 or x={{r}}.",
              "Dividing by x before separating the zero case removes x=0, even though substitution verifies that it is a root."
            ],
            "answerSummary": "Solution set {0, {{r}}}."
          },
          "attemptFeedback": [
            "Before dividing by a variable expression, ask whether that expression could equal zero."
          ],
          "supportHints": [
            "Factor the common x instead of canceling it from an equation equal to zero."
          ],
          "generator": {
            "parameters": {
              "r": {
                "type": "int",
                "min": -9,
                "max": 9,
                "exclude": [
                  0
                ]
              }
            }
          }
        }
      ]
    },
