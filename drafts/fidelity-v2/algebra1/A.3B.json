      "taskType": "procedural",
      "representation": "symbolic",
      "prompt": "A machine makes {{items}} parts in {{minutes}} minutes at a constant rate. How many parts per minute?",
      "solutionReview": {
        "headline": "Connect the representation to the mathematics.",
        "reasoning": [
          "A constant rate is output divided by elapsed input.",
          "Divide {{items}} by {{minutes}}."
        ],
        "answerSummary": "The rate is ${{rate}}$ parts per minute."
      },
      "attemptFeedback": [
        "Use the given information to identify the relationship before computing."
      ],
      "supportHints": [
        "Name what each number represents, then choose the operation or relationship that connects them."
      ],
      "generator": {
        "parameters": {
          "rate": {
            "type": "int",
            "min": 2,
            "max": 15
          },
          "minutes": {
            "type": "int",
            "min": 2,
            "max": 9
          }
        },
        "derived": {
          "items": "rate*minutes"
        }
      },
      "responseFields": [
        {
          "id": "answer",
          "label": "Answer",
          "inputProfile": "number",
          "expected": "{{rate}}"
        }
      ]
    },
