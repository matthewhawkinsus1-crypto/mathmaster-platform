      "prompt": "A machine produces {{rate}} parts per minute at a constant rate, starting from zero parts. Let $p$ be parts and $m$ be minutes. Write the direct-variation equation and use it to find the number of parts after {{time}} minutes.",
      "responseFields": [
        {
          "id": "equation",
          "label": "Model equation",
          "inputProfile": "equation",
          "expected": "p={{rate}}m"
        },
        {
          "id": "value",
          "label": "Parts after {{time}} minutes",
          "inputProfile": "number",
          "expected": "{{total}}"
        }
      ],
      "solutionReview": {
        "headline": "Constant rate from zero is direct variation.",
        "reasoning": [
          "The constant of variation is {{rate}} parts per minute, so $p={{rate}}m$.",
          "Substitute $m={{time}}$ to get $p={{total}}$."
        ],
        "answerSummary": "$p={{rate}}m$ and {{total}} parts."
      },
      "attemptFeedback": [
        "Write the model first, then substitute the requested input."
      ],
      "supportHints": [
        "There is no starting amount, so the intercept is zero."
      ],
      "generator": {
        "parameters": {
          "rate": {
            "type": "int",
            "min": 2,
            "max": 20
          },
          "time": {
            "type": "int",
            "min": 3,
            "max": 15
          }
        },
        "derived": {
          "total": "rate*time"
        }
      },
