    {
      "id": "mm_A_2D_v2_point-to-direct-variation",
      "active": true,
      "alignmentKeys": [
        "texas:A.2D"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.2D:v2-point-to-direct-variation",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 2,
      "dok": 1,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2D",
      "taskType": "procedural",
      "representation": "orderedPairs",
      "prompt": "A direct variation passes through $({{x}},{{y}})$. Write its complete equation in the form $y=kx$.",
      "responseFields": [
        {
          "id": "equation",
          "label": "Direct-variation equation",
          "inputProfile": "equation",
          "expected": "y={{k}}x"
        }
      ],
      "solutionReview": {
        "headline": "Direct variation has zero intercept.",
        "reasoning": [
          "Use $k=y/x={{y}}/{{x}}={{k}}$.",
          "Substitute the constant of variation into $y=kx$."
        ],
        "answerSummary": "$y={{k}}x$"
      },
      "attemptFeedback": [
        "Find the constant ratio $y/x$ before writing the equation."
      ],
      "supportHints": [
        "A direct-variation graph passes through the origin, so there is no added constant."
      ],
      "generator": {
        "parameters": {
          "x": {
            "type": "int",
            "min": 1,
            "max": 10
          },
          "k": {
            "type": "int",
            "min": -6,
            "max": 6,
            "exclude": [
              0
            ]
          }
        },
        "derived": {
          "y": "k*x"
        }
      }
    },
