      "taskType": "representationTranslation",
      "representation": "graph",
      "type": "functionInvestigation",
      "prompt": "Graph $y={{a}}(x-({{h}}))^2{{k|signed}}$ by plotting the three requested points and sketching the parabola. Then report the axis of symmetry and whether the vertex is a minimum or maximum.",
      "equationLatex": "y={{a}}(x-({{h}}))^2{{k|signed}}",
      "functionSpec": {
        "type": "quadratic",
        "a": "{{a}}",
        "h": "{{h}}",
        "k": "{{k}}"
      },
      "graph": {
        "xMin": -8,
        "xMax": 8,
        "yMin": -10,
        "yMax": 12,
        "snapStep": 1
      },
      "pointTasks": [
        {
          "id": "left",
          "label": "Plot the point one unit left of the vertex",
          "x": "{{xl}}",
          "expected": [
            "{{xl}}",
            "{{yl}}"
          ]
        },
        {
          "id": "vertex",
          "label": "Plot the vertex",
          "x": "{{h}}",
          "expected": [
            "{{h}}",
            "{{k}}"
          ]
        },
        {
          "id": "right",
          "label": "Plot the point one unit right of the vertex",
          "x": "{{xr}}",
          "expected": [
            "{{xr}}",
            "{{yr}}"
          ]
        }
      ],
      "analysisRequests": [
        {
          "id": "axis",
          "label": "Axis of symmetry x-value",
          "kind": "value",
          "responseMode": "text",
          "expected": [
            "{{h}}"
          ]
        },
        {
          "id": "extremumType",
          "label": "Enter MINIMUM",
          "kind": "value",
          "responseMode": "text",
          "expected": [
            "minimum"
          ]
        }
      ],
      "solutionReview": {
        "headline": "Vertex form gives both the center of the graph and its symmetry.",
        "reasoning": [
          "The vertex is $({{h}},{{k}})$. Points one unit to either side have the same output, so they anchor the symmetric parabola.",
          "The axis of symmetry is $x={{h}}$. Because $a>0$ in this family, the parabola opens upward and the vertex is a minimum."
        ],
        "answerSummary": "Axis $x={{h}}$; vertex type: minimum."
      },
      "attemptFeedback": [
        "Check the vertex first, then use symmetry to compare the left and right points."
      ],
      "supportHints": [
        "In $y=a(x-h)^2+k$, the vertex is $(h,k)$ and the sign of $a$ controls opening direction."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "choice",
            "values": [
              1,
              2,
              3
            ]
          },
          "h": {
            "type": "int",
            "min": -4,
            "max": 4
          },
          "k": {
            "type": "int",
            "min": -5,
            "max": 5
          }
        },
        "derived": {
          "xl": "h-1",
          "xr": "h+1",
          "yl": "a+k",
          "yr": "a+k",
          "extremum": "1"
        }
      }
