{"standard":"A.11B","verdict":"REBUILD","certificationStatus":"candidate-rational-and-integral-exponent-coverage","documents":[{"id":"mm_A_11B_v2_product-integral-powers","active":true,"alignmentKeys":["texas:A.11B"],"courseId":"algebra1","familyId":"mathmaster:A.11B:v2-product-integral-powers","familyVersion":3,"questionType":"response","activityRole":"practice","difficultyBand":2,"dok":1,"calculatorPolicy":"inherit","assessedConstruct":"A.11B","taskType":"procedural","representation":"symbolic","prompt":"Simplify $x^{{a}}\\cdot x^{{b}}$ completely.","responseFields":[{"id":"answer","label":"Simplified expression","inputProfile":"expression","expected":"x^{{e}}"}],"solutionReview":{"headline":"Multiply like bases by adding exponents.","reasoning":["The base is the same in both factors, so add the exponents.","${{a}}+{{b}}={{e}}$, giving $x^{{e}}$."],"answerSummary":"$x^{{e}}$"},"attemptFeedback":["Keep the base and combine the exponents using the product rule."],"supportHints":["For the same nonzero base, $x^m x^n=x^{m+n}$."],"generator":{"parameters":{"a":{"type":"int","min":1,"max":8},"b":{"type":"int","min":1,"max":8}},"derived":{"e":"a+b"}}},{"id":"mm_A_11B_v2_quotient-negative-to-positive","active":true,"alignmentKeys":["texas:A.11B"],"courseId":"algebra1","familyId":"mathmaster:A.11B:v2-quotient-negative-to-positive","familyVersion":3,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"inherit","assessedConstruct":"A.11B","taskType":"representationTranslation","representation":"symbolic","prompt":"Simplify $x^{{a}}/x^{{b}}$ and write the answer using POSITIVE exponents only.","responseFields":[{"id":"answer","label":"Simplified expression","inputProfile":"expression","expected":"1/x^{{k}}"}],"solutionReview":{"headline":"A negative exponent can be rewritten as a reciprocal with a positive exponent.","reasoning":["The quotient rule gives exponent ${{a}}-{{b}}=-{{k}}$.","Rewrite $x^{-{{k}}}$ as $1/x^{{k}}$."],"answerSummary":"$1/x^{{k}}$"},"attemptFeedback":["Subtract the denominator exponent from the numerator exponent, then remove any negative exponent."],"supportHints":["$x^{-n}=1/x^n$ for nonzero $x$."],"generator":{"parameters":{"a":{"type":"int","min":1,"max":6},"gap":{"type":"int","min":1,"max":7}},"derived":{"b":"a+gap","k":"gap"}}},{"id":"mm_A_11B_v2_numeric-rational-exponent","active":true,"alignmentKeys":["texas:A.11B"],"courseId":"algebra1","familyId":"mathmaster:A.11B:v2-numeric-rational-exponent","familyVersion":3,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"inherit","assessedConstruct":"A.11B","taskType":"application","representation":"symbolic","prompt":"Evaluate ${{base}}^({{p}}/{{q}})$ exactly.","responseFields":[{"id":"answer","label":"Exact value","inputProfile":"number","expected":"{{value}}"}],"solutionReview":{"headline":"A rational exponent combines a root and a power.","reasoning":["Because ${{base}}={{root}}^{{q}}$, the ${{q}}$th root of {{base}} is {{root}}.","Raise that root to the {{p}} power to get {{value}}."],"answerSummary":"${{value}}$"},"attemptFeedback":["Interpret the denominator of the exponent as the root and the numerator as the power."],"supportHints":["$a^{m/n}=(\\sqrt[n]{a})^m$."],"generator":{"parameters":{"root":{"type":"int","min":2,"max":5},"q":{"type":"int","min":2,"max":3},"p":{"type":"int","min":1,"max":3}},"derived":{"base":"pow(root,q)","value":"pow(root,p)"}}},{"id":"mm_A_11B_v2_add-rational-exponents","active":true,"alignmentKeys":["texas:A.11B"],"courseId":"algebra1","familyId":"mathmaster:A.11B:v2-add-rational-exponents","familyVersion":3,"questionType":"response","activityRole":"practice","difficultyBand":4,"dok":2,"calculatorPolicy":"inherit","assessedConstruct":"A.11B","taskType":"representationTranslation","representation":"symbolic","prompt":"Simplify $x^({{p}}/{{q}})\\cdot x^({{r}}/{{q}})$ completely.","responseFields":[{"id":"answer","label":"Simplified expression","inputProfile":"expression","expected":"x^{{k}}"}],"solutionReview":{"headline":"The product rule applies to rational exponents too.","reasoning":["Add the exponents because the bases match: ${{p}}/{{q}}+{{r}}/{{q}}=({{p}}+{{r}})/{{q}}$.","The numerator sum is {{total}}, which is {{k}} groups of {{q}}, so the exponent simplifies to {{k}}."],"answerSummary":"$x^{{k}}$"},"attemptFeedback":["Add the rational exponents before simplifying the resulting fraction."],"supportHints":["The common denominator stays {{q}} when the numerators are added."],"generator":{"parameters":{"q":{"type":"int","min":2,"max":4},"k":{"type":"int","min":1,"max":3},"p":{"type":"int","min":1,"max":3}},"derived":{"total":"q*k","r":"total-p"},"constraints":["p < total","r > 0"]}},{"id":"mm_A_11B_v2_error-power-of-power-rational","active":true,"alignmentKeys":["texas:A.11B"],"courseId":"algebra1","familyId":"mathmaster:A.11B:v2-error-power-of-power-rational","familyVersion":3,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"inherit","assessedConstruct":"A.11B","taskType":"errorAnalysis","representation":"verbal","prompt":"A student simplifies $(x^({{p}}/{{q}}))^{{q}}$ by ADDING the exponents and writes $x^({{p}}/{{q}}+{{q}})$. Correct the student's work with the simplified expression.","responseFields":[{"id":"answer","label":"Simplified expression","inputProfile":"expression","expected":"x^{{p}}"}],"solutionReview":{"headline":"For a power raised to a power, multiply the exponents.","reasoning":["The outer exponent {{q}} multiplies the inner exponent {{p}}/{{q}}.","$({{p}}/{{q}})\\cdot{{q}}={{p}}$, so the simplified expression is $x^{{p}}$."],"answerSummary":"$x^{{p}}$"},"attemptFeedback":["Identify which exponent law applies to a power raised to another power."],"supportHints":["$(x^m)^n=x^{mn}$, not $x^{m+n}$."],"generator":{"parameters":{"q":{"type":"int","min":2,"max":5},"p":{"type":"int","min":1,"max":7}},"constraints":["p != q"]}}]}