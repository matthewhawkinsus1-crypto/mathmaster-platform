  "documents": [
    {
      "id": "mm_A_2I_v2_ticket-context-to-system",
      "active": true,
      "alignmentKeys": [
        "texas:A.2I"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.2I:v2-ticket-context-to-system",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 2,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2I",
      "taskType": "modeling",
      "representation": "context",
      "prompt": "A school sells {{n}} tickets. Adult tickets cost {{a}} dollars and student tickets cost {{s}} dollars. Total revenue is {{total}} dollars. Let $x$ be adult tickets and $y$ be student tickets. Write the system that models the situation.",
      "responseFields": [
        {
          "id": "count",
          "label": "Ticket-count equation",
          "inputProfile": "equation",
          "expected": "x+y={{n}}"
        },
        {
          "id": "revenue",
          "label": "Revenue equation",
          "inputProfile": "equation",
          "expected": "{{a}}x+{{s}}y={{total}}"
        }
      ],
      "solutionReview": {
        "headline": "Each sentence contributes a different equation.",
        "reasoning": [
          "The total number of tickets gives $x+y={{n}}$.",
          "Price times quantity gives the revenue equation ${{a}}x+{{s}}y={{total}}$."
        ],
        "answerSummary": "$x+y={{n}}$ and ${{a}}x+{{s}}y={{total}}$"
      },
      "attemptFeedback": [
        "Separate the information about number of tickets from the information about money."
      ],
      "supportHints": [
        "One equation counts tickets; the other counts dollars."
      ],
      "generator": {
        "parameters": {
          "x": {
            "type": "int",
            "min": 12,
            "max": 60
          },
          "y": {
            "type": "int",
            "min": 12,
            "max": 60
          },
          "a": {
            "type": "int",
            "min": 8,
            "max": 18
          },
          "s": {
            "type": "int",
            "min": 4,
            "max": 10
          }
        },
        "derived": {
          "n": "x+y",
          "total": "a*x+s*y"
        },
        "constraints": [
          "a>s"
        ]
      }
    },
    {
