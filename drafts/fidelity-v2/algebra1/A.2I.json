      "prompt": "A blend contains {{n}} liters total. Liquid A costs {{a}} dollars per liter and liquid B costs {{b}} dollars per liter. The blend costs {{total}} dollars. Let $x$ be liters of A and $y$ be liters of B. Write the system.",
      "responseFields": [
        {
          "id": "volume",
          "label": "Total-volume equation",
          "inputProfile": "equation",
          "expected": "x+y={{n}}"
        },
        {
          "id": "cost",
          "label": "Total-cost equation",
          "inputProfile": "equation",
          "expected": "{{a}}x+{{b}}y={{total}}"
        }
      ],
      "solutionReview": {
        "headline": "Model quantity and cost with separate equations.",
        "reasoning": [
          "The liters must add to {{n}}, so $x+y={{n}}$.",
          "The cost contributions add to {{total}}, so ${{a}}x+{{b}}y={{total}}$."
        ],
        "answerSummary": "$x+y={{n}}$ and ${{a}}x+{{b}}y={{total}}$"
      },
      "attemptFeedback": [
        "Do not multiply the total liters by one price; each liquid has its own price."
      ],
      "supportHints": [
        "Write one equation for liters and a second for dollars."
      ],
      "generator": {
        "parameters": {
          "x": {
            "type": "int",
            "min": 4,
            "max": 18
          },
          "y": {
            "type": "int",
            "min": 4,
            "max": 18
          },
          "a": {
            "type": "int",
            "min": 2,
            "max": 8
          },
          "b": {
            "type": "int",
            "min": 9,
            "max": 16
          }
        },
        "derived": {
          "n": "x+y",
          "total": "a*x+b*y"
        }
      }
