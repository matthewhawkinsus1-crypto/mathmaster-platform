      "representation": "context",
      "prompt": "A group buys {{n}} sandwiches: turkey sandwiches cost {{t}} dollars and veggie sandwiches cost {{v}} dollars. Let $x$ be turkey and $y$ be veggie. A student writes the cost equation ${{t}}y+{{v}}x={{total}}$. Write the CORRECT system.",
      "responseFields": [
        {
          "id": "count",
          "label": "Count equation",
          "inputProfile": "equation",
          "expected": "x+y={{n}}"
        },
        {
          "id": "cost",
          "label": "Correct cost equation",
          "inputProfile": "equation",
          "expected": "{{t}}x+{{v}}y={{total}}"
        }
      ],
      "solutionReview": {
        "headline": "Coefficients must stay attached to the quantities they price.",
        "reasoning": [
          "$x$ counts turkey sandwiches, so its coefficient must be the turkey price {{t}}.",
          "$y$ counts veggie sandwiches, so its coefficient must be the veggie price {{v}}."
        ],
        "answerSummary": "$x+y={{n}}$ and ${{t}}x+{{v}}y={{total}}$"
      },
      "attemptFeedback": [
        "Read the variable definitions before attaching prices to variables."
      ],
      "supportHints": [
        "Turkey price multiplies turkey count; veggie price multiplies veggie count."
      ],
      "generator": {
        "parameters": {
          "x": {
            "type": "int",
            "min": 8,
            "max": 30
          },
          "y": {
            "type": "int",
            "min": 8,
            "max": 30
          },
          "t": {
            "type": "int",
            "min": 7,
            "max": 13
          },
          "v": {
            "type": "int",
            "min": 4,
            "max": 9
          }
        },
        "derived": {
          "n": "x+y",
          "total": "t*x+v*y"
        },
        "constraints": [
          "t!=v"
        ]
      },
