      "assessedConstruct": "A.2I",
      "taskType": "modeling",
      "representation": "context",
      "prompt": "A blend contains {{n}} liters total. Liquid A costs {{a}} dollars per liter and liquid B costs {{b}} dollars per liter. The blend costs {{total}} dollars. Let $x$ be liters of A and $y$ be liters of B. Write the system.",
      "responseFields": [
        {
          "id": "volume",
          "label": "Total-volume equation",
          "inputProfile": "equation",
          "expected": "x+y={{n}}"
        },
        {
          "id": "cost",
          "label": "Total-cost equation",
          "inputProfile": "equation",
          "expected": "{{a}}x+{{b}}y={{total}}"
        }
      ],
      "solutionReview": {
        "headline": "Model quantity and cost with separate equations.",
        "reasoning": [
          "The liters must add to {{n}}, so $x+y={{n}}$.",
          "The cost contributions add to {{total}}, so ${{a}}x+{{b}}y={{total}}$."
        ],
        "answerSummary": "$x+y={{n}}$ and ${{a}}x+{{b}}y={{total}}$"
      },
      "attemptFeedback": [
        "Do not multiply the total liters by one price; each liquid has its own price."
      ],
      "supportHints": [
        "Write one equation for liters and a second for dollars."
      ],
      "generator": {
        "parameters": {
          "x": {
            "type": "int",
            "min": 4,
            "max": 18
          },
          "y": {
            "type": "int",
            "min": 4,
            "max": 18
          },
          "a": {
            "type": "int",
            "min": 2,
            "max": 8
          },
          "b": {
            "type": "int",
            "min": 9,
            "max": 16
          }
        },
        "derived": {
          "n": "x+y",
          "total": "a*x+b*y"
        }
      }
    },
    {
      "id": "mm_A_2I_v2_table-two-plans-to-system",
      "active": true,
      "alignmentKeys": [
        "texas:A.2I"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.2I:v2-table-two-plans-to-system",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 3,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2I",
      "taskType": "representationTranslation",
      "representation": "table",
      "prompt": "The table shows the cost of two linear plans for the same input $x$. Write a system with equations $y=$ for Plan A and Plan B.",
      "stimulus": {
        "kind": "table",
        "table": {
          "headers": [
            "$x$",
            "Plan A",
            "Plan B"
          ],
          "rows": [
            [
              "0",
              "{{a0}}",
              "{{b0}}"
            ],
            [
              "{{step}}",
              "{{a1}}",
              "{{b1}}"
            ],
            [
              "{{step2}}",
              "{{a2}}",
              "{{b2}}"
            ]
          ]
        }
      },
      "responseFields": [
        {
          "id": "planA",
          "label": "Plan A equation",
          "inputProfile": "equation",
          "expected": "y={{ar}}x{{a0|signed}}"
        },
        {
          "id": "planB",
          "label": "Plan B equation",
          "inputProfile": "equation",
          "expected": "y={{br}}x{{b0|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "Each column defines its own linear function.",
        "reasoning": [
          "Plan A begins at {{a0}} and changes at rate {{ar}}, giving $y={{ar}}x{{a0|signed}}$.",
          "Plan B begins at {{b0}} and changes at rate {{br}}, giving $y={{br}}x{{b0|signed}}$."
        ],
        "answerSummary": "$y={{ar}}x{{a0|signed}}$ and $y={{br}}x{{b0|signed}}$"
      },
      "attemptFeedback": [
        "Treat each plan column as its own table-to-equation problem."
      ],
      "supportHints": [
        "The row with $x=0$ gives each intercept. Use another row to find each slope."
      ],
      "generator": {
        "parameters": {
          "ar": {
            "type": "int",
            "min": 2,
            "max": 9
          },
          "br": {
            "type": "int",
            "min": 2,
            "max": 9
          },
          "a0": {
            "type": "int",
            "min": 5,
            "max": 30
          },
          "b0": {
            "type": "int",
            "min": 5,
            "max": 30
          },
          "step": {
            "type": "int",
            "min": 2,
            "max": 5
          }
        },
        "derived": {
          "step2": "2*step",
          "a1": "ar*step+a0",
          "a2": "ar*step2+a0",
          "b1": "br*step+b0",
          "b2": "br*step2+b0"
        },
        "constraints": [
          "ar!=br",
          "a0!=b0"
        ]
      }
    },
    {
      "id": "mm_A_2I_v2_error-analysis-mixed-variables",
      "active": true,
      "alignmentKeys": [
        "texas:A.2I"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.2I:v2-error-analysis-mixed-variables",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 3,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2I",
      "taskType": "errorAnalysis",
      "representation": "context",
      "prompt": "A group buys {{n}} sandwiches: turkey sandwiches cost {{t}} dollars and veggie sandwiches cost {{v}} dollars. Let $x$ be turkey and $y$ be veggie. A student writes the cost equation ${{t}}y+{{v}}x={{total}}$. Write the CORRECT system.",
      "responseFields": [
        {
          "id": "count",
          "label": "Count equation",
          "inputProfile": "equation",
          "expected": "x+y={{n}}"
        },
        {
          "id": "cost",
          "label": "Correct cost equation",
          "inputProfile": "equation",
          "expected": "{{t}}x+{{v}}y={{total}}"
        }
      ],
      "solutionReview": {
        "headline": "Coefficients must stay attached to the quantities they price.",
        "reasoning": [
          "$x$ counts turkey sandwiches, so its coefficient must be the turkey price {{t}}.",
          "$y$ counts veggie sandwiches, so its coefficient must be the veggie price {{v}}."
        ],
        "answerSummary": "$x+y={{n}}$ and ${{t}}x+{{v}}y={{total}}$"
      },
      "attemptFeedback": [
        "Read the variable definitions before attaching prices to variables."
      ],
      "supportHints": [
        "Turkey price multiplies turkey count; veggie price multiplies veggie count."
      ],
      "generator": {
        "parameters": {
          "x": {
            "type": "int",
            "min": 8,
            "max": 30
          },
          "y": {
            "type": "int",
            "min": 8,
            "max": 30
          },
          "t": {
            "type": "int",
            "min": 7,
            "max": 13
          },
          "v": {
            "type": "int",
            "min": 4,
            "max": 9
          }
        },
        "derived": {
          "n": "x+y",
          "total": "t*x+v*y"
        },
        "constraints": [
          "t!=v"
        ]
      }
    },
    {
      "id": "mm_A_2I_v2_reverse-build-system-from-solution",
      "active": true,
      "alignmentKeys": [
        "texas:A.2I"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.2I:v2-reverse-build-system-from-solution",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 4,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2I",
      "taskType": "representationTranslation",
      "representation": "graph",
      "prompt": "The graph shows two linear models, A and B. Write BOTH equations in slope-intercept form.",
      "responseFields": [
        {
          "id": "modelA",
          "label": "Model A equation",
          "inputProfile": "equation",
          "expected": "y={{m1}}x{{b1|signed}}"
        },
        {
          "id": "modelB",
          "label": "Model B equation",
          "inputProfile": "equation",
          "expected": "y={{m2}}x{{b2|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "Each graphed line contributes one equation to the system.",
        "reasoning": [
          "Model A has slope {{m1}} and $y$-intercept {{b1}}, so $y={{m1}}x{{b1|signed}}$.",
          "Model B has slope {{m2}} and $y$-intercept {{b2}}, so $y={{m2}}x{{b2|signed}}$."
        ],
        "answerSummary": "The system is $y={{m1}}x{{b1|signed}}$ and $y={{m2}}x{{b2|signed}}$."
      },
      "attemptFeedback": [
        "Treat the two lines separately: read each slope and each $y$-intercept, then write two equations."
      ],
      "supportHints": [
        "The solid/dashed styling distinguishes the two models here; it does not change either equation."
      ],
      "generator": {
        "parameters": {
          "x": {
            "type": "int",
            "min": -2,
            "max": 2
          },
          "y": {
            "type": "int",
            "min": -4,
            "max": 4
          },
          "m1": {
            "type": "int",
            "min": -3,
            "max": 3,
            "exclude": [
              0
            ]
          },
          "m2": {
            "type": "int",
            "min": -3,
            "max": 3,
            "exclude": [
              0
            ]
          }
        },
        "derived": {
          "b1": "y-m1*x",
          "b2": "y-m2*x",
          "a2y": "2*m1+b1",
          "b2y": "2*m2+b2"
        },
        "constraints": [
          "m1!=m2",
          "abs(b1)<=7",
          "abs(b2)<=7"
        ]
      },
      "stimulus": {
        "kind": "graph",
        "title": "Two linear models",
        "graph": {
          "xMin": -6,
          "xMax": 6,
          "yMin": -10,
          "yMax": 10,
          "ariaLabel": "Graph of two intersecting linear models labelled A and B",
          "lines": [
            {
              "label": "Model A",
              "boundaryStyle": "solid",
              "points": [
                {
                  "x": 0,
                  "y": "{{b1}}"
                },
                {
                  "x": 2,
                  "y": "{{a2y}}"
                }
              ]
            },
            {
              "label": "Model B",
              "boundaryStyle": "dashed",
              "points": [
                {
                  "x": 0,
                  "y": "{{b2}}"
                },
                {
                  "x": 2,
                  "y": "{{b2y}}"
                }
              ]
            }
          ]
        }
      }
    }
  ]
