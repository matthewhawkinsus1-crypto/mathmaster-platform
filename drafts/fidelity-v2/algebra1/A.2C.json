  "documents": [
    {
      "id": "mm_A_2C_v2_table-to-equation",
      "active": true,
      "alignmentKeys": [
        "texas:A.2C"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.2C:v2-table-to-equation",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 2,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2C",
      "taskType": "representationTranslation",
      "representation": "table",
      "prompt": "The table represents a linear function. Write its equation in slope-intercept form.",
      "stimulus": {
        "kind": "table",
        "table": {
          "headers": [
            "$x$",
            "$y$"
          ],
          "rows": [
            [
              "{{x0}}",
              "{{y0}}"
            ],
            [
              "{{x1}}",
              "{{y1}}"
            ],
            [
              "{{x2}}",
              "{{y2}}"
            ]
          ]
        }
      },
      "responseFields": [
        {
          "id": "answer",
          "label": "Linear equation",
          "inputProfile": "equation",
          "expected": "y={{m}}x{{b|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "Turn the table into rate of change and initial value.",
        "reasoning": [
          "The slope is the constant ratio $\\Delta y/\\Delta x={{m}}$.",
          "Use any table point in $y=mx+b$ to recover the intercept $b={{b}}$."
        ],
        "answerSummary": "$y={{m}}x{{b|signed}}$"
      },
      "attemptFeedback": [
        "Find the change in $y$ for one change in $x$, then determine the value when $x=0$."
      ],
      "supportHints": [
        "Start with two consecutive rows and calculate $\\Delta y/\\Delta x$."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "int",
            "min": -6,
            "max": 6,
            "exclude": [
              0
            ]
          },
          "b": {
            "type": "int",
            "min": -10,
            "max": 10
          },
          "x0": {
            "type": "int",
            "min": -4,
            "max": 0
          },
          "step": {
            "type": "int",
            "min": 1,
            "max": 3
          }
        },
        "derived": {
          "x1": "x0+step",
          "x2": "x0+2*step",
          "y0": "m*x0+b",
          "y1": "m*x1+b",
          "y2": "m*x2+b"
        }
      }
    },
    {
      "id": "mm_A_2C_v2_verbal-rate-start-to-equation",
      "active": true,
      "alignmentKeys": [
        "texas:A.2C"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.2C:v2-verbal-rate-start-to-equation",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 2,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2C",
      "taskType": "modeling",
      "representation": "context",
      "prompt": "A tank starts with {{b}} liters of water and changes by {{m}} liters each minute. Let $t$ be minutes and $W$ be liters of water. Write the linear equation relating $W$ and $t$.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Equation",
          "inputProfile": "equation",
          "expected": "W={{m}}t{{b|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "A linear situation needs a starting value and a rate.",
        "reasoning": [
          "At $t=0$, the tank contains {{b}} liters, so {{b}} is the intercept.",
          "The amount changes by {{m}} liters per minute, so {{m}} is the slope."
        ],
        "answerSummary": "$W={{m}}t{{b|signed}}$"
      },
      "attemptFeedback": [
        "Identify what the amount is at time zero and how much it changes each minute."
      ],
      "supportHints": [
        "Use the structure output = rate(input) + starting value."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "int",
            "min": -8,
            "max": 8,
            "exclude": [
              0
            ]
          },
          "b": {
            "type": "int",
            "min": 20,
            "max": 100
          }
        },
        "constraints": [
          "b + 5*m > 0"
        ]
      }
    },
    {
      "id": "mm_A_2C_v2_points-to-equation",
      "active": true,
      "alignmentKeys": [
        "texas:A.2C"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.2C:v2-points-to-equation",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 3,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2C",
      "taskType": "representationTranslation",
      "representation": "graph",
      "prompt": "The graph shows a linear function. Write its equation in slope-intercept form.",
      "stimulus": {
        "kind": "graph",
        "title": "Linear function",
        "graph": {
          "xMin": -6,
          "xMax": 6,
          "yMin": -10,
          "yMax": 10,
          "ariaLabel": "Graph of one linear function",
          "lines": [
            {
              "label": "Linear function",
              "boundaryStyle": "solid",
              "points": [
                {
                  "x": -2,
                  "y": "{{yLeft}}"
                },
                {
                  "x": 2,
                  "y": "{{yRight}}"
                }
              ]
            }
          ]
        }
      },
      "responseFields": [
        {
          "id": "answer",
          "label": "Equation",
          "inputProfile": "equation",
          "expected": "y={{m}}x{{b|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "Read both slope and intercept from the graph before writing the equation.",
        "reasoning": [
          "The line crosses the $y$-axis at {{b}}, so the intercept is $b={{b}}$.",
          "Using two grid points on the line gives slope {{m}}, so the equation is $y={{m}}x{{b|signed}}$."
        ],
        "answerSummary": "$y={{m}}x{{b|signed}}$"
      },
      "attemptFeedback": [
        "Use the graph to identify the $y$-intercept and the rise/run between two clear grid points."
      ],
      "supportHints": [
        "In $y=mx+b$, $b$ is where the line crosses the $y$-axis and $m$ is rise over run."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "int",
            "min": -3,
            "max": 3,
            "exclude": [
              0
            ]
          },
          "b": {
            "type": "int",
            "min": -5,
            "max": 5
          }
        },
        "derived": {
          "yLeft": "-2*m+b",
          "yRight": "2*m+b"
        }
      }
    },
    {
      "id": "mm_A_2C_v2_error-analysis-table-equation",
      "active": true,
      "alignmentKeys": [
        "texas:A.2C"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.2C:v2-error-analysis-table-equation",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 3,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2C",
      "taskType": "errorAnalysis",
      "representation": "table",
      "prompt": "A student says the table is modeled by $y={{wrongm}}x{{b|signed}}$ because they used the change in $y$ without dividing by the change in $x$. Write the correct equation.",
      "stimulus": {
        "kind": "table",
        "table": {
          "headers": [
            "$x$",
            "$y$"
          ],
          "rows": [
            [
              "{{x1}}",
              "{{y1}}"
            ],
            [
              "{{x2}}",
              "{{y2}}"
            ]
          ]
        }
      },
      "responseFields": [
        {
          "id": "answer",
          "label": "Correct equation",
          "inputProfile": "equation",
          "expected": "y={{m}}x{{b|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "Slope is change in output divided by change in input.",
        "reasoning": [
          "The student's {{wrongm}} is only $\\Delta y$. The run is {{dx}}, so the slope is ${{wrongm}}/{{dx}}={{m}}$.",
          "Using the correct slope with either table point gives the intercept {{b}}."
        ],
        "answerSummary": "$y={{m}}x{{b|signed}}$"
      },
      "attemptFeedback": [
        "Check whether the student's number is a rise or a slope."
      ],
      "supportHints": [
        "A slope needs both a numerator and a denominator: $\\Delta y/\\Delta x$."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "int",
            "min": -4,
            "max": 4,
            "exclude": [
              0
            ]
          },
          "b": {
            "type": "int",
            "min": -8,
            "max": 8
          },
          "x1": {
            "type": "int",
            "min": -3,
            "max": 1
          },
          "dx": {
            "type": "int",
            "min": 2,
            "max": 4
          }
        },
        "derived": {
          "x2": "x1+dx",
          "y1": "m*x1+b",
          "y2": "m*x2+b",
          "wrongm": "m*dx"
        }
      }
    },
    {
