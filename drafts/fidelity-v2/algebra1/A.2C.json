  "documents": [
    {
      "id": "mm_A_2C_v2_table-to-equation",
      "active": true,
      "alignmentKeys": [
        "texas:A.2C"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.2C:v2-table-to-equation",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 2,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2C",
      "taskType": "representationTranslation",
      "representation": "table",
      "prompt": "The table represents a linear function. Write its equation in slope-intercept form.",
      "stimulus": {
        "kind": "table",
        "table": {
          "headers": [
            "$x$",
            "$y$"
          ],
          "rows": [
            [
              "{{x0}}",
              "{{y0}}"
            ],
            [
              "{{x1}}",
              "{{y1}}"
            ],
            [
              "{{x2}}",
              "{{y2}}"
            ]
          ]
        }
      },
      "responseFields": [
        {
          "id": "answer",
          "label": "Linear equation",
          "inputProfile": "equation",
          "expected": "y={{m}}x{{b|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "Turn the table into rate of change and initial value.",
        "reasoning": [
          "The slope is the constant ratio $\\Delta y/\\Delta x={{m}}$.",
          "Use any table point in $y=mx+b$ to recover the intercept $b={{b}}$."
        ],
        "answerSummary": "$y={{m}}x{{b|signed}}$"
      },
      "attemptFeedback": [
        "Find the change in $y$ for one change in $x$, then determine the value when $x=0$."
      ],
      "supportHints": [
        "Start with two consecutive rows and calculate $\\Delta y/\\Delta x$."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "int",
            "min": -6,
            "max": 6,
            "exclude": [
              0
            ]
          },
          "b": {
            "type": "int",
            "min": -10,
            "max": 10
          },
          "x0": {
            "type": "int",
            "min": -4,
            "max": 0
          },
          "step": {
            "type": "int",
            "min": 1,
            "max": 3
          }
        },
        "derived": {
          "x1": "x0+step",
          "x2": "x0+2*step",
          "y0": "m*x0+b",
          "y1": "m*x1+b",
          "y2": "m*x2+b"
        }
      }
    },
    {
      "id": "mm_A_2C_v2_verbal-rate-start-to-equation",
      "active": true,
      "alignmentKeys": [
        "texas:A.2C"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.2C:v2-verbal-rate-start-to-equation",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 2,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2C",
      "taskType": "modeling",
      "representation": "context",
      "prompt": "A tank starts with {{b}} liters of water and changes by {{m}} liters each minute. Let $t$ be minutes and $W$ be liters of water. Write the linear equation relating $W$ and $t$.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Equation",
          "inputProfile": "equation",
          "expected": "W={{m}}t{{b|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "A linear situation needs a starting value and a rate.",
        "reasoning": [
          "At $t=0$, the tank contains {{b}} liters, so {{b}} is the intercept.",
          "The amount changes by {{m}} liters per minute, so {{m}} is the slope."
        ],
        "answerSummary": "$W={{m}}t{{b|signed}}$"
      },
      "attemptFeedback": [
        "Identify what the amount is at time zero and how much it changes each minute."
      ],
      "supportHints": [
        "Use the structure output = rate(input) + starting value."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "int",
            "min": -8,
            "max": 8,
            "exclude": [
              0
            ]
          },
          "b": {
            "type": "int",
            "min": 20,
            "max": 100
          }
        },
        "constraints": [
          "b + 5*m > 0"
        ]
      }
    },
    {
