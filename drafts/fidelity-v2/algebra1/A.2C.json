      "difficultyBand": 3,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2C",
      "taskType": "errorAnalysis",
      "representation": "table",
      "prompt": "A student says the table is modeled by $y={{wrongm}}x{{b|signed}}$ because they used the change in $y$ without dividing by the change in $x$. Write the correct equation.",
      "stimulus": {
        "kind": "table",
        "table": {
          "headers": [
            "$x$",
            "$y$"
          ],
          "rows": [
            [
              "{{x1}}",
              "{{y1}}"
            ],
            [
              "{{x2}}",
              "{{y2}}"
            ]
          ]
        }
      },
      "responseFields": [
        {
          "id": "answer",
          "label": "Correct equation",
          "inputProfile": "equation",
          "expected": "y={{m}}x{{b|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "Slope is change in output divided by change in input.",
        "reasoning": [
          "The student's {{wrongm}} is only $\\Delta y$. The run is {{dx}}, so the slope is ${{wrongm}}/{{dx}}={{m}}$.",
          "Using the correct slope with either table point gives the intercept {{b}}."
        ],
        "answerSummary": "$y={{m}}x{{b|signed}}$"
      },
      "attemptFeedback": [
        "Check whether the student's number is a rise or a slope."
      ],
      "supportHints": [
        "A slope needs both a numerator and a denominator: $\\Delta y/\\Delta x$."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "int",
            "min": -4,
            "max": 4,
            "exclude": [
              0
            ]
          },
          "b": {
            "type": "int",
            "min": -8,
            "max": 8
          },
          "x1": {
            "type": "int",
            "min": -3,
            "max": 1
          },
          "dx": {
            "type": "int",
            "min": 2,
            "max": 4
          }
        },
        "derived": {
          "x2": "x1+dx",
          "y1": "m*x1+b",
          "y2": "m*x2+b",
          "wrongm": "m*dx"
        }
      },
      "variants": [
        {
          "coverageKey": "core-d2b3",
          "dok": 2,
          "difficultyBand": 3
        },
        {
          "coverageKey": "adaptive-d3b3-table-model-cross-check",
          "dok": 3,
          "difficultyBand": 3,
          "prompt": "A table is generated by one linear function. Student A uses only the change in y and proposes $y={{wrongm}}x{{b|signed}}$. Student B divides the change in y by the change in x and proposes $y={{m}}x{{b|signed}}$. Use two intervals from the table to decide which model is consistent, then verify the equation with a third row.",
          "responseFields": [
            {
              "id": "slope",
              "label": "Slope from the table",
              "inputProfile": "number",
              "expected": "{{m}}"
            },
            {
              "id": "choice",
              "label": "Which model is consistent with the table?",
              "inputProfile": "choice",
              "choices": [
                {
                  "id": "student-b",
                  "label": "Student B"
                },
                {
                  "id": "student-a",
                  "label": "Student A"
                }
              ],
              "expected": "student-b"
            },
            {
              "id": "equation",
              "label": "Correct equation",
              "inputProfile": "equation",
              "expected": "y={{m}}x{{b|signed}}"
            },
            {
              "id": "verify",
              "label": "Predicted y for the third-row x-value {{x3}}",
              "inputProfile": "number",
              "expected": "{{y3}}"
            }
          ],
          "generator": {
            "parameters": {
              "m": {
                "type": "int",
                "min": -5,
                "max": 5,
                "exclude": [
                  0
                ]
              },
              "b": {
                "type": "int",
                "min": -8,
                "max": 8
              },
              "x1": {
                "type": "int",
                "min": -5,
                "max": -1
              },
              "step": {
                "type": "int",
                "min": 2,
                "max": 4
              }
            },
            "derived": {
              "x2": "x1+step",
              "x3": "x2+step",
              "y1": "m*x1+b",
              "y2": "m*x2+b",
              "y3": "m*x3+b",
              "wrongm": "m*step",
              "dy": "m*step"
            },
            "constraints": [
              "wrongm!=m"
            ]
          },
          "solutionReview": {
            "headline": "Slope is change in output per unit change in input.",
            "reasoning": [
              "Across each interval, Δx={{step}} and Δy={{dy}}.",
              "Therefore m=Δy/Δx={{m}}, not the raw change {{wrongm}}.",
              "The equation y={{m}}x{{b|signed}} also predicts the third-row value {{y3}}."
            ],
            "answerSummary": "Student B's model is consistent with every row."
          },
          "attemptFeedback": [
            "Use at least two table intervals and then verify the resulting equation on a third row."
          ],
          "supportHints": [
            "Compute Δy/Δx, not Δy alone."
          ]
        }
      ]
    },
