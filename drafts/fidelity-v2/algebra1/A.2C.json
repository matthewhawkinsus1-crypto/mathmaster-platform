      "taskType": "reverseReasoning",
      "representation": "multipleRepresentation",
      "prompt": "A linear relationship has $f({{x1}})={{y1}}$ and $f({{x2}})={{y2}}$. A third point $({{x3}},{{y3}})$ is also on the same line. Use the information together to write the equation for $f(x)$.",
      "stimulus": {
        "kind": "orderedPairs",
        "orderedPairs": [
          {
            "x": "{{x1}}",
            "y": "{{y1}}"
          },
          {
            "x": "{{x2}}",
            "y": "{{y2}}"
          },
          {
            "x": "{{x3}}",
            "y": "{{y3}}"
          }
        ]
      },
      "responseFields": [
        {
          "id": "answer",
          "label": "Function equation",
          "inputProfile": "equation",
          "expected": "f(x)={{m}}x{{b|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "Use the repeated structure, not just one pair.",
        "reasoning": [
          "The slope from the first two points is {{m}}, and the third point confirms the same rate.",
          "Substitute a point into $f(x)=mx+b$ to obtain $b={{b}}$."
        ],
        "answerSummary": "$f(x)={{m}}x{{b|signed}}$"
      },
      "attemptFeedback": [
        "Use at least two points to determine the rate, then use another point as a check."
      ],
      "supportHints": [
        "Find slope first; after that, only the intercept is unknown."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "int",
            "min": -6,
            "max": 6,
            "exclude": [
              0
            ]
          },
          "b": {
            "type": "int",
            "min": -10,
            "max": 10
          },
          "x1": {
            "type": "int",
            "min": -5,
            "max": -1
          },
          "gap1": {
            "type": "int",
            "min": 2,
            "max": 4
          },
          "gap2": {
            "type": "int",
            "min": 1,
            "max": 4
          }
        },
        "derived": {
          "x2": "x1+gap1",
          "x3": "x2+gap2",
          "y1": "m*x1+b",
          "y2": "m*x2+b",
          "y3": "m*x3+b"
        }
      }
    }
  ]
