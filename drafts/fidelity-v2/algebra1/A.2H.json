      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 4,
      "dok": 3,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2H",
      "taskType": "modeling",
      "representation": "context",
      "prompt": "A fundraiser sells adult tickets for {{a}} dollars and student tickets for {{s}} dollars. The room can hold at most {{cap}} people, and ticket revenue must be at least {{goal}} dollars. Let $x$ be adult tickets and $y$ be student tickets. Write the REVENUE inequality only.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Revenue inequality",
          "inputProfile": "inequality",
          "expected": "{{a}}x+{{s}}y>={{goal}}"
        }
      ],
      "solutionReview": {
        "headline": "Decide which quantities belong in the requested constraint.",
        "reasoning": [
          "Capacity uses counts, but the requested revenue constraint uses ticket prices times ticket counts.",
          "Must be at least {{goal}} means the revenue is greater than or equal to {{goal}}."
        ],
        "answerSummary": "${{a}}x+{{s}}y \\ge {{goal}}$"
      },
      "attemptFeedback": [
        "Do not mix the capacity constraint with the revenue constraint; identify what each coefficient represents."
      ],
      "supportHints": [
        "Revenue is price times quantity for each ticket type."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "int",
            "min": 8,
            "max": 18
          },
          "s": {
            "type": "int",
            "min": 4,
            "max": 12
          },
          "cap": {
            "type": "int",
            "min": 80,
            "max": 250
          },
          "goal": {
            "type": "int",
            "min": 500,
            "max": 2200,
            "step": 50
          }
        },
        "constraints": [
          "a > s"
        ]
      }
