    {
      "id": "mm_A_2H_v2_two-constraints-model-choice",
      "active": true,
      "alignmentKeys": [
        "texas:A.2H"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.2H:v2-two-constraints-model-choice",
