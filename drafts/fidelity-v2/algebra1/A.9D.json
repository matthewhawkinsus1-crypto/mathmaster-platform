      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.9D:v2-construct-growth",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.9D",
      "difficultyBand": 2,
      "dok": 2,
      "taskType": "representationTranslation",
      "representation": "graph",
      "type": "functionInvestigation",
      "prompt": "Construct the growth graph $y={{a}}({{base}})^x{{k|signed}}$ by plotting three requested points and sketching the exponential curve. Then identify the y-intercept and horizontal asymptote.",
      "functionSpec": {
        "type": "exponential",
        "a": "{{a}}",
        "b": "{{base}}",
        "k": "{{k}}"
      },
      "graph": {
        "xMin": -4,
        "xMax": 5,
        "yMin": -8,
        "yMax": 45,
        "snapStep": 0.25
      },
      "pointTasks": [
        {
          "id": "p0",
          "label": "Plot x = 0",
          "x": 0,
          "expected": [
            0,
            "{{y0}}"
          ]
        },
        {
          "id": "p1",
          "label": "Plot x = 1",
          "x": 1,
          "expected": [
            1,
            "{{y1}}"
          ]
        },
        {
          "id": "p2",
          "label": "Plot x = 2",
          "x": 2,
          "expected": [
            2,
            "{{y2}}"
          ]
        }
      ],
      "analysisRequests": [
        {
          "id": "yint",
          "label": "y-intercept value",
          "kind": "value",
          "responseMode": "text",
          "expected": [
            "{{y0}}"
          ]
        },
        {
          "id": "asym",
          "label": "horizontal asymptote y-value",
          "kind": "value",
          "responseMode": "text",
          "expected": [
            "{{k}}"
          ]
        }
      ],
      "solutionReview": {
        "headline": "Growth moves away from the asymptote as x increases.",
        "reasoning": [
          "At $x=0$, $b^0=1$, so the y-intercept is {{y0}}.",
          "The vertical shift gives horizontal asymptote $y={{k}}$; because ${{base}}>1$, the graph grows to the right."
        ],
        "answerSummary": "y-intercept {{y0}}; asymptote $y={{k}}$."
      },
      "attemptFeedback": [
        "Make sure the three plotted outputs increase multiplicatively rather than by a constant difference."
      ],
      "supportHints": [
        "Start at x=0, then multiply the distance from the asymptote by the base each step."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "int",
            "min": 1,
            "max": 4
          },
          "base": {
            "type": "choice",
            "values": [
              2,
              3
            ]
          },
          "k": {
            "type": "int",
            "min": -3,
            "max": 3
          }
        },
        "derived": {
          "y0": "a+k",
          "y1": "a*base+k",
          "y2": "a*base*base+k"
        }
      }
    },
