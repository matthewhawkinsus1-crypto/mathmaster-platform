      "taskType": "procedural",
      "representation": "symbolic",
      "prompt": "Solve $P={{a}}l+{{a}}w$ for $l$.",
      "solutionReview": {
        "headline": "Connect the representation to the mathematics.",
        "reasoning": [
          "Subtract ${{a}}w$ from both sides to isolate the term containing $l$.",
          "Divide every remaining term by {{a}}."
        ],
        "answerSummary": "$l=P/{{a}}-w$"
      },
      "attemptFeedback": [
        "Isolate the requested variable symbolically while treating every other letter as a known quantity."
      ],
      "supportHints": [
        "If the target variable appears in more than one term, factor it first; divide by the entire coefficient or factor multiplying it."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "int",
            "min": 2,
            "max": 9
          }
        }
      },
      "responseFields": [
        {
          "id": "answer",
          "label": "Answer",
          "inputProfile": "expression",
          "expected": "P/{{a}}-w",
          "accepted": [
            "(P-{{a}}w)/{{a}}"
          ]
        }
      ]
    },
