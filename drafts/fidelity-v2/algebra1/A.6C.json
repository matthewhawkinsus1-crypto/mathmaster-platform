  "documents": [
    {
      "id": "mm_A_6C_v2_monic-from-zeros",
      "active": true,
      "alignmentKeys": [
        "texas:A.6C"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.6C:v2-monic-from-zeros",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 2,
      "dok": 1,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.6C",
      "taskType": "procedural",
      "representation": "symbolic",
      "prompt": "Write the complete MONIC quadratic equation whose real zeros are $x={{r1}}$ and $x={{r2}}$. Leave the equation in factored form.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Factored quadratic equation",
          "inputProfile": "equation",
          "expected": "y=(x{{nr1|signed}})(x{{nr2|signed}})",
          "accepted": [
            "y=(x{{nr2|signed}})(x{{nr1|signed}})"
          ]
        }
      ],
      "solutionReview": {
        "headline": "A real zero r creates the factor $(x-r)$.",
        "reasoning": [
          "The zeros {{r1}} and {{r2}} give factors $(x{{nr1|signed}})$ and $(x{{nr2|signed}})$.",
          "Monic means leading coefficient 1, so $y=(x{{nr1|signed}})(x{{nr2|signed}})$."
        ]
      },
      "attemptFeedback": [
        "Use the opposite sign of each zero inside its factor."
      ],
      "supportHints": [
        "If x=r makes a factor zero, that factor is x-r."
      ],
      "generator": {
        "parameters": {
          "r1": {
            "type": "int",
            "min": -5,
            "max": 3
          },
          "gap": {
            "type": "int",
            "min": 2,
            "max": 6
          }
        },
        "derived": {
          "r2": "r1+gap",
          "nr1": "-r1",
          "nr2": "-r2"
        }
      }
    },
    {
