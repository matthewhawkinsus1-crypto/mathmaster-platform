      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.6C",
      "taskType": "representationTranslation",
      "representation": "symbolic",
      "prompt": "A quadratic has zeros ${{r1}}$ and ${{r2}}$ and leading coefficient {{a}}. Write the COMPLETE equation in factored form.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Factored quadratic equation",
          "inputProfile": "equation",
          "expected": "y={{a}}(x{{nr1|signed}})(x{{nr2|signed}})",
          "accepted": [
            "y={{a}}(x{{nr2|signed}})(x{{nr1|signed}})"
          ]
        }
      ],
      "solutionReview": {
        "headline": "Zeros determine the factors; the leading coefficient scales the whole product.",
        "reasoning": [
          "Use $(x{{nr1|signed}})(x{{nr2|signed}})$ for the two real zeros.",
          "Multiplying by {{a}} gives the required leading coefficient."
        ]
      },
      "attemptFeedback": [
        "Keep the leading coefficient outside the full product."
      ],
      "supportHints": [
        "Start with $a(x-r_1)(x-r_2)$."
      ],
      "generator": {
