    {
      "id": "mm_A_6C_v2_graph-to-factored-equation",
      "active": true,
      "alignmentKeys": [
        "texas:A.6C"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.6C:v2-graph-to-factored-equation",
