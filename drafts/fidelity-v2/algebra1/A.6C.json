      "representation": "verbal",
      "prompt": "A student is told the zeros are {{r1}} and {{r2}} but writes $y=(x{{r1|signed}})(x{{r2|signed}})$, using the zero signs directly. Correct the student's equation for a MONIC quadratic.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Correct factored equation",
          "inputProfile": "equation",
          "expected": "y=(x{{nr1|signed}})(x{{nr2|signed}})",
          "accepted": [
            "y=(x{{nr2|signed}})(x{{nr1|signed}})"
          ]
        }
      ],
      "solutionReview": {
        "headline": "Factors use the opposite sign of the zeros.",
        "reasoning": [
          "A factor must equal 0 when x equals its zero.",
          "Therefore zeros {{r1}} and {{r2}} produce $(x{{nr1|signed}})$ and $(x{{nr2|signed}})$."
        ]
      },
      "attemptFeedback": [
        "Test each factor by substituting the stated zero."
      ],
      "supportHints": [
        "Zero r corresponds to factor x-r."
      ],
