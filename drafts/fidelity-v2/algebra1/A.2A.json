    {
      "id": "mm_A_2A_v2_decreasing-range-error",
      "active": true,
      "alignmentKeys": [
        "texas:A.2A"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.2A:v2-decreasing-range-error",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 3,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.2A",
      "taskType": "errorAnalysis",
      "representation": "verbal",
      "prompt": "For $p(x)=-{{mag}}x{{b|signed}}$ on $[{{lo}},{{hi}}]$, a student writes the range as $[{{yleft}},{{yright}}]$ in that same left-to-right order. Correct the range in interval notation.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Correct range",
          "inputProfile": "interval",
          "expected": "[{{rlo}},{{rhi}}]"
        }
      ],
      "solutionReview": {
        "headline": "A decreasing function reverses which endpoint produces the minimum and maximum output.",
        "reasoning": [
          "Evaluate both endpoints: $p({{lo}})={{yleft}}$ and $p({{hi}})={{yright}}$.",
          "Interval notation must list the smaller output first, so the range is $[{{rlo}},{{rhi}}]$."
        ]
      },
      "attemptFeedback": [
        "The domain order does not automatically become the range order for a decreasing function."
      ],
      "supportHints": [
        "Compare the two endpoint outputs numerically before writing the interval."
      ],
      "generator": {
        "parameters": {
          "mag": {
            "type": "int",
            "min": 1,
            "max": 5
          },
          "b": {
            "type": "int",
            "min": -8,
            "max": 8
          },
          "lo": {
            "type": "int",
            "min": -4,
            "max": 1
          },
          "span": {
            "type": "int",
            "min": 2,
            "max": 6
          }
        },
        "derived": {
          "hi": "lo+span",
          "yleft": "-mag*lo+b",
          "yright": "-mag*hi+b",
          "rlo": "min(yleft,yright)",
          "rhi": "max(yleft,yright)"
        }
      }
    }
  ]
