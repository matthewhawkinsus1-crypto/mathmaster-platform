    {
      "id": "mm_A_9A_v2_context-restricted-domain",
      "active": true,
      "alignmentKeys": [
        "texas:A.9A"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.9A:v2-context-restricted-domain",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.9A",
      "difficultyBand": 3,
      "dok": 2,
      "taskType": "application",
      "representation": "context",
      "prompt": "A quantity is modeled by $Q(t)={{a}}({{base}})^t$ only during the first {{years}} years after measurement begins. Write the CONTEXTUAL domain of $t$ as a compound inequality.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Contextual domain inequality",
          "inputProfile": "inequality",
          "expected": "0<=t and t<={{years}}"
        }
      ],
      "solutionReview": {
        "headline": "The algebraic domain and the contextual domain are different questions.",
        "reasoning": [
          "The exponential rule itself accepts every real input, but elapsed time in this situation begins at $t=0$.",
          "The model is stated to apply only through year {{years}}, so $0\\le t\\le {{years}}$."
        ],
        "answerSummary": "$0\\le t\\le {{years}}$"
      },
      "attemptFeedback": [
        "Use the time restriction in the situation rather than the unrestricted algebraic domain."
      ],
      "supportHints": [
        "Elapsed time cannot be negative in this model, and the stated observation window has an endpoint."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "int",
            "min": 50,
            "max": 500
          },
          "base": {
            "type": "choice",
            "values": [
              0.8,
              0.9,
              1.1,
              1.2
            ]
          },
          "years": {
            "type": "int",
            "min": 3,
            "max": 12
          }
        }
      },
      "variants": [
        {
          "coverageKey": "core-d2b3",
          "dok": 2,
          "difficultyBand": 3
        },
        {
          "coverageKey": "adaptive-d3b3-algebraic-vs-contextual-domain-judgment",
          "dok": 3,
          "difficultyBand": 3,
          "taskType": "interpretation",
          "representation": "context",
          "prompt": "A quantity is modeled algebraically by $Q(t)={{a}}({{base}})^t$, but the study only covers the first {{years}} years after t=0. Compare the ALGEBRAIC domain with the CONTEXTUAL domain and decide which domain should be reported when interpreting this study.",
          "responseFields": [
            {
              "id": "algebraic",
              "label": "Algebraic domain",
              "inputProfile": "choice",
              "choices": [
                {
                  "id": "all-real",
                  "label": "All real numbers"
                },
                {
                  "id": "nonnegative",
                  "label": "t ≥ 0"
                }
              ],
              "expected": "all-real"
            },
            {
              "id": "contextual",
              "label": "Contextual domain inequality",
              "inputProfile": "inequality",
              "expected": "0<=t and t<={{years}}"
            },
            {
              "id": "judgment",
              "label": "Which domain answers the study question?",
              "inputProfile": "choice",
              "choices": [
                {
                  "id": "context",
                  "label": "Use 0 ≤ t ≤ years because the situation restricts the model to the observed time window."
                },
                {
                  "id": "algebraic",
                  "label": "Use all real numbers because the formula alone accepts every real exponent."
                }
              ],
              "expected": "context"
            }
          ],
          "solutionReview": {
            "headline": "A formula's algebraic domain and a model's meaningful contextual domain can differ.",
            "reasoning": [
              "The exponential expression is defined for every real t.",
              "Elapsed study time begins at 0 and the model is stated to apply only through year {{years}}.",
              "Therefore the algebraic domain is all real numbers, while $0\\le t\\le {{years}}$ answers the contextual question."
            ],
            "answerSummary": "Algebraic: all real t; contextual: 0≤t≤{{years}}."
          },
          "attemptFeedback": [
            "State both domains before deciding which one belongs to the real-world interpretation."
          ],
          "supportHints": [
            "The formula and the situation impose different kinds of restrictions."
          ],
          "generator": {
            "parameters": {
              "a": {
                "type": "int",
                "min": 50,
