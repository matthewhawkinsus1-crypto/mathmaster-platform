      "taskType": "representationTranslation",
      "representation": "graph",
      "type": "functionInvestigation",
      "prompt": "Graph the exponential decay function $y={{a}}({{base}})^x{{k|signed}}$. Plot the requested points, identify the asymptote, and state the domain and range.",
      "functionSpec": {
        "type": "exponential",
        "a": "{{a}}",
        "b": "{{base}}",
        "k": "{{k}}"
      },
      "graph": {
        "xMin": -4,
        "xMax": 6,
        "yMin": -8,
        "yMax": 35,
        "snapStep": 0.25
      },
      "pointTasks": [
        {
          "id": "p0",
          "label": "Plot the y-intercept",
          "x": 0,
          "expected": [
            0,
            "{{y0}}"
          ]
        },
        {
          "id": "p1",
          "label": "Plot x = 1",
          "x": 1,
          "expected": [
            1,
            "{{y1}}"
          ]
        }
      ],
      "analysisRequests": [
        {
          "id": "asym",
          "label": "Horizontal asymptote y-value",
          "kind": "value",
          "responseMode": "text",
          "expected": [
            "{{k}}"
          ]
        },
        {
          "id": "domain",
          "label": "Domain",
          "kind": "domain",
          "notation": "interval",
          "expected": [
            "(-∞,∞)"
          ]
        },
        {
          "id": "range",
          "label": "Range",
          "kind": "range",
          "notation": "interval",
          "expected": [
            "({{k}},∞)"
          ]
        }
      ],
      "solutionReview": {
        "headline": "A base between 0 and 1 changes direction of change, not domain or the side of the asymptote.",
        "reasoning": [
          "Since $0<{{base}}<1$, the graph decreases as $x$ increases, but the exponential expression is still defined for every real input.",
          "The positive multiplier keeps the graph above $y={{k}}$, so the range remains $({{k}},\\infty)$."
        ],
        "answerSummary": "Domain $(-\\infty,\\infty)$; range $({{k}},\\infty)$."
      },
      "attemptFeedback": [
        "Decay means the outputs move toward the asymptote as x increases; it does not mean the domain stops."
      ],
      "supportHints": [
        "The base is positive, so $({{base}})^x$ is positive for every real $x$."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "choice",
            "values": [
              4,
              6,
              8,
              10
            ]
          },
          "base": {
            "type": "choice",
            "values": [
              0.5,
              0.75
            ]
          },
          "k": {
            "type": "int",
            "min": -4,
            "max": 4
          }
        },
        "derived": {
          "y0": "a+k",
          "y1": "a*base+k"
        }
      }
    },
    {
      "id": "mm_A_9A_v2_context-restricted-domain",
      "active": true,
      "alignmentKeys": [
        "texas:A.9A"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.9A:v2-context-restricted-domain",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.9A",
      "difficultyBand": 3,
      "dok": 2,
      "taskType": "application",
      "representation": "context",
      "prompt": "A quantity is modeled by $Q(t)={{a}}({{base}})^t$ only during the first {{years}} years after measurement begins. Write the CONTEXTUAL domain of $t$ in interval notation.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Contextual domain",
          "inputProfile": "interval",
          "expected": "[0,{{years}}]"
        }
      ],
      "solutionReview": {
        "headline": "The algebraic domain and the contextual domain are different questions.",
        "reasoning": [
          "The exponential rule itself accepts every real input, but elapsed time in this situation begins at $t=0$.",
          "The model is stated to apply only through year {{years}}, so the contextual domain is $[0,{{years}}]$."
        ],
        "answerSummary": "$[0,{{years}}]$"
      },
      "attemptFeedback": [
        "Use the time interval in the situation rather than the unrestricted algebraic domain."
      ],
      "supportHints": [
        "Elapsed time cannot be negative in this model, and the stated observation window has an endpoint."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "int",
            "min": 50,
            "max": 500
          },
          "base": {
            "type": "choice",
            "values": [
              0.8,
              0.9,
              1.1,
              1.2
            ]
          },
          "years": {
            "type": "int",
            "min": 3,
            "max": 12
          }
        }
      }
    },
