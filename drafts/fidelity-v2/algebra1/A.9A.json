      ],
      "solutionReview": {
        "headline": "Decay describes behavior, not an algebraic input restriction.",
        "reasoning": [
          "The point at $x=-1$ is valid, demonstrating directly that negative inputs belong to the algebraic domain.",
          "The function has domain $(-\\infty,\\infty)$ and, with positive multiplier, range $({{k}},\\infty)$."
        ],
        "answerSummary": "Domain $(-\\infty,\\infty)$; range $({{k}},\\infty)$."
      },
      "attemptFeedback": [
        "Test the student's claimed boundary by substituting a negative x-value."
      ],
      "supportHints": [
        "A positive base can be raised to negative real exponents."
