      "type": "functionInvestigation",
      "prompt": "A student claims, “Because $y={{a}}({{base}})^x{{k|signed}}$ is decay, its domain is $x\\ge0$.” Use the graph to correct the claim and report the true domain and range.",
      "functionSpec": {
        "type": "exponential",
        "a": "{{a}}",
        "b": "{{base}}",
        "k": "{{k}}"
      },
      "graph": {
