  "documents": [
    {
      "id": "mm_A_9A_v2_growth-graph-domain-range",
      "active": true,
      "alignmentKeys": [
        "texas:A.9A"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.9A:v2-growth-graph-domain-range",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.9A",
      "difficultyBand": 2,
      "dok": 2,
      "taskType": "interpretation",
      "representation": "graph",
      "type": "functionInvestigation",
      "prompt": "Graph $y={{a}}({{base}})^x{{k|signed}}$ by plotting the requested points. Then use the graph and horizontal asymptote to state the domain and range.",
      "functionSpec": {
        "type": "exponential",
        "a": "{{a}}",
        "k": "{{k}}",
        "base": "{{base}}"
      },
      "graph": {
        "xMin": -4,
        "xMax": 5,
        "yMin": -8,
        "yMax": 30,
        "snapStep": 0.25
      },
      "pointTasks": [
        {
          "id": "p0",
          "label": "Plot the y-intercept",
          "x": 0,
          "expected": [
            0,
            "{{y0}}"
          ]
        },
        {
          "id": "p1",
          "label": "Plot x = 1",
          "x": 1,
          "expected": [
            1,
            "{{y1}}"
          ]
        }
      ],
      "analysisRequests": [
        {
          "id": "asym",
          "label": "Horizontal asymptote y-value",
          "kind": "value",
          "responseMode": "text",
          "expected": [
            "{{k}}"
          ]
        },
        {
          "id": "domain",
          "label": "Domain",
          "kind": "domain",
          "notation": "interval",
          "expected": [
            "(-∞,∞)"
          ]
        },
        {
          "id": "range",
          "label": "Range",
          "kind": "range",
          "notation": "interval",
          "expected": [
            "({{k}},∞)"
          ]
        }
      ],
      "solutionReview": {
        "headline": "Growth still has all real inputs; the asymptote controls the range.",
        "reasoning": [
          "An exponential with positive multiplier is defined for every real $x$, so its domain is $(-\\infty,\\infty)$.",
          "Because the graph stays above and approaches $y={{k}}$ without reaching it, the range is $({{k}},\\infty)$."
        ],
        "answerSummary": "Domain $(-\\infty,\\infty)$; range $({{k}},\\infty)$."
      },
      "attemptFeedback": [
        "Use the horizontal asymptote to decide the open endpoint of the range; the base does not restrict the domain."
      ],
      "supportHints": [
        "For a positive exponential shifted by $k$, every output lies above $y=k$."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "int",
            "min": 1,
            "max": 4
          },
          "base": {
            "type": "choice",
            "values": [
              2,
              3
            ]
          },
          "k": {
            "type": "int",
            "min": -4,
            "max": 4
          }
        },
        "derived": {
          "y0": "a+k",
          "y1": "a*base+k"
        }
      }
    },
    {
      "id": "mm_A_9A_v2_decay-graph-domain-range",
