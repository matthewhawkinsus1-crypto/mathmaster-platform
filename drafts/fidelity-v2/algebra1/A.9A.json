        "yMin": -8,
        "yMax": 40,
        "snapStep": 0.25
      },
      "pointTasks": [
        {
          "id": "pneg",
          "label": "Plot x = -1 to test a negative input",
          "x": -1,
          "expected": [
            -1,
            "{{yNeg}}"
          ]
        },
        {
          "id": "p0",
          "label": "Plot x = 0",
          "x": 0,
          "expected": [
            0,
            "{{y0}}"
          ]
        }
