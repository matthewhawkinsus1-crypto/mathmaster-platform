        {
          "id": "answer",
          "label": "Perimeter polynomial",
          "inputProfile": "expression",
          "expected": "{{P}}x{{Q|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "Perimeter adds two copies of each dimension.",
        "reasoning": [
          "Use $P=2L+2W$ and distribute the 2 to both expressions.",
          "The linear coefficient is $2({{a}}+{{c}})={{P}}$ and the constant is $2({{b}}+{{d}})={{Q}}$."
        ],
        "answerSummary": "${{P}}x{{Q|signed}}$"
      },
      "attemptFeedback": [
        "Write two lengths plus two widths before combining like terms."
      ],
      "supportHints": [
        "Perimeter is addition, not multiplication of length and width."
      ],
