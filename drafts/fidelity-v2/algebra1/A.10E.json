          "expected": "(x{{p|signed}})(x{{q|signed}})",
          "accepted": [
            "(x{{q|signed}})(x{{p|signed}})"
          ]
        }
      ],
      "solutionReview": {
        "headline": "Find two numbers whose sum is the middle coefficient and whose product is the constant.",
        "reasoning": [
          "The needed numbers are {{p}} and {{q}} because they add to {{sum}} and multiply to {{prod}}.",
          "Those numbers become the constants in the two binomial factors."
        ],
        "answerSummary": "$(x{{p|signed}})(x{{q|signed}})$"
      },
      "attemptFeedback": [
