      "id": "mm_A_12A_v2_mapping-nonfunction",
      "active": true,
      "alignmentKeys": [
        "texas:A.12A"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.12A:v2-mapping-nonfunction",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 2,
      "dok": 1,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.12A",
      "taskType": "conceptual",
      "representation": "orderedPairs",
      "type": "relationMapping",
      "prompt": "Use the mapping to decide whether the relation is a function.",
      "pairs": [
        {
          "x": "{{x}}",
          "y": "{{y1}}"
        },
        {
          "x": "{{x}}",
          "y": "{{y2}}"
        },
        {
          "x": "{{x2}}",
          "y": "{{y3}}"
        }
      ],
      "ask": [
        "isFunction"
      ],
      "solutionReview": {
        "headline": "A function cannot send one input to two different outputs.",
        "reasoning": [
          "The input {{x}} is paired with both {{y1}} and {{y2}}.",
          "Because those outputs are different, the relation is not a function."
        ],
        "answerSummary": "The relation is not a function."
      },
      "attemptFeedback": [
        "Trace each input and count how many different outputs it reaches."
      ],
      "supportHints": [
        "Repeated outputs are allowed; one repeated INPUT with different outputs is the problem."
      ],
      "generator": {
        "parameters": {
          "x": {
            "type": "int",
            "min": -5,
            "max": 5
          },
          "x2": {
            "type": "int",
            "min": -5,
            "max": 5
          },
          "y1": {
            "type": "int",
            "min": -8,
            "max": 8
          },
          "y2": {
            "type": "int",
            "min": -8,
            "max": 8
          },
          "y3": {
            "type": "int",
            "min": -8,
            "max": 8
          }
        },
        "constraints": [
          "x2 != x",
          "y2 != y1"
        ]
      }
    },
