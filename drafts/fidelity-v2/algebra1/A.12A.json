      "difficultyBand": 3,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.12A",
      "taskType": "application",
      "representation": "context",
      "prompt": "A school relation uses student ID as the input and assigned locker number as the output. ID {{id}} is recorded with locker {{locker1}} and also locker {{locker2}}. Under this rule, how should the recorded relation be classified?",
      "responseFields": [
        {
          "id": "answer",
          "label": "Classification",
          "inputProfile": "choice",
          "expected": "not-function"
        }
      ],
      "solutionReview": {
        "headline": "The meaning of input and output matters in context too.",
        "reasoning": [
          "The same student ID {{id}} is one input.",
          "It is paired with two different locker outputs, so this recorded relation fails the definition of a function."
        ],
        "answerSummary": "NOT A FUNCTION"
      },
      "attemptFeedback": [
        "Identify exactly what quantity is serving as the input."
      ],
      "supportHints": [
        "Ask whether one student ID receives more than one output in the relation."
      ],
      "generator": {
        "parameters": {
          "id": {
            "type": "int",
            "min": 100,
            "max": 999
          },
          "locker1": {
            "type": "int",
            "min": 10,
            "max": 80
          },
          "locker2": {
            "type": "int",
            "min": 10,
            "max": 80
          }
        },
        "constraints": [
          "locker1 != locker2"
        ]
      },
      "choices": [
        {
          "id": "function",
          "label": "FUNCTION"
        },
        {
          "id": "not-function",
          "label": "NOT A FUNCTION"
        }
      ]
    },
