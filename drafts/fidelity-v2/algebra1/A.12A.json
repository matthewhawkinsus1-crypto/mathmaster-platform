      "representation": "graph",
      "prompt": "Use the displayed graph and the vertical-line test to classify the relation. Enter FUNCTION or NOT A FUNCTION.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Classification",
          "inputProfile": "text",
          "expected": "function"
        }
      ],
      "solutionReview": {
        "headline": "A repeated output does not make a relation fail the vertical-line test.",
        "reasoning": [
          "The plotted inputs {{x1}}, {{x2}}, and {{x3}} are all different, even though two points share output {{y}}.",
          "No vertical line hits more than one plotted point, so each input has exactly one output."
        ],
        "answerSummary": "FUNCTION"
      },
      "attemptFeedback": [
        "Move an imaginary vertical line from left to right and check whether it ever hits two points at the same $x$-value."
      ],
      "supportHints": [
        "Functions may repeat outputs; the problem is one input paired with two different outputs."
      ],
