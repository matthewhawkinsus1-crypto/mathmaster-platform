      "solutionReview": {
        "headline": "The same first coordinate cannot have two different second coordinates in a function.",
        "reasoning": [
          "The input {{x1}} appears in two ordered pairs.",
          "Its outputs {{y1}} and {{y3}} are different, so the relation is not a function."
        ],
        "answerSummary": "NOT A FUNCTION"
      },
      "attemptFeedback": [
        "Compare first coordinates before comparing outputs."
      ],
      "supportHints": [
        "Find any input that occurs more than once with different outputs."
