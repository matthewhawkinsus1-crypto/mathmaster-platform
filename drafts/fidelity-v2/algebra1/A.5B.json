      "assessedConstruct": "A.5B",
      "taskType": "application",
      "representation": "context",
      "prompt": "A service charges a fixed fee of {{fee}} dollars plus {{rate}} dollars per hour. A customer can spend at most {{budget}} dollars. Let $h$ be the number of hours. Write and solve the inequality that describes the possible hours.",
      "responseFields": [
        {
          "id": "model",
          "label": "Budget inequality",
          "inputProfile": "inequality",
          "expected": "{{fee}}+{{rate}}h<={{budget}}"
        },
        {
          "id": "solution",
          "label": "Solved inequality",
          "inputProfile": "inequality",
          "expected": "h<={{maxh}}"
        }
      ],
      "solutionReview": {
        "headline": "Model the maximum before solving it.",
        "reasoning": [
          "The total cost is ${{fee}}+{{rate}}h$ and 'at most' means $\\le {{budget}}$.",
          "Subtract the fee and divide by {{rate}} to get $h\\le {{maxh}}$."
        ],
        "answerSummary": "${{fee}}+{{rate}}h\\le{{budget}}$, so $h\\le{{maxh}}$."
      },
      "attemptFeedback": [
        "Translate 'at most' into an inequality before solving."
      ],
      "supportHints": [
        "Keep the fixed fee separate from the hourly charge."
      ],
      "generator": {
        "parameters": {
          "fee": {
            "type": "int",
            "min": 5,
            "max": 30
          },
          "rate": {
            "type": "int",
            "min": 2,
            "max": 12
          },
          "maxh": {
            "type": "int",
            "min": 2,
            "max": 10
          }
        },
        "derived": {
          "budget": "fee+rate*maxh"
        }
      }
    },
