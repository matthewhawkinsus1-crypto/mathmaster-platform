    {
      "id": "mm_A_5B_v2_distribute-inequality",
      "active": true,
      "alignmentKeys": [
        "texas:A.5B"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.5B:v2-distribute-inequality",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 2,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.5B",
      "taskType": "procedural",
      "representation": "symbolic",
      "prompt": "Solve ${{g}}(x{{s|signed}}) \\le {{rhs}}$. Write the solution as an inequality.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Solution inequality",
          "inputProfile": "inequality",
          "expected": "x<={{bound}}"
        }
      ],
      "solutionReview": {
        "headline": "Distribute or divide first, then isolate x.",
        "reasoning": [
          "Dividing both sides by the positive number {{g}} gives $x{{s|signed}}\\le {{t}}$.",
          "Undo the shift {{s}} to obtain $x\\le {{bound}}$."
        ],
        "answerSummary": "$x\\le {{bound}}$"
      },
      "attemptFeedback": [
        "The outside factor applies to the entire quantity in parentheses."
      ],
      "supportHints": [
        "Because {{g}} is positive, the inequality direction does not change when you divide."
      ],
      "generator": {
        "parameters": {
          "g": {
            "type": "int",
            "min": 2,
            "max": 6
          },
          "s": {
            "type": "int",
            "min": -6,
            "max": 6,
            "exclude": [
              0
            ]
          },
          "t": {
            "type": "int",
            "min": -8,
            "max": 10
          }
        },
        "derived": {
          "rhs": "g*t",
          "bound": "t-s"
        }
      }
    },
    {
      "id": "mm_A_5B_v2_variables-both-sides",
      "active": true,
      "alignmentKeys": [
        "texas:A.5B"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.5B:v2-variables-both-sides",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 3,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.5B",
      "taskType": "procedural",
      "representation": "symbolic",
      "prompt": "Solve ${{a}}x{{b|signed}} \\le {{c}}x{{d|signed}}$. Write the solution as an inequality.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Solution inequality",
          "inputProfile": "inequality",
          "expected": "x<={{bound}}"
        }
      ],
      "solutionReview": {
        "headline": "Move variable terms to one side before isolating x.",
        "reasoning": [
          "Subtract {{c}}x from both sides to get ${{delta}}x{{b|signed}}\\le {{d}}$.",
          "Then subtract {{b}} and divide by positive {{delta}}, giving $x\\le {{bound}}$."
        ],
        "answerSummary": "$x\\le {{bound}}$"
      },
      "attemptFeedback": [
        "Collect the x-terms together before handling the constants."
      ],
      "supportHints": [
        "The constructed coefficient difference {{delta}} is positive, so the final division does not reverse the inequality."
      ],
      "generator": {
        "parameters": {
          "c": {
            "type": "int",
            "min": -4,
            "max": 5
          },
          "delta": {
            "type": "int",
            "min": 1,
            "max": 5
          },
          "b": {
            "type": "int",
            "min": -9,
            "max": 9
          },
          "bound": {
            "type": "int",
            "min": -8,
            "max": 8
          }
        },
        "derived": {
          "a": "c+delta",
          "d": "b+delta*bound"
        }
      }
    },
    {
      "id": "mm_A_5B_v2_negative-coefficient-number-line",
      "active": true,
      "alignmentKeys": [
        "texas:A.5B"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.5B:v2-negative-coefficient-number-line",
      "familyVersion": 3,
      "questionType": "tool",
      "activityRole": "practice",
      "difficultyBand": 3,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.5B",
      "taskType": "representationTranslation",
      "representation": "graph",
      "prompt": "Solve $-{{g}}x{{b|signed}} \\ge {{rhs}}$, then graph the solution on the number line and enter the matching interval notation.",
      "type": "intervalNumberLine",
      "min": -12,
      "max": 12,
      "step": 1,
      "variable": "x",
      "ask": [
        "graph",
        "interval"
      ],
      "expectedIntervals": [
        {
          "min": null,
          "max": "{{bound}}",
          "minClosed": false,
          "maxClosed": true
        }
      ],
      "expectedNotation": "(-inf,{{bound}}]",
      "solutionReview": {
        "headline": "Dividing by a negative reverses the inequality.",
        "reasoning": [
          "Subtract {{b}} to get $-{{g}}x\\ge {{right}}$.",
          "Dividing by $-{{g}}$ reverses the comparison, so $x\\le {{bound}}$. The graph is a closed point at {{bound}} shaded left."
        ],
        "answerSummary": "$x\\le {{bound}}$, or $(-\\infty,{{bound}}]$."
      },
      "attemptFeedback": [
        "Watch the inequality direction when the final coefficient of x is negative."
      ],
      "supportHints": [
        "A closed endpoint is used because equality is included."
      ],
      "generator": {
        "parameters": {
          "g": {
            "type": "int",
            "min": 2,
            "max": 6
          },
          "b": {
            "type": "int",
            "min": -8,
            "max": 8
          },
          "bound": {
            "type": "int",
            "min": -8,
            "max": 8
          }
        },
        "derived": {
          "right": "-g*bound",
          "rhs": "b+right"
        }
      }
    },
    {
      "id": "mm_A_5B_v2_context-capacity",
      "active": true,
