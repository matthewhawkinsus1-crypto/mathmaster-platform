      ],
      "solutionReview": {
        "headline": "A negative division reverses the order relation.",
        "reasoning": [
          "Dividing $-{{g}}x\\le{{rhs}}$ by $-{{g}}$ changes $\\le$ to $\\ge$.",
          "The boundary value is {{correct}}, so the correct solution is $x\\ge {{correct}}$."
        ],
        "answerSummary": "$x\\ge {{correct}}$"
      },
      "attemptFeedback": [
        "The boundary number may be right even when the inequality direction is wrong."
      ],
      "supportHints": [
