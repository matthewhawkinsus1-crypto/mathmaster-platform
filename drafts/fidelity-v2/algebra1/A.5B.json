      "taskType": "procedural",
      "representation": "symbolic",
      "prompt": "Solve ${{a}}x{{b|signed}} \\le {{c}}x{{d|signed}}$. Write the solution as an inequality.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Solution inequality",
          "inputProfile": "inequality",
          "expected": "x<={{bound}}"
        }
      ],
      "solutionReview": {
        "headline": "Move variable terms to one side before isolating x.",
        "reasoning": [
          "Subtract {{c}}x from both sides to get ${{delta}}x{{b|signed}}\\le {{d}}$.",
          "Then subtract {{b}} and divide by positive {{delta}}, giving $x\\le {{bound}}$."
        ],
        "answerSummary": "$x\\le {{bound}}$"
      },
      "attemptFeedback": [
        "Collect the x-terms together before handling the constants."
      ],
      "supportHints": [
        "The constructed coefficient difference {{delta}} is positive, so the final division does not reverse the inequality."
      ],
      "generator": {
        "parameters": {
          "c": {
            "type": "int",
            "min": -4,
            "max": 5
          },
          "delta": {
            "type": "int",
            "min": 1,
            "max": 5
          },
          "b": {
            "type": "int",
            "min": -9,
            "max": 9
          },
          "bound": {
            "type": "int",
            "min": -8,
            "max": 8
          }
        },
        "derived": {
          "a": "c+delta",
          "d": "b+delta*bound"
        }
      },
      "variants": [
        {
          "coverageKey": "core-d2b3",
          "dok": 2,
          "difficultyBand": 3
