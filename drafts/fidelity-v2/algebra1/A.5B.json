          "id": "solution",
          "label": "Solved inequality",
          "inputProfile": "inequality",
          "expected": "h<={{maxh}}"
        }
      ],
      "solutionReview": {
        "headline": "Model the maximum before solving it.",
        "reasoning": [
          "The total cost is ${{fee}}+{{rate}}h$ and 'at most' means $\\le {{budget}}$.",
          "Subtract the fee and divide by {{rate}} to get $h\\le {{maxh}}$."
        ],
        "answerSummary": "${{fee}}+{{rate}}h\\le{{budget}}$, so $h\\le{{maxh}}$."
      },
      "attemptFeedback": [
        "Translate 'at most' into an inequality before solving."
      ],
      "supportHints": [
        "Keep the fixed fee separate from the hourly charge."
