            {
              "id": "answer",
              "label": "Final solution inequality",
              "inputProfile": "inequality",
              "expected": "x>={{bound}}"
            }
          ],
          "solutionReview": {
            "headline": "A multi-step inequality can require reversal only at the final negative division.",
            "reasoning": [
              "Subtracting {{c}}x gives $-{{g}}x{{b|signed}}\\le{{d}}$.",
              "Subtracting {{b}} gives $-{{g}}x\\le{{rhs2}}$.",
              "Dividing by -{{g}} reverses the inequality, producing x≥{{bound}}."
            ],
            "answerSummary": "$x\\ge{{bound}}$"
          },
          "attemptFeedback": [
            "Do not reverse the symbol when adding or subtracting; reverse it only when dividing by the negative coefficient."
          ],
          "supportHints": [
            "Track the sign of the coefficient on x after combining the variable terms."
          ],
          "generator": {
            "parameters": {
              "c": {
                "type": "int",
                "min": -3,
                "max": 5
              },
              "g": {
                "type": "int",
                "min": 2,
                "max": 6
              },
              "b": {
                "type": "int",
                "min": -8,
                "max": 8
              },
              "bound": {
                "type": "int",
                "min": -6,
                "max": 6
              }
            },
            "derived": {
              "a": "c-g",
              "rhs2": "-g*bound",
              "d": "b+rhs2"
            }
          }
        }
      ]
