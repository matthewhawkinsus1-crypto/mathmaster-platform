    {
      "id": "mm_A_5B_v2_distribute-inequality",
      "active": true,
      "alignmentKeys": [
        "texas:A.5B"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.5B:v2-distribute-inequality",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 2,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.5B",
      "taskType": "procedural",
      "representation": "symbolic",
      "prompt": "Solve ${{g}}(x{{s|signed}}) \\le {{rhs}}$. Write the solution as an inequality.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Solution inequality",
          "inputProfile": "inequality",
          "expected": "x<={{bound}}"
        }
      ],
      "solutionReview": {
        "headline": "Distribute or divide first, then isolate x.",
        "reasoning": [
          "Dividing both sides by the positive number {{g}} gives $x{{s|signed}}\\le {{t}}$.",
          "Undo the shift {{s}} to obtain $x\\le {{bound}}$."
        ],
        "answerSummary": "$x\\le {{bound}}$"
      },
      "attemptFeedback": [
        "The outside factor applies to the entire quantity in parentheses."
      ],
      "supportHints": [
        "Because {{g}} is positive, the inequality direction does not change when you divide."
      ],
      "generator": {
        "parameters": {
          "g": {
            "type": "int",
            "min": 2,
            "max": 6
          },
          "s": {
            "type": "int",
            "min": -6,
            "max": 6,
            "exclude": [
              0
            ]
          },
          "t": {
            "type": "int",
            "min": -8,
            "max": 10
          }
        },
        "derived": {
          "rhs": "g*t",
          "bound": "t-s"
        }
      }
    },
