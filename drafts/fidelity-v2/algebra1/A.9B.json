      "taskType": "procedural",
      "representation": "symbolic",
      "prompt": "A population model is $P={{a}}(1+{{p}}/100)^t$. What is the percent growth rate?",
      "solutionReview": {
        "headline": "Connect the representation to the mathematics.",
        "reasoning": [
          "In a growth model, the base is $1+r$ where $r$ is the decimal growth rate.",
          "The expression explicitly uses {{p}}/100, which corresponds to {{p}} percent."
        ],
        "answerSummary": "The growth rate is ${{p}}$%."
      },
      "attemptFeedback": [
        "Separate the initial value from the multiplicative factor, then convert between growth/decay factor and percent change."
      ],
      "supportHints": [
        "In a(b)^x, a is the initial value and b is the multiplicative factor; growth percent is b-1 and decay percent is 1-b."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "int",
            "min": 100,
            "max": 900
          },
          "p": {
            "type": "int",
            "min": 2,
            "max": 25
          }
        }
      },
      "responseFields": [
        {
          "id": "answer",
          "label": "Answer",
          "inputProfile": "number",
          "expected": "{{p}}"
        }
      ]
    },
