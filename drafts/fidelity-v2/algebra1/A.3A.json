          "id": "answer",
          "label": "Correct slope",
          "inputProfile": "number",
          "expected": "{{m}}"
        }
      ],
      "solutionReview": {
        "headline": "Slope is rise over run, not run over rise.",
        "reasoning": [
          "The run is {{run}} and the rise is {{rise}}.",
          "The correct ratio is ${{rise}}/{{run}}={{m}}$."
        ]
      },
      "attemptFeedback": [
        "Write change in y on top and change in x on the bottom."
      ],
      "supportHints": [
        "Slope = $\\frac{y_2-y_1}{x_2-x_1}$."
      ],
