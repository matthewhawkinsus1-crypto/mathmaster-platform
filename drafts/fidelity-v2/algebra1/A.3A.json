      ],
      "solutionReview": {
        "headline": "Point-slope form names the slope directly.",
        "reasoning": [
          "In $y-y_1=m(x-x_1)$, the multiplier of the parenthesis is m.",
          "Here that multiplier is {{m}}, so the slope is {{m}}."
        ]
      },
      "attemptFeedback": [
        "Match the equation to $y-y_1=m(x-x_1)$."
