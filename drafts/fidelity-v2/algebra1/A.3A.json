      "id": "mm_A_3A_v2_graph-slope",
      "active": true,
      "alignmentKeys": [
        "texas:A.3A"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.3A:v2-graph-slope",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 2,
      "dok": 1,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.3A",
      "taskType": "representationTranslation",
      "representation": "graph",
      "type": "functionInvestigation",
      "prompt": "Plot two points on $y={{m}}x{{b|signed}}$, then determine the slope from the graph.",
      "functionSpec": {
        "type": "linear",
        "m": "{{m}}",
        "b": "{{b}}"
      },
      "pointTasks": [
        {
          "id": "p0",
          "label": "Plot the y-intercept",
          "x": 0,
          "expected": [
            0,
            "{{b}}"
          ]
        },
        {
          "id": "p2",
          "label": "Plot the point where x = 2",
          "x": 2,
          "expected": [
            2,
            "{{y2}}"
          ]
        }
      ],
      "analysisRequests": [
        {
          "id": "slope",
          "label": "Slope",
          "kind": "value",
          "responseMode": "text",
          "expected": [
            "{{m}}"
          ]
        }
      ],
      "solutionReview": {
        "headline": "Slope is the constant rise/run between any two points on a line.",
        "reasoning": [
          "The plotted points are $(0,{{b}})$ and $(2,{{y2}})$.",
          "Their rise divided by run simplifies to {{m}}."
        ]
      },
      "attemptFeedback": [
        "Use the same two plotted points to measure vertical change over horizontal change."
      ],
      "supportHints": [
        "Slope = rise/run."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "int",
            "min": -5,
            "max": 5,
            "exclude": [
              0
            ]
          },
          "b": {
            "type": "int",
            "min": -6,
            "max": 6
          }
        },
        "derived": {
          "y2": "2*m+b"
        }
      }
    },
    {
      "id": "mm_A_3A_v2_table-slope",
      "active": true,
      "alignmentKeys": [
        "texas:A.3A"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.3A:v2-table-slope",
