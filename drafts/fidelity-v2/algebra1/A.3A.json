      "assessedConstruct": "A.3A",
      "taskType": "representationTranslation",
      "representation": "table",
      "prompt": "Use the table to determine the slope of the linear function.",
      "stimulus": {
        "kind": "table",
        "table": {
          "headers": [
            "$x$",
            "$y$"
          ],
          "rows": [
            [
              "{{x0}}",
              "{{y0}}"
            ],
            [
              "{{x1}}",
              "{{y1}}"
            ],
            [
              "{{x2}}",
              "{{y2}}"
            ]
          ]
        }
      },
      "responseFields": [
        {
          "id": "answer",
          "label": "Slope",
          "inputProfile": "number",
          "expected": "{{m}}"
        }
      ],
      "solutionReview": {
        "headline": "A table gives slope as change in output divided by change in input.",
        "reasoning": [
          "From one row to the next, x changes by {{step}}.",
          "Over the same move, y changes by {{rise}}, so the slope is ${{rise}}/{{step}}={{m}}$."
        ]
      },
      "attemptFeedback": [
        "Compare the same pair of rows in both columns."
      ],
      "supportHints": [
        "Compute $\\Delta y/\\Delta x$."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "int",
            "min": -5,
            "max": 5,
            "exclude": [
              0
            ]
          },
          "b": {
            "type": "int",
            "min": -8,
            "max": 8
          },
          "x0": {
            "type": "int",
            "min": -4,
            "max": 0
          },
          "step": {
            "type": "int",
            "min": 1,
            "max": 4
          }
        },
        "derived": {
          "x1": "x0+step",
          "x2": "x0+2*step",
          "y0": "m*x0+b",
          "y1": "m*x1+b",
          "y2": "m*x2+b",
          "rise": "m*step"
        }
      }
    },
    {
      "id": "mm_A_3A_v2_standard-form-slope",
      "active": true,
      "alignmentKeys": [
        "texas:A.3A"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.3A:v2-standard-form-slope",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 3,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.3A",
      "taskType": "representationTranslation",
      "representation": "symbolic",
      "prompt": "Determine the slope of the standard-form line ${{A}}x+{{B}}y={{C}}$ without graphing it.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Slope",
          "inputProfile": "number",
          "expected": "{{m}}"
        }
      ],
      "solutionReview": {
        "headline": "Standard form can be rearranged to reveal slope.",
        "reasoning": [
          "Solving ${{A}}x+{{B}}y={{C}}$ for y gives a coefficient of x equal to $-{{A}}/{{B}}$.",
          "Because ${{A}}=-({{m}})({{B}})$, that quotient simplifies to {{m}}."
        ]
      },
      "attemptFeedback": [
        "Isolate y and read the coefficient multiplying x."
      ],
      "supportHints": [
        "For $Ax+By=C$, slope is $-A/B$."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "int",
            "min": -5,
            "max": 5,
            "exclude": [
              0
            ]
          },
          "B": {
            "type": "int",
            "min": 2,
            "max": 5
          },
          "c0": {
            "type": "int",
            "min": -6,
            "max": 6
          }
        },
        "derived": {
          "A": "-m*B",
          "C": "c0*B"
        }
      }
    },
