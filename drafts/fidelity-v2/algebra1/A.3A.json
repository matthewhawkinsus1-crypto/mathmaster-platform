      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 3,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.3A",
      "taskType": "representationTranslation",
      "representation": "symbolic",
      "prompt": "The line is written in standard form ${{A}}x+{{B}}y={{C}}$. Determine its slope without graphing it.",
      "responseFields": [
        {
          "id": "answer",
          "label": "Slope",
          "inputProfile": "number",
          "expected": "{{m}}"
        }
      ],
      "solutionReview": {
        "headline": "Standard form can be rearranged to reveal slope.",
        "reasoning": [
          "Solving ${{A}}x+{{B}}y={{C}}$ for y gives a coefficient of x equal to $-{{A}}/{{B}}$.",
          "Because ${{A}}=-({{m}})({{B}})$, that quotient simplifies to {{m}}."
        ]
      },
      "attemptFeedback": [
        "Isolate y and read the coefficient multiplying x."
      ],
      "supportHints": [
        "For $Ax+By=C$, slope is $-A/B$."
      ],
      "generator": {
        "parameters": {
          "m": {
            "type": "int",
            "min": -5,
            "max": 5,
            "exclude": [
              0
            ]
          },
          "B": {
            "type": "int",
            "min": 2,
            "max": 5
          },
          "c0": {
            "type": "int",
            "min": -6,
            "max": 6
          }
        },
        "derived": {
          "A": "-m*B",
          "C": "c0*B"
        }
      },
      "variants": [
        {
          "coverageKey": "adaptive-d2b4-fractional-standard-form-slope",
          "dok": 2,
          "difficultyBand": 4,
          "prompt": "The line is written in standard form ${{A}}x+{{B}}y={{C}}$. Determine its slope exactly. The coefficients are chosen so the slope is not an integer, so simplify the ratio $-A/B$ rather than estimating from a graph.",
          "responseFields": [
            {
              "id": "numerator",
              "label": "Numerator -A",
              "inputProfile": "number",
              "expected": "{{negA}}"
            },
            {
              "id": "denominator",
              "label": "Denominator B",
              "inputProfile": "number",
              "expected": "{{B}}"
            },
            {
              "id": "answer",
              "label": "Exact slope",
              "inputProfile": "number",
              "expected": "{{m}}"
            }
          ],
          "solutionReview": {
            "headline": "Standard form reveals slope through the ratio -A/B.",
            "reasoning": [
              "Solving {{A}}x+{{B}}y={{C}} for y gives slope -{{A}}/{{B}}.",
              "That ratio equals {{m}}."
            ],
            "answerSummary": "Slope {{m}}."
          },
          "attemptFeedback": [
            "Do not use C when finding slope; only A and B determine -A/B."
          ],
          "supportHints": [
            "From Ax+By=C, slope is -A/B."
          ],
          "generator": {
            "parameters": {
              "A": {
                "type": "int",
                "min": 2,
                "max": 7
              },
              "B": {
                "type": "int",
                "min": 2,
                "max": 7
              },
              "C": {
                "type": "int",
                "min": -12,
                "max": 12
              }
            },
            "derived": {
              "negA": "-A",
              "m": "-A/B"
            },
            "constraints": [
              "A!=B",
              "A%B!=0",
              "B%A!=0"
            ]
          }
        }
      ]
