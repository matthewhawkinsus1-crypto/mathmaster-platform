          "relation": ">="
        },
        {
          "m": "{{m2}}",
          "b": "{{b2}}",
          "relation": "<="
        }
      ],
      "graph": {
        "xMin": -6,
        "xMax": 6,
        "yMin": -10,
        "yMax": 12
      },
      "solutionReview": {
        "headline": "A system keeps only points satisfying both inequalities.",
        "reasoning": [
          "Construct each boundary independently with the correct solid/dashed style and half-plane.",
          "The system solution is the overlap of the two shaded half-planes."
        ]
      },
      "attemptFeedback": [
        "Do not stop after one inequality; the final region must satisfy both at once."
      ],
      "supportHints": [
        "Build one boundary and shade first, then repeat for the second inequality and keep only the overlap."
