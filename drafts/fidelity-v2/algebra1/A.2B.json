        {
          "id": "equation",
          "label": "Point-slope equation",
          "inputProfile": "equation",
          "expected": "y{{negy1|signed}}={{m}}(x{{negx1|signed}})"
        }
      ],
      "solutionReview": {
        "headline": "Point-slope form keeps the given point visible.",
        "reasoning": [
          "Use $y-y_1=m(x-x_1)$.",
          "Substitute slope {{m}} and the point $({{x1}},{{y1}})$ without changing the point's signs."
        ],
        "answerSummary": "$y{{negy1|signed}}={{m}}(x{{negx1|signed}})$"
      },
      "attemptFeedback": [
        "Match each coordinate to the subtraction structure in point-slope form."
      ],
      "supportHints": [
        "A negative coordinate creates addition because subtracting a negative changes the sign."
