    {
      "id": "mm_A_6A_v2_projectile-context-domain-range",
      "active": true,
      "alignmentKeys": [
        "texas:A.6A"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.6A:v2-projectile-context-domain-range",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 3,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.6A",
      "taskType": "application",
      "representation": "context",
      "prompt": "A projectile is modeled by $h(t)=-{{a}}(t-{{v}})^2+{{maxh}}$ only from launch until it returns to the ground. Write the reasonable domain of time and the corresponding range of height as inequalities.",
      "responseFields": [
        {
          "id": "domain",
          "label": "Reasonable time domain",
          "inputProfile": "inequality",
          "expected": "0<=t and t<={{end}}"
        },
        {
          "id": "range",
          "label": "Height range",
          "inputProfile": "inequality",
          "expected": "0<=h and h<={{maxh}}"
        }
      ],
      "solutionReview": {
        "headline": "Context can restrict a quadratic that is mathematically defined for every real input.",
        "reasoning": [
          "Because {{maxh}}={{a}}({{v}})^2, the model reaches ground level at t=0 and t={{end}}.",
          "During the physical flight, time runs from 0 to {{end}} and height runs from 0 to the vertex height {{maxh}}."
        ]
      },
      "attemptFeedback": [
        "Use the physical time restriction in the situation, not the unrestricted algebraic domain of the formula."
      ],
      "supportHints": [
        "The vertex occurs halfway between the two ground times."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "int",
            "min": 1,
            "max": 3
          },
          "v": {
            "type": "int",
            "min": 2,
            "max": 6
          }
        },
        "derived": {
          "maxh": "a*v*v",
          "end": "2*v"
        }
      }
    },
    {
      "id": "mm_A_6A_v2_restricted-domain-range",
      "active": true,
      "alignmentKeys": [
        "texas:A.6A"
      ],
      "courseId": "algebra1",
      "familyId": "mathmaster:A.6A:v2-restricted-domain-range",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "difficultyBand": 3,
      "dok": 2,
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A.6A",
      "taskType": "application",
      "representation": "symbolic",
      "prompt": "For $q(x)={{a}}(x-{{h}})^2{{k|signed}}$ restricted to ${{h}}\\le x\\le {{hi}}$, write BOTH the domain and range as compound inequalities.",
      "responseFields": [
        {
          "id": "domain",
          "label": "Domain inequality",
          "inputProfile": "inequality",
          "expected": "{{h}}<=x and x<={{hi}}"
        },
        {
          "id": "range",
          "label": "Range inequality",
          "inputProfile": "inequality",
          "expected": "{{k}}<=y and y<={{top}}"
        }
      ],
      "solutionReview": {
        "headline": "A restricted domain changes the range because only part of the parabola is allowed.",
        "reasoning": [
          "The domain starts at the vertex x={{h}} and ends at {{hi}}, so ${{h}}\\le x\\le {{hi}}$.",
          "On this right-hand branch the function increases from {{k}} to {{top}}, so ${{k}}\\le y\\le {{top}}$."
        ]
      },
      "attemptFeedback": [
        "Evaluate the function at the restricted endpoint as well as at the vertex."
      ],
      "supportHints": [
        "Because the domain begins at the vertex and moves right, the outputs increase."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "int",
            "min": 1,
            "max": 3
          },
          "h": {
            "type": "int",
            "min": -4,
            "max": 2
          },
          "k": {
            "type": "int",
            "min": -6,
            "max": 6
          },
          "span": {
            "type": "int",
            "min": 2,
            "max": 4
          }
        },
        "derived": {
          "hi": "h+span",
          "top": "a*span*span+k"
        }
      },
      "variants": [
        {
          "coverageKey": "core-d2b3",
          "dok": 2,
          "difficultyBand": 3
        },
        {
          "coverageKey": "adaptive-d2b4-domain-crosses-vertex-range",
          "dok": 2,
          "difficultyBand": 4,
          "prompt": "For $q(x)={{a}}(x-{{h}})^2{{k|signed}}$ restricted to ${{lo}}\\le x\\le {{hi}}$, determine the domain and range as inequalities. The restricted domain crosses the vertex, so evaluate the vertex and BOTH endpoints before deciding the maximum output.",
          "responseFields": [
            {
              "id": "domain",
              "label": "Domain inequality",
              "inputProfile": "inequality",
              "expected": "{{lo}}<=x and x<={{hi}}"
            },
            {
              "id": "left-output",
              "label": "q({{lo}})",
              "inputProfile": "number",
              "expected": "{{yleft}}"
            },
            {
              "id": "vertex-output",
              "label": "Vertex output",
              "inputProfile": "number",
              "expected": "{{k}}"
            },
            {
              "id": "right-output",
              "label": "q({{hi}})",
              "inputProfile": "number",
              "expected": "{{yright}}"
            },
            {
              "id": "range",
              "label": "Range inequality",
              "inputProfile": "inequality",
              "expected": "{{k}}<=y and y<={{yleft}}"
            }
          ],
          "solutionReview": {
            "headline": "When a restricted interval crosses the vertex, compare the vertex with both endpoint outputs.",
            "reasoning": [
              "The vertex x={{h}} lies inside the restricted domain ${{lo}}\\le x\\le {{hi}}$, so the minimum output is {{k}}.",
              "The left endpoint is farther from the vertex than the right endpoint, giving q({{lo}})={{yleft}} and q({{hi}})={{yright}}.",
              "Because the parabola opens upward, the restricted range is ${{k}}\\le y\\le {{yleft}}$."
            ],
            "answerSummary": "Domain: {{lo}}≤x≤{{hi}}; range: {{k}}≤y≤{{yleft}}."
          },
          "attemptFeedback": [
            "Do not assume the right endpoint gives the largest output; compare distances from the vertex."
          ],
          "supportHints": [
            "For an upward-opening parabola, farther horizontal distance from the vertex gives a larger output."
          ],
          "generator": {
            "parameters": {
              "a": {
                "type": "int",
                "min": 1,
                "max": 3
              },
              "h": {
                "type": "int",
                "min": -3,
                "max": 3
              },
              "k": {
                "type": "int",
                "min": -6,
                "max": 6
              },
              "left": {
                "type": "int",
                "min": 3,
                "max": 5
              },
              "right": {
                "type": "int",
                "min": 1,
                "max": 2
              }
            },
            "derived": {
              "lo": "h-left",
              "hi": "h+right",
              "yleft": "a*left*left+k",
              "yright": "a*right*right+k"
            }
          }
        }
      ]
    },
