        ],
        "answerSummary": "$x+2y+z={{r1}},\\;3x+y+2z={{r2}},\\;2x+3y+z={{r3}}$"
      },
      "attemptFeedback": [
        "Do not combine rows; each row is one separate equation in the system."
      ],
