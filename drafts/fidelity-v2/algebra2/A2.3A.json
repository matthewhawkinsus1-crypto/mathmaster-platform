      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.3A",
      "representation": "context",
      "difficultyBand": 3,
      "dok": 2,
      "taskType": "modeling",
      "prompt": "A shipment contains small crates $x$, medium crates $y$, and large crates $z$. There are {{count}} crates total. Small, medium, and large crates weigh 2, 3, and 5 units, for total weight {{weight}}. Their storage-volume scores are 1, 4, and 2 units, for total volume score {{volume}}. Formulate the three-equation system.",
      "responseFields": [
        {
          "id": "count",
          "label": "Crate-count equation",
          "inputProfile": "equation",
          "expected": "x+y+z={{count}}"
        },
        {
          "id": "weight",
          "label": "Weight equation",
          "inputProfile": "equation",
          "expected": "2x+3y+5z={{weight}}"
        },
        {
          "id": "volume",
          "label": "Volume-score equation",
          "inputProfile": "equation",
          "expected": "x+4y+2z={{volume}}"
        }
      ],
      "solutionReview": {
        "headline": "A system can encode several measurements of the same three unknown counts.",
        "reasoning": [
          "The count equation gives every crate coefficient 1.",
          "Weight and volume equations use the per-crate rates as coefficients."
        ],
        "answerSummary": "$x+y+z={{count}},\\;2x+3y+5z={{weight}},\\;x+4y+2z={{volume}}$"
      },
      "attemptFeedback": [
        "Match each measurement to its own set of coefficients."
      ],
      "supportHints": [
        "For a total measurement, multiply each unknown count by that type's per-item measurement."
      ],
      "generator": {
        "parameters": {
          "x": {
            "type": "int",
            "min": 1,
            "max": 8
          },
          "y": {
            "type": "int",
            "min": 1,
            "max": 8
          },
          "z": {
            "type": "int",
            "min": 1,
            "max": 8
          }
        },
        "derived": {
          "count": "x+y+z",
          "weight": "2*x+3*y+5*z",
          "volume": "x+4*y+2*z"
        }
      }
    },
    {
