      "assessedConstruct": "A2.3A",
      "representation": "context",
      "difficultyBand": 2,
      "dok": 2,
      "taskType": "modeling",
      "prompt": "A school store sells notebooks for $x$ dollars, folders for $y$ dollars, and binders for $z$ dollars. One notebook, one folder, and one binder cost {{t1}} dollars. Two notebooks, one folder, and one binder cost {{t2}} dollars. One notebook, two folders, and one binder cost {{t3}} dollars. Formulate the three-equation system that models the purchases.",
      "responseFields": [
        {
          "id": "eq1",
          "label": "Equation for purchase 1",
          "inputProfile": "equation",
          "expected": "x+y+z={{t1}}"
        },
        {
          "id": "eq2",
          "label": "Equation for purchase 2",
          "inputProfile": "equation",
          "expected": "2x+y+z={{t2}}"
        },
        {
          "id": "eq3",
          "label": "Equation for purchase 3",
          "inputProfile": "equation",
          "expected": "x+2y+z={{t3}}"
        }
      ],
      "solutionReview": {
        "headline": "Each purchase becomes one equation.",
        "reasoning": [
          "The coefficients count how many notebooks, folders, and binders appear in that purchase.",
          "The purchase total is the right-hand side."
        ],
        "answerSummary": "$x+y+z={{t1}},\\;2x+y+z={{t2}},\\;x+2y+z={{t3}}$"
      },
      "attemptFeedback": [
        "Use a coefficient of 1 when exactly one of an item is purchased."
      ],
      "supportHints": [
        "Translate each purchase separately before combining the three equations into one system."
      ],
      "generator": {
        "parameters": {
          "x": {
            "type": "int",
            "min": 1,
            "max": 8
          },
          "y": {
            "type": "int",
            "min": 1,
            "max": 8
          },
          "z": {
            "type": "int",
            "min": 1,
            "max": 8
          }
        },
        "derived": {
          "t1": "x+y+z",
          "t2": "2*x+y+z",
          "t3": "x+2*y+z"
        }
      }
    },
    {
      "id": "mm_A2_3A_v2_shipping-three-variable-model",
      "active": true,
      "alignmentKeys": [
        "texas:A2.3A"
      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.3A:v2-shipping-three-variable-model",
