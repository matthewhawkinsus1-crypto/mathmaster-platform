    {
      "id": "mm_A2_3A_v2_linear-quadratic-error-repair",
      "active": true,
      "alignmentKeys": [
        "texas:A2.3A"
      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.3A:v2-linear-quadratic-error-repair",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.3A",
      "representation": "verbal",
      "difficultyBand": 4,
      "dok": 3,
      "taskType": "errorAnalysis",
      "prompt": "A system should contain a line with slope {{m}} and y-intercept {{b}}, plus an upward unit parabola with vertex $({{h}},{{k}})$. A student writes the system shown below. Diagnose the modeling error and formulate the corrected two-equation system.",
      "stimulus": {
        "kind": "steps",
        "title": "Student's proposed system",
        "steps": [
          {
            "id": "line",
            "label": "Line",
            "work": "$y={{m}}x{{b|signed}}$"
          },
          {
            "id": "quad",
            "label": "Parabola",
            "work": "$y=(x+({{h}}))^2{{k|signed}}$"
          }
        ]
      },
      "responseFields": [
        {
          "id": "diagnosis",
          "label": "Diagnosis",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "inside-sign",
              "label": "The horizontal shift in vertex form uses the opposite sign inside the parentheses."
            },
            {
              "id": "line-degree",
              "label": "The line must also be quadratic."
            },
            {
              "id": "no-system",
              "label": "A line and parabola cannot form a system."
            }
          ],
          "expected": "inside-sign"
        },
        {
          "id": "line",
          "label": "Correct linear equation",
          "inputProfile": "equation",
          "expected": "y={{m}}x{{b|signed}}"
        },
        {
          "id": "quadratic",
          "label": "Correct quadratic equation",
          "inputProfile": "equation",
          "expected": "y=(x-({{h}}))^2{{k|signed}}"
        }
      ],
      "solutionReview": {
        "headline": "Correct the model, not just the explanation.",
        "reasoning": [
          "The line already matches the stated slope and intercept.",
          "Vertex form $y=(x-h)^2+k$ uses the opposite sign of the vertex x-coordinate inside the parentheses."
        ],
        "answerSummary": "$y={{m}}x{{b|signed}}$ and $y=(x-({{h}}))^2{{k|signed}}$"
      },
      "attemptFeedback": [
        "After diagnosing the error, still write both equations of the corrected system."
      ],
      "supportHints": [
        "A vertex at $(h,k)$ corresponds to $(x-h)^2+k$."
      ],
