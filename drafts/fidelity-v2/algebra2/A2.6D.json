          "taskType": "errorAnalysis",
          "representation": "verbal",
          "prompt": "A measurement x must be exactly {{d}} units from {{h}}. A student writes $x-({{h}})={{d}}$, which captures only the value on one side of {{h}}. Diagnose the modeling error and formulate the corrected absolute-value equation. Do not solve it.",
          "responseFields": [
            {
              "id": "diagnosis",
              "label": "Diagnosis",
              "inputProfile": "choice",
              "choices": [
                {
                  "id": "absolute",
                  "label": "Distance must use absolute value so both directions from the center are represented."
                },
                {
                  "id": "square",
                  "label": "The linear expression must be squared."
                },
                {
                  "id": "none",
                  "label": "The one-sided equation already captures both possible measurements."
                }
