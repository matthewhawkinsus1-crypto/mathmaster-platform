            }
          ],
          "solutionReview": {
            "headline": "Distance from a center is represented by absolute value.",
            "reasoning": [
              "The equation $x-({{h}})={{d}}$ captures only the point to one side of {{h}}.",
              "Absolute value represents either direction with the same distance.",
              "The corrected model is $|x-({{h}})|={{d}}$."
            ],
            "answerSummary": "$|x-({{h}})|={{d}}$"
          },
          "attemptFeedback": [
            "Repair the model only; do not solve for the two x-values."
          ],
          "supportHints": [
            "Absolute value encodes distance without direction."
          ],
