      "prompt": "Solve the quadratic equation by factoring. Show the factored zero-product equation and then give both solutions: ${{a}}x^2+({{b}})x+({{c}})=0$.",
      "responseFields": [
        {
          "id": "factored",
          "label": "Factored zero-product equation",
          "inputProfile": "equation",
          "expected": "{{a}}(x-({{u}}))(x-({{v}}))=0"
        },
        {
          "id": "r1",
          "label": "Smaller solution",
          "inputProfile": "number",
          "expected": "{{u}}"
        },
        {
          "id": "r2",
          "label": "Larger solution",
          "inputProfile": "number",
          "expected": "{{v}}"
        }
      ],
      "solutionReview": {
        "headline": "Factoring turns one quadratic equation into two linear factors.",
        "reasoning": [
          "$${{a}}x^2+({{b}})x+({{c}})={{a}}(x-({{u}}))(x-({{v}}))$$.",
          "The zero-product property gives x={{u}} or x={{v}}."
        ],
        "answerSummary": "$x={{u}},\\;{{v}}$"
      },
      "attemptFeedback": [
        "Do not stop at the factors; set each factor equal to zero and solve both."
      ],
      "supportHints": [
        "The generated roots multiply and add to the coefficients after the leading factor is accounted for."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "int",
            "min": 1,
            "max": 3
