      "assessedConstruct": "A2.4F",
      "representation": "table",
      "difficultyBand": 4,
      "dok": 3,
      "taskType": "representationTranslation",
      "prompt": "Use the quadratic formula to solve the equation exactly. The discriminant is intentionally not a perfect square; do not replace the exact radicals with rounded decimals.",
      "stimulus": {
        "kind": "table",
        "title": "Quadratic coefficients",
        "table": {
          "headers": [
            "a",
            "b",
            "c"
          ],
          "rows": [
            [
              "1",
              "{{p}}",
              "{{q}}"
            ]
          ]
        },
        "note": "Solve $ax^2+bx+c=0$ using these coefficients."
      },
      "responseFields": [
        {
          "id": "discriminant",
          "label": "Discriminant $b^2-4ac$",
          "inputProfile": "number",
          "expected": "{{D}}"
        },
        {
          "id": "minus-root",
          "label": "Root from the minus sign",
          "inputProfile": "expression",
          "expected": "(-({{p}})-sqrt({{D}}))/2"
        },
        {
          "id": "plus-root",
          "label": "Root from the plus sign",
          "inputProfile": "expression",
          "expected": "(-({{p}})+sqrt({{D}}))/2"
        }
      ],
      "solutionReview": {
        "headline": "The quadratic formula gives exact radical solutions when the discriminant is not a square.",
        "reasoning": [
          "With a=1, b={{p}}, c={{q}}, the discriminant is {{D}}.",
          "$x=\\frac{-({{p}})\\pm\\sqrt{{{D}}}}{2}$.",
          "Because {{D}} is not a perfect square, keep the roots in exact radical form."
        ],
        "answerSummary": "$x=\\frac{-({{p}})-\\sqrt{{{D}}}}2$ or $x=\\frac{-({{p}})+\\sqrt{{{D}}}}2$"
      },
      "attemptFeedback": [
        "A decimal approximation can hide exact structure; keep the square root in the final answer."
      ],
      "supportHints": [
        "Substitute a=1, b={{p}}, c={{q}} into $(-b\\pm\\sqrt{b^2-4ac})/(2a)$."
      ],
      "generator": {
        "parameters": {
          "p": {
            "type": "choice",
            "values": [
              -6,
              -4,
              -2,
              0,
              2,
              4,
              6
            ]
          },
          "D": {
            "type": "choice",
            "values": [
              8,
              12,
              20
            ]
          }
        },
        "derived": {
          "q": "(p*p-D)/4"
        }
      }
