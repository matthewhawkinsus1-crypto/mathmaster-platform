    {
      "id": "mm_A2_4F_v2_exact-quadratic-formula",
      "active": true,
      "alignmentKeys": [
        "texas:A2.4F"
      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.4F:v2-exact-quadratic-formula",
