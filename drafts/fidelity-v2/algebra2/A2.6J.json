    {
      "id": "mm_A2_6J_v2_cleared-root-excluded-original",
      "active": true,
      "alignmentKeys": [
        "texas:A2.6J"
      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.6J:v2-cleared-root-excluded-original",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.6J",
      "representation": "multipleRepresentation",
      "difficultyBand": 3,
      "dok": 2,
      "taskType": "representationTranslation",
      "prompt": "Clearing the denominator in $\\frac{(x-({{h}}))(x-({{r}}))}{x-({{h}})}=0$ produces $(x-({{h}}))(x-({{r}}))=0$. A solver keeps candidate x={{h}} because it is a root of the cleared polynomial. Determine whether that candidate is reasonable in the original rational equation.",
      "stimulus": {
        "kind": "steps",
        "title": "Solver evidence",
        "steps": [
          {
            "id": "original",
            "label": "Original rational equation",
            "work": "$\\frac{(x-({{h}}))(x-({{r}}))}{x-({{h}})}=0$"
          },
          {
            "id": "cleared",
            "label": "After clearing denominator",
            "work": "$(x-({{h}}))(x-({{r}}))=0$"
          },
          {
            "id": "candidate",
            "label": "Candidate from cleared equation",
            "work": "$x={{h}}$"
          }
        ]
      },
      "responseFields": [
        {
          "id": "cleared-value",
          "label": "Value of the cleared polynomial at x={{h}}",
          "inputProfile": "number",
          "expected": "0"
        },
        {
          "id": "original-denominator",
          "label": "Original denominator x-({{h}}) at x={{h}}",
          "inputProfile": "number",
          "expected": "0"
        },
        {
          "id": "original-status",
          "label": "Status of the original rational expression",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "undefined",
              "label": "Undefined at x={{h}}"
            },
            {
              "id": "zero",
              "label": "Defined and equal to 0"
            },
            {
              "id": "one",
              "label": "Defined and equal to 1"
            }
          ],
          "expected": "undefined"
        },
        {
          "id": "verdict",
          "label": "Final reasonableness decision",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "reject",
              "label": "Reject x={{h}}; clearing the denominator created a root that is excluded from the original equation."
            },
            {
              "id": "keep",
              "label": "Keep x={{h}} because every root of the cleared polynomial must be valid."
            }
          ],
          "expected": "reject"
        }
      ],
      "solutionReview": {
        "headline": "A root of the cleared equation can still be impossible in the original rational equation.",
        "reasoning": [
          "The cleared polynomial is 0 at x={{h}}, so the transformed equation alone would keep it.",
          "But the original denominator x-({{h}}) is 0 there, so the original rational equation is undefined.",
          "Reject x={{h}}."
        ],
        "answerSummary": "Reject x={{h}}."
      },
      "attemptFeedback": [
        "The transformed polynomial is not enough; return to the original denominator."
      ],
      "supportHints": [
        "A denominator restriction survives denominator clearing and cancellation."
      ],
      "generator": {
        "parameters": {
          "h": {
            "type": "int",
            "min": -6,
            "max": 6
          },
          "gap": {
            "type": "int",
            "min": 1,
            "max": 8
          }
        },
        "derived": {
          "r": "h+gap"
        }
      }
    },
    {
      "id": "mm_A2_6J_v2_context-algebra-valid-negative-time",
      "active": true,
      "alignmentKeys": [
        "texas:A2.6J"
      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.6J:v2-context-algebra-valid-negative-time",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.6J",
      "representation": "context",
      "difficultyBand": 4,
      "dok": 3,
      "taskType": "application",
      "prompt": "A monitoring model is $\\frac{{{total}}}{t+{{shift}}}={{rate}}$, where t is elapsed time in hours after monitoring begins, so t\\ge0. Algebra produces candidate t={{candidate}}. Determine whether the candidate is reasonable by checking the original equation and the context.",
      "responseFields": [
        {
          "id": "denominator",
          "label": "Denominator t+{{shift}} at t={{candidate}}",
          "inputProfile": "number",
          "expected": "{{denom}}"
        },
        {
          "id": "left-value",
          "label": "Left-side value at t={{candidate}}",
          "inputProfile": "number",
          "expected": "{{rate}}"
        },
        {
          "id": "algebra-check",
          "label": "Does the candidate satisfy the original rational equation?",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "yes",
              "label": "Yes; both sides equal {{rate}}."
            },
            {
              "id": "no",
              "label": "No; the two sides differ."
            }
          ],
          "expected": "yes"
        },
        {
          "id": "verdict",
          "label": "Final reasonableness decision in context",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "reject-context",
              "label": "Reject t={{candidate}}; it is algebraically valid but violates t\\ge0 for elapsed time."
            },
            {
              "id": "keep",
              "label": "Keep t={{candidate}} because algebraic validity overrides the time context."
            }
          ],
          "expected": "reject-context"
        }
      ],
      "solutionReview": {
        "headline": "Reasonableness can impose a context restriction beyond algebraic validity.",
        "reasoning": [
          "At t={{candidate}}, the denominator is {{denom}} and the left side equals {{rate}}, so the rational equation is satisfied.",
          "But elapsed time is restricted to t\\ge0.",
          "Because {{candidate}} is negative, reject the candidate in this model."
        ],
        "answerSummary": "Algebraically valid, but unreasonable in context; reject t={{candidate}}."
      },
      "attemptFeedback": [
        "Separate the algebra check from the context check; a candidate may pass one and fail the other."
      ],
      "supportHints": [
        "First substitute into the original rational equation. Then apply t\\ge0."
      ],
      "generator": {
        "parameters": {
          "shift": {
            "type": "int",
            "min": 6,
            "max": 12
          },
          "candidate": {
            "type": "int",
            "min": -5,
            "max": -1
          },
          "rate": {
            "type": "int",
            "min": 5,
            "max": 20
          }
        },
        "derived": {
          "denom": "shift+candidate",
          "total": "rate*denom"
        },
        "constraints": [
          "denom>0"
        ]
      }
    },
    {
      "id": "mm_A2_6J_v2_rounded-residual-tolerance",
      "active": true,
      "alignmentKeys": [
        "texas:A2.6J"
      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.6J:v2-rounded-residual-tolerance",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.6J",
      "representation": "symbolic",
      "difficultyBand": 4,
      "dok": 3,
      "taskType": "reverseReasoning",
      "prompt": "For $\\frac{{{a}}}{x-({{h}})}={{r}}$, a calculator reports the rounded candidate x={{candidate}}. In this task a rounded candidate is reasonable when the absolute residual in the original equation is at most 0.01. Evaluate the original equation and decide whether to keep the candidate; do not re-solve it.",
      "responseFields": [
        {
          "id": "denominator",
          "label": "x-({{h}}) at the rounded candidate",
          "inputProfile": "number",
          "numericTolerance": 0.001,
          "expected": "{{denom}}"
        },
        {
          "id": "left-value",
          "label": "Left-side value at x={{candidate}}",
          "inputProfile": "number",
          "numericTolerance": 0.002,
          "expected": "{{lhs}}"
        },
        {
          "id": "residual",
          "label": "Absolute residual |left side - {{r}}|",
          "inputProfile": "number",
          "numericTolerance": 0.002,
          "expected": "{{residual}}"
        },
        {
          "id": "verdict",
          "label": "Tolerance-based reasonableness decision",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "keep",
              "label": "Keep the rounded candidate; its residual is at most 0.01."
            },
            {
              "id": "reject",
              "label": "Reject the rounded candidate; its residual exceeds 0.01."
            }
          ],
          "expected": "keep"
        }
      ],
      "solutionReview": {
        "headline": "Approximate reasonableness should be tied to an explicit tolerance, not to guesswork.",
        "reasoning": [
          "Substitute x={{candidate}} into the original rational expression.",
          "The absolute residual is {{residual}}, which is at most the stated 0.01 tolerance.",
          "Keep the rounded candidate at the requested precision."
        ],
        "answerSummary": "Keep x={{candidate}} within the 0.01 residual tolerance."
      },
      "attemptFeedback": [
        "Use the original equation to compute a residual, then compare that residual with 0.01."
      ],
      "supportHints": [
        "Residual means the absolute difference between the two sides after substitution."
      ],
      "generator": {
        "parameters": {
          "h": {
            "type": "int",
            "min": -4,
            "max": 4
          },
          "a": {
            "type": "int",
            "min": 5,
            "max": 30
          },
          "r": {
            "type": "int",
            "min": 3,
            "max": 11
          }
        },
        "derived": {
          "exact": "h+a/r",
          "candidate": "round(1000*exact)/1000",
          "denom": "candidate-h",
          "lhs": "a/denom",
          "residual": "abs(lhs-r)"
        },
        "constraints": [
          "a%r!=0",
          "denom!=0",
          "residual<=0.01",
          "residual>0"
        ],
        "attempts": 300
      }
    },
