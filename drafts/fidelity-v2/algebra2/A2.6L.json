  "certificationStatus": "candidate-formulate-and-solve-inverse-variation-constant-model-prediction-table-context-error-repair",
  "rationale": "TEA breaks A2.6L into formulate and solve actions. Every Fidelity V2 family therefore collects evidence for the inverse-variation constant, a student-authored model, and a solved prediction, with representation and context breadth while staying distinct from general rational formulation/solving standards.",
  "documents": [
    {
      "id": "mm_A2_6L_v2_symbolic-formulate-solve",
      "active": true,
      "alignmentKeys": [
        "texas:A2.6L"
      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.6L:v2-symbolic-formulate-solve",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.6L",
      "representation": "symbolic",
      "difficultyBand": 2,
      "dok": 2,
      "taskType": "procedural",
      "prompt": "y varies inversely with x. Given y={{y1}} when x={{x1}}, determine the constant of variation, formulate the inverse-variation equation in the form y=k/x, and then use your equation to find y when x={{x2}}.",
      "responseFields": [
        {
          "id": "constant",
          "label": "Constant of variation k",
          "inputProfile": "number",
          "expected": "{{k}}"
        },
        {
          "id": "equation",
          "label": "Inverse-variation equation",
          "inputProfile": "equation",
          "equivalence": "modelEquation",
          "expected": "y={{k}}/x"
        },
        {
          "id": "prediction",
          "label": "y when x={{x2}}",
          "inputProfile": "number",
          "expected": "{{y2}}"
        }
      ],
      "solutionReview": {
        "headline": "Inverse variation keeps the product xy constant.",
        "reasoning": [
          "Use the known pair: k=({{x1}})({{y1}})={{k}}.",
          "The model is y={{k}}/x.",
          "Substitute x={{x2}} to get y={{y2}}."
        ],
        "answerSummary": "k={{k}}, y={{k}}/x, and y={{y2}} when x={{x2}}."
      },
      "attemptFeedback": [
        "Do not stop after finding k; the TEKS requires you to formulate the equation and then solve a new case."
      ],
      "supportHints": [
        "For inverse variation, xy=k, so multiply the known x- and y-values first."
      ],
      "generator": {
        "parameters": {
          "x1": {
            "type": "int",
            "min": 2,
            "max": 12
          },
          "y1": {
            "type": "int",
            "min": 2,
            "max": 12
          },
          "x2": {
            "type": "int",
            "min": 2,
            "max": 12
          }
        },
        "derived": {
          "k": "x1*y1",
          "y2": "k/x2"
        },
        "constraints": [
          "x2!=x1",
          "k%x2==0"
        ]
      }
    },
    {
      "id": "mm_A2_6L_v2_table-constant-product-model-predict",
