    {
      "id": "mm_A2_6L_v2_fixed-distance-time-context",
      "active": true,
      "alignmentKeys": [
        "texas:A2.6L"
      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.6L:v2-fixed-distance-time-context",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.6L",
      "representation": "context",
      "difficultyBand": 3,
      "dok": 2,
      "taskType": "modeling",
      "prompt": "A vehicle travels a fixed route. When its average speed is {{v1}} miles per hour, the trip takes {{t1}} hours. For a fixed distance, travel time t varies inversely with speed v. Determine the constant, formulate t as an inverse-variation equation in v, and predict the travel time at {{v2}} miles per hour.",
      "responseFields": [
        {
          "id": "constant",
          "label": "Constant of variation / fixed distance",
          "inputProfile": "number",
          "unit": "miles",
          "expected": "{{d}}"
        },
        {
          "id": "equation",
          "label": "Inverse-variation time model",
          "inputProfile": "equation",
          "equivalence": "modelEquation",
          "expected": "t={{d}}/v"
        },
        {
          "id": "prediction",
          "label": "Travel time at {{v2}} mph",
          "inputProfile": "number",
          "unit": "hours",
          "expected": "{{t2}}"
        }
      ],
      "solutionReview": {
        "headline": "Fixed distance makes speed and travel time an inverse variation.",
        "reasoning": [
          "The constant is vt=({{v1}})({{t1}})={{d}} miles.",
          "So t={{d}}/v.",
          "At v={{v2}}, t={{d}}/{{v2}}={{t2}} hours."
        ],
        "answerSummary": "t={{d}}/v; the predicted time is {{t2}} hours."
      },
      "attemptFeedback": [
        "The fixed quantity is distance, so use speed × time to determine the inverse-variation constant."
      ],
      "supportHints": [
        "Start with vt=k, then solve that relationship for t."
      ],
      "generator": {
        "parameters": {
          "v1": {
            "type": "int",
            "min": 30,
            "max": 70,
            "step": 5
          },
          "t1": {
            "type": "int",
            "min": 2,
            "max": 6
          },
          "v2": {
            "type": "int",
            "min": 30,
            "max": 80,
            "step": 5
          }
        },
        "derived": {
          "d": "v1*t1",
          "t2": "d/v2"
        },
        "constraints": [
          "v2!=v1",
          "d%v2==0"
        ],
        "attempts": 300
      }
    },
    {
      "id": "mm_A2_6L_v2_fixed-area-rectangle-context",
