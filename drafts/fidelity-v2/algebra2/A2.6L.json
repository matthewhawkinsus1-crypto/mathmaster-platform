          "id": "diagnosis",
          "label": "What is the student's main error?",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "direct",
              "label": "The student used the direct-variation relationship y=kx instead of the inverse-variation constant product xy=k."
            },
            {
              "id": "multiply",
              "label": "The student should multiply the direct-variation constant by x twice."
            },
            {
              "id": "same",
              "label": "Direct and inverse variation use the same equation, so there is no error."
            }
          ],
          "expected": "direct"
        },
        {
          "id": "constant",
          "label": "Correct constant of variation k",
          "inputProfile": "number",
