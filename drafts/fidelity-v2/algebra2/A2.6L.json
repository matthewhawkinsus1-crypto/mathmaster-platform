        "table": {
          "headers": [
            "x",
            "y",
            "xy"
          ],
          "rows": [
            [
              "{{x1}}",
              "{{y1}}",
              "?"
            ],
            [
              "{{x2}}",
              "{{y2}}",
              "?"
            ],
            [
              "{{x3}}",
              "{{y3}}",
              "?"
            ],
            [
              "{{x4}}",
              "?",
              "?"
            ]
          ]
        }
      },
      "responseFields": [
        {
          "id": "product-1",
          "label": "Product from row 1",
          "inputProfile": "number",
          "expected": "{{k}}"
        },
        {
          "id": "product-2",
          "label": "Product from row 2",
          "inputProfile": "number",
          "expected": "{{k}}"
        },
        {
          "id": "product-3",
          "label": "Product from row 3",
          "inputProfile": "number",
          "expected": "{{k}}"
        },
        {
          "id": "constant",
          "label": "Constant of variation k",
          "inputProfile": "number",
          "expected": "{{k}}"
        },
        {
          "id": "equation",
          "label": "Inverse-variation equation",
          "inputProfile": "equation",
          "equivalence": "modelEquation",
          "expected": "y={{k}}/x"
        },
        {
          "id": "missing-y",
          "label": "Missing y-value when x={{x4}}",
          "inputProfile": "number",
          "expected": "{{y4}}"
        }
      ],
      "solutionReview": {
        "headline": "Multiple constant products justify the inverse-variation model.",
        "reasoning": [
          "Each completed row has product xy={{k}}.",
          "Therefore k={{k}} and the equation is y={{k}}/x.",
          "At x={{x4}}, y={{k}}/{{x4}}={{y4}}."
        ],
        "answerSummary": "The table follows y={{k}}/x and the missing value is {{y4}}."
      },
      "attemptFeedback": [
        "Use more than one row as evidence before writing the equation."
      ],
      "supportHints": [
        "If the table is inverse variation, each completed x·y product should match."
      ],
      "generator": {
        "parameters": {
          "k": {
            "type": "int",
            "min": 24,
            "max": 120,
            "step": 6
          },
          "x1": {
            "type": "int",
            "min": 2,
            "max": 10
          },
          "x2": {
            "type": "int",
            "min": 2,
            "max": 12
          },
          "x3": {
            "type": "int",
            "min": 2,
            "max": 12
          },
          "x4": {
            "type": "int",
            "min": 2,
            "max": 12
          }
        },
        "derived": {
          "y1": "k/x1",
          "y2": "k/x2",
          "y3": "k/x3",
          "y4": "k/x4"
        },
        "constraints": [
          "k%x1==0",
          "k%x2==0",
          "k%x3==0",
          "k%x4==0",
          "x1!=x2",
          "x1!=x3",
          "x2!=x3",
          "x4!=x1",
          "x4!=x2",
          "x4!=x3"
        ],
        "attempts": 300
      }
