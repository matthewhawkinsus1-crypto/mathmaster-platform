      "assessedConstruct": "A2.5D",
      "representation": "multipleRepresentation",
      "difficultyBand": 4,
      "dok": 3,
      "taskType": "procedural",
      "prompt": "Solve ${{target}}={{a}}\\cdot 2^x$. The isolated ratio is intentionally not a power of 2, so give an exact logarithmic solution and a decimal approximation.",
      "stimulus": {
        "kind": "table",
        "title": "Solve plan",
        "table": {
          "headers": [
            "Step",
            "Result"
          ],
          "rows": [
            [
              "Original",
              "${{target}}={{a}}\\cdot2^x$"
            ],
            [
              "After dividing by {{a}}",
              "$2^x={{ratio}}$"
            ]
          ]
        }
      },
      "responseFields": [
        {
          "id": "isolated",
          "label": "Isolated exponential equation",
          "inputProfile": "equation",
          "expected": "2^x={{ratio}}"
        },
        {
          "id": "exact",
          "label": "Exact solution for x",
          "inputProfile": "expression",
          "expected": "ln({{ratio}})/ln(2)"
        },
        {
          "id": "approx",
          "label": "Decimal x (nearest thousandth)",
          "inputProfile": "number",
          "numericTolerance": 0.0015,
          "expected": "{{approx}}"
        }
      ],
      "solutionReview": {
        "headline": "When the target ratio is not a base-2 power, logarithms isolate the exponent.",
        "reasoning": [
          "Divide by {{a}} to get $2^x={{ratio}}$.",
          "Taking natural logs gives $x\\ln2=\\ln({{ratio}})$.",
          "So $x=\\ln({{ratio}})/\\ln2\\approx{{approx}}$."
        ],
        "answerSummary": "$x=\\frac{\\ln({{ratio}})}{\\ln2}\\approx{{approx}}$"
      },
      "attemptFeedback": [
        "Do not round before writing the exact logarithmic solution."
      ],
      "supportHints": [
        "For $2^x=r$, take ln of both sides and divide by ln 2."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "int",
            "min": 2,
            "max": 9
          },
          "ratio": {
            "type": "choice",
            "values": [
              3,
              5,
              6,
              7,
              10
            ]
          }
        },
        "derived": {
          "target": "a*ratio",
          "approx": "round(log(ratio)/log(2),3)"
        }
      }
