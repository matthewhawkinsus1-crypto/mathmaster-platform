          "expected": "{{r}}"
        },
        {
          "id": "answer",
          "label": "Equivalent simplified radical expression",
          "inputProfile": "expression",
          "expected": "x^{{m}}*\\sqrt[{{q}}]{x^{{r}}}",
          "equivalence": "nonnegativeRadicalExpression"
        }
      ],
      "solutionReview": {
        "headline": "A rational exponent separates into a whole power and a root.",
        "reasoning": [
          "{{p}}/{{q}}={{m}}+{{r}}/{{q}}.",
          "The denominator {{q}} becomes the root index and the remainder {{r}} stays as the inside exponent.",
          "So the expression becomes $x^{{m}}\\sqrt[{{q}}]{x^{{r}}}$."
        ],
        "answerSummary": "$x^{{m}}\\sqrt[{{q}}]{x^{{r}}}$"
      },
      "attemptFeedback": [
        "Divide the numerator of the exponent by the denominator before writing the radical."
      ],
      "supportHints": [
        "Divide the numerator of the exponent by the denominator before writing the radical.",
        "The generator keeps the remaining exponent and root index relatively prime, so the final indexed radical is fully simplified."
