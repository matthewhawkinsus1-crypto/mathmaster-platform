      "prompt": "Assume x≥0. Rewrite $x^({{p}}/{{q}})$ as an equivalent simplified radical expression. Separate the whole-number power from the fractional part.",
      "responseFields": [
        {
          "id": "whole-power",
          "label": "Whole-number power of x outside the radical",
