          "label": "Power of x remaining inside the square root",
          "inputProfile": "number",
          "expected": "1"
        },
        {
          "id": "answer",
          "label": "Equivalent simplified radical expression",
          "inputProfile": "expression",
          "expected": "{{k}}*x^{{m}}*sqrt(x)",
          "equivalence": "nonnegativeRadicalExpression"
        }
      ],
      "solutionReview": {
        "headline": "Extract even powers from a square root.",
        "reasoning": [
          "${{k2}}={{k}}^2 and x^{{exp}}=x^{{twoM}}x.",
          "Because x≥0, $\\sqrt{x^{{twoM}}}=x^{{m}}$.",
          "The equivalent form is ${{k}}x^{{m}}\\sqrt{x}$."
        ],
        "answerSummary": "${{k}}x^{{m}}\\sqrt{x}$"
      },
      "attemptFeedback": [
        "Separate the largest even power of x from the one x that remains under the radical."
      ],
      "supportHints": [
