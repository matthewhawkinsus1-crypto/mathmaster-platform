      "taskType": "errorAnalysis",
      "prompt": "A student claims that $q(x)=(x-({{h}}))^2{{k|signed}}$ and $r(x)=\\sqrt{x-({{k}})}+{{h}}$ are inverse functions when $q$ has domain all real numbers. Analyze the claim and correct it.",
      "stimulus": {
        "kind": "steps",
        "title": "Student's argument",
        "steps": [
          {
            "id": "s1",
            "label": "Step 1",
            "work": "Swap $x$ and $y$ in the quadratic."
          },
          {
            "id": "s2",
            "label": "Step 2",
            "work": "Take a square root and use only the principal branch."
