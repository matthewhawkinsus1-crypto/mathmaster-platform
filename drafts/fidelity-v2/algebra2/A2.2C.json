          {
            "id": "s3",
            "label": "Claim",
            "work": "Therefore $r(q(x))=x$ for every real $x$."
          }
        ],
        "note": "Test the claim at $x={{testX}}$, which lies to the left of the vertex."
      },
      "responseFields": [
        {
          "id": "diagnosis",
          "label": "Best diagnosis",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "abs",
              "label": "The composition becomes $|x-{{h}}|+{{h}}$, so it does not equal $x$ on both sides of the vertex."
            },
            {
              "id": "reciprocal",
              "label": "The mistake is that an inverse should be the reciprocal $1/q(x)$."
            },
            {
              "id": "always",
              "label": "There is no mistake; the functions are inverses on all real numbers."
            }
          ],
          "expected": "abs"
        },
