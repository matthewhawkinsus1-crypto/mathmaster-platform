      "taskType": "errorAnalysis",
      "prompt": "A fill pipe fills a tank in {{a}} hours while a drain empties it in {{b}} hours. Let t be the net fill time with both open. A student adds both rates as positive. Diagnose the sign error and formulate the corrected rational equation. Do not solve.",
      "responseFields": [
        {
          "id": "diagnosis",
          "label": "Diagnosis",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "subtract",
              "label": "The drain removes work, so its rate must be subtracted."
            },
            {
              "id": "add",
              "label": "Both rates should be added."
            },
            {
              "id": "times",
              "label": "The completion times should be added directly."
            }
          ],
          "expected": "subtract"
        },
        {
          "id": "equation",
          "label": "Correct net-rate equation",
          "inputProfile": "equation",
          "equivalence": "modelEquation",
          "expected": "1/{{a}}-1/{{b}}=1/t"
        }
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "int",
            "min": 3,
            "max": 7
          },
          "gap": {
            "type": "int",
            "min": 2,
            "max": 6
          }
        },
        "derived": {
          "b": "a+gap"
        }
      },
      "variants": [
        {
          "coverageKey": "core-d3b4",
          "dok": 3,
          "difficultyBand": 4
        },
        {
          "coverageKey": "adaptive-d3b3-simple-drain-sign-repair",
          "dok": 3,
          "difficultyBand": 3,
          "taskType": "errorAnalysis",
          "representation": "verbal",
          "prompt": "A fill pipe completes a tank in {{a}} hours and a drain empties the same tank in {{b}} hours. A student models both as positive contributions and writes $1/{{a}}+1/{{b}}=1/t$. Diagnose the modeling error and formulate the corrected net-rate equation. Do not solve.",
          "responseFields": [
            {
              "id": "diagnosis",
              "label": "Diagnosis",
              "inputProfile": "choice",
              "choices": [
                {
                  "id": "subtract",
                  "label": "The drain removes tank volume, so its rate must be subtracted from the fill rate."
                },
                {
                  "id": "add",
                  "label": "Both rates should be positive because both devices are operating."
                },
                {
                  "id": "times",
                  "label": "Add the completion times instead of the rates."
                }
              ],
              "expected": "subtract"
            },
            {
              "id": "equation",
              "label": "Correct net-rate equation",
              "inputProfile": "equation",
              "equivalence": "modelEquation",
              "expected": "1/{{a}}-1/{{b}}=1/t"
            }
          ],
          "solutionReview": {
            "headline": "Opposing processes have opposite rate signs.",
            "reasoning": [
              "The fill pipe contributes +1/{{a}} tank per hour.",
              "The drain contributes -1/{{b}} tank per hour.",
              "Therefore the net-rate model is $1/{{a}}-1/{{b}}=1/t$."
            ],
            "answerSummary": "Subtract the drain rate; do not solve for t."
          },
          "attemptFeedback": [
            "Reason about whether each process adds to or removes from the completed job."
          ],
          "supportHints": [
            "A drain works against a fill pipe, so its contribution is negative."
          ],
          "generator": {
            "parameters": {
              "a": {
                "type": "int",
                "min": 3,
                "max": 6
              },
              "gap": {
                "type": "int",
                "min": 2,
                "max": 5
              }
            },
            "derived": {
              "b": "a+gap"
            }
          }
        }
      ],
      "solutionReview": {
        "headline": "A drain contributes a negative work rate.",
        "reasoning": [
          "The fill pipe contributes $1/{{a}}$ tank per hour.",
          "The drain removes $1/{{b}}$ tank per hour, so its rate must be subtracted rather than added.",
          "The net rate equals $1/t$, giving the corrected rational equation."
        ],
        "answerSummary": "$1/{{a}}-1/{{b}}=1/t$."
      }
    }
