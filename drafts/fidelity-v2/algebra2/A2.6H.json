    {
      "id": "mm_A2_6H_v2_round-trip-current-equation",
      "active": true,
      "alignmentKeys": [
        "texas:A2.6H"
      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.6H:v2-round-trip-current-equation",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.6H",
      "representation": "multipleRepresentation",
      "difficultyBand": 4,
      "dok": 3,
      "taskType": "modeling",
      "prompt": "A boat travels {{d}} miles upstream and {{d}} miles downstream in a total of {{T}} hours. The current is {{c}} mph. Let v be the boat's speed in still water. Formulate the rational equation in v; do not solve it.",
      "stimulus": {
        "kind": "table",
        "table": {
          "headers": [
            "Leg",
            "Distance",
            "Actual speed"
          ],
          "rows": [
            [
              "Upstream",
              "{{d}}",
              "$v-{{c}}$"
            ],
            [
              "Downstream",
              "{{d}}",
              "$v+{{c}}$"
            ]
          ]
        }
      },
      "responseFields": [
        {
          "id": "up-time",
          "label": "Upstream time",
          "inputProfile": "expression",
          "expected": "{{d}}/(v-{{c}})"
        },
        {
          "id": "down-time",
          "label": "Downstream time",
          "inputProfile": "expression",
          "expected": "{{d}}/(v+{{c}})"
        },
        {
          "id": "equation",
          "label": "Round-trip rational equation",
          "inputProfile": "equation",
          "equivalence": "modelEquation",
          "expected": "{{d}}/(v-{{c}})+{{d}}/(v+{{c}})={{T}}"
        },
        {
          "id": "restriction",
          "label": "Physical restriction on v",
          "inputProfile": "inequality",
          "expected": "v>{{c}}"
        }
      ],
      "generator": {
        "parameters": {
          "d": {
            "type": "int",
            "min": 20,
            "max": 80,
            "step": 10
          },
          "c": {
            "type": "int",
            "min": 2,
            "max": 8
          },
          "T": {
            "type": "int",
            "min": 2,
            "max": 8
          }
        }
      },
      "solutionReview": {
        "headline": "Current changes the upstream and downstream rates in opposite directions.",
        "reasoning": [
          "Upstream speed is $v-{{c}}$, so upstream time is ${{d}}/(v-{{c}})$.",
          "Downstream speed is $v+{{c}}$, so downstream time is ${{d}}/(v+{{c}})$.",
          "Their times sum to {{T}} hours. Physically, $v>{{c}}$ is required so the upstream speed is positive."
        ],
        "answerSummary": "${{d}}/(v-{{c}})+{{d}}/(v+{{c}})={{T}}$, with $v>{{c}}$."
      }
    },
