      "taskType": "modeling",
      "prompt": "Machine A completes one job in {{a}} hours and machine B in {{b}} hours. Let t be the hours needed when they work together. Formulate the rational equation; do not solve for t.",
      "responseFields": [
        {
          "id": "rate-a",
          "label": "Machine A rate",
          "inputProfile": "expression",
          "expected": "1/{{a}}"
        },
        {
          "id": "rate-b",
          "label": "Machine B rate",
          "inputProfile": "expression",
          "expected": "1/{{b}}"
        },
        {
          "id": "equation",
          "label": "Combined-work rational equation",
          "inputProfile": "equation",
          "equivalence": "modelEquation",
          "expected": "1/{{a}}+1/{{b}}=1/t"
        }
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "int",
            "min": 3,
            "max": 10
          },
          "b": {
            "type": "int",
            "min": 3,
            "max": 12
          }
        }
      },
      "solutionReview": {
        "headline": "Work rates add when both machines contribute to the same job.",
        "reasoning": [
          "A machine that finishes one job in {{a}} hours has rate $1/{{a}}$ job per hour; the other has rate $1/{{b}}$.",
          "Working together, their rates add and must equal the combined rate $1/t$."
        ],
        "answerSummary": "$1/{{a}}+1/{{b}}=1/t$."
      }
    },
