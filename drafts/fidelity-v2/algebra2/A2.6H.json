      "prompt": "A solution contains {{solute}} units of solute in {{V}} units of liquid. Pure solvent is added, so the solute amount stays fixed. Let x be the solvent added. Formulate the rational equation that makes the final concentration 20%. Do not solve.",
      "responseFields": [
        {
          "id": "new-volume",
          "label": "Final volume",
          "inputProfile": "expression",
          "expected": "{{V}}+x"
        },
        {
          "id": "equation",
          "label": "Dilution rational equation",
          "inputProfile": "equation",
          "equivalence": "modelEquation",
          "expected": "{{solute}}/({{V}}+x)=0.2"
        }
      ],
      "generator": {
        "parameters": {
          "V": {
            "type": "int",
            "min": 20,
            "max": 60,
            "step": 5
          },
          "x0": {
            "type": "int",
            "min": 10,
            "max": 30,
            "step": 5
          }
        },
        "derived": {
          "solute": "(V+x0)/5"
        }
      },
      "solutionReview": {
        "headline": "Adding pure solvent changes volume but not the amount of solute.",
        "reasoning": [
          "The solute amount stays {{solute}} while the final volume becomes ${{V}}+x$.",
          "Concentration is solute divided by total volume, so a 20% target is represented by ${{solute}}/({{V}}+x)=0.2$."
        ],
        "answerSummary": "${{solute}}/({{V}}+x)=0.2$."
      }
    },
    {
