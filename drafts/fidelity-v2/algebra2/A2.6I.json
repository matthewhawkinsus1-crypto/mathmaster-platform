      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.6I",
      "representation": "symbolic",
      "difficultyBand": 2,
      "dok": 2,
      "taskType": "procedural",
      "prompt": "Solve $\\frac{{{a}}}{x-({{h}})}{{k|signed}}={{r}}$. The denominator cannot be zero. Isolate the rational term, determine the denominator value, and finish x.",
      "responseFields": [
        {
          "id": "excluded",
          "label": "Excluded x-value from the denominator",
          "inputProfile": "number",
          "expected": "{{h}}"
        },
        {
          "id": "isolated-value",
          "label": "Value of a/(x-h) after isolating the rational term",
          "inputProfile": "number",
          "expected": "{{s}}"
        },
        {
          "id": "denominator",
          "label": "Value of x-h after clearing the isolated fraction",
          "inputProfile": "number",
          "expected": "{{d}}"
        },
        {
          "id": "solution",
          "label": "Solution x",
          "inputProfile": "number",
          "expected": "{{x}}"
        }
      ],
      "solutionReview": {
        "headline": "Isolate the rational expression before clearing its denominator.",
        "reasoning": [
          "Subtract {{k}} from both sides to get $\\frac{{{a}}}{x-({{h}})}={{s}}$.",
          "Because {{a}}={{d}}·{{s}}, clearing the denominator gives $x-({{h}})={{d}}$.",
          "Therefore $x={{x}}$, and {{x}} is not the excluded value {{h}}."
        ],
        "answerSummary": "$x={{x}}$"
      },
      "attemptFeedback": [
        "First isolate the fraction; then clear the denominator without losing the horizontal shift."
      ],
      "supportHints": [
        "Before solving, find the excluded input by setting the denominator expression equal to zero; then isolate the rational term."
      ],
      "generator": {
        "parameters": {
          "h": {
            "type": "int",
            "min": -6,
            "max": 6
          },
          "d": {
            "type": "int",
            "min": 1,
            "max": 9
          },
          "s": {
            "type": "int",
            "min": 2,
            "max": 7
          },
          "k": {
            "type": "int",
            "min": -5,
            "max": 5
          }
        },
        "derived": {
          "a": "d*s",
          "r": "k+s",
          "x": "h+d"
        }
      }
    },
