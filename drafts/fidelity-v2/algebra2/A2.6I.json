      "dok": 2,
      "taskType": "procedural",
      "prompt": "Solve $\\frac{x}{x-1}=\\frac{{{c}}}{x+{{b}}}$. Both real solutions are valid in the original equation. Clear the denominators, solve the resulting quadratic, and report both roots.",
      "stimulus": {
        "kind": "table",
        "title": "Denominator restrictions",
        "table": {
          "headers": [
            "Denominator",
            "Excluded value"
          ],
          "rows": [
            [
              "x-1",
              "1"
            ],
            [
              "x+{{b}}",
              "-{{b}}"
            ]
          ]
        }
      },
      "responseFields": [
        {
          "id": "cleared",
          "label": "Equation after clearing denominators",
          "inputProfile": "equation",
          "equivalence": "polynomialRelation",
          "expected": "x*(x+{{b}})={{c}}*(x-1)"
        },
        {
          "id": "root-1",
          "label": "Smaller real solution",
          "inputProfile": "number",
          "expected": "{{p}}"
        },
        {
          "id": "root-2",
          "label": "Larger real solution",
          "inputProfile": "number",
          "expected": "{{q}}"
        }
      ],
      "solutionReview": {
        "headline": "Clearing both denominators can produce a genuine quadratic equation.",
        "reasoning": [
          "Multiplying by $(x-1)(x+{{b}})$ gives $x(x+{{b}})={{c}}(x-1)$.",
          "The cleared quadratic factors with roots {{p}} and {{q}}.",
          "Neither root is 1 or -{{b}}, so both are real solutions of the original rational equation."
        ],
        "answerSummary": "$x={{p}}$ or $x={{q}}$"
      },
      "attemptFeedback": [
        "Do not cancel across addition. Multiply the entire equation by the common denominator."
      ],
      "supportHints": [
        "After clearing denominators, bring all terms to one side and factor the quadratic."
      ],
      "generator": {
        "parameters": {
          "p": {
            "type": "int",
            "min": 2,
            "max": 6
          },
          "q": {
            "type": "int",
            "min": 4,
            "max": 10
          }
        },
        "derived": {
          "c": "p*q",
          "b": "p*q-p-q"
        },
        "constraints": [
          "q>p"
        ]
      }
