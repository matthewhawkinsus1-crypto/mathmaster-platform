      "difficultyBand": 2,
      "dok": 2,
      "taskType": "interpretation",
      "prompt": "A solver proposes $x={{candidate}}$ for $\\log_2(x-({{h}}))={{n}}$. Determine whether the proposed solution is reasonable by checking the ORIGINAL logarithmic equation.",
      "responseFields": [
        {
          "id": "argument",
          "label": "Log argument $x-({{h}})$ at the candidate",
          "inputProfile": "number",
          "expected": "{{arg}}"
        },
        {
          "id": "domain",
          "label": "Is the logarithm defined at this candidate?",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "no",
              "label": "No — the argument is not positive."
            },
            {
              "id": "yes",
              "label": "Yes — the argument is positive."
            }
          ],
          "expected": "no"
        },
        {
          "id": "verdict",
          "label": "Reasonableness verdict",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "reject",
              "label": "Reject the candidate as unreasonable."
            },
            {
              "id": "keep",
              "label": "Keep the candidate as reasonable."
            }
          ],
          "expected": "reject"
        }
      ],
      "solutionReview": {
        "headline": "A real logarithm cannot accept a zero or negative argument.",
        "reasoning": [
          "Substitution gives the argument {{arg}}.",
          "Because {{arg}} is not positive, the original logarithm is undefined.",
          "The proposed x-value must be rejected."
        ],
        "answerSummary": "Reject $x={{candidate}}$."
      },
      "attemptFeedback": [
        "Use the candidate in the original logarithm before trusting any algebra that produced it."
      ],
      "supportHints": [
        "For a real logarithm, its argument must be strictly greater than zero."
      ],
      "generator": {
        "parameters": {
          "h": {
            "type": "int",
            "min": -6,
            "max": 6
          },
          "n": {
            "type": "int",
            "min": 1,
            "max": 4
          },
          "d": {
            "type": "int",
            "min": 1,
            "max": 5
          }
        },
        "derived": {
          "candidate": "h-d",
          "arg": "candidate-h"
        }
      }
