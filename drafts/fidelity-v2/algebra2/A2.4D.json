      "representation": "symbolic",
      "difficultyBand": 2,
      "dok": 2,
      "taskType": "procedural",
      "prompt": "Transform $f(x)={{a}}x^2{{b|signed}}x{{c|signed}}$ from standard form to vertex form by completing the square. Then identify the vertex and axis of symmetry.",
      "responseFields": [
        {
          "id": "factored",
          "label": "After factoring {{a}} from the quadratic and linear terms",
          "inputProfile": "equation",
          "expected": "f(x)={{a}}(x^2+({{innerB}})x)+({{c}})"
        },
        {
          "id": "square-add",
          "label": "Number added inside to complete the square",
          "inputProfile": "number",
          "expected": "{{squareAdd}}"
        },
        {
          "id": "vertex-form",
          "label": "Complete vertex form",
          "inputProfile": "equation",
          "expected": "f(x)={{a}}(x-({{h}}))^2+({{k}})"
        },
        {
          "id": "vertex",
          "label": "Vertex",
          "inputProfile": "orderedPair",
          "expected": "({{h}},{{k}})"
        },
        {
          "id": "axis",
          "label": "Axis of symmetry",
          "inputProfile": "equation",
          "expected": "x={{h}}"
        }
      ],
      "solutionReview": {
        "headline": "Factor the leading coefficient before completing the square.",
        "reasoning": [
          "Factoring {{a}} from the x² and x terms gives ${{a}}(x^2+({{innerB}})x)+({{c}})$.",
          "Half the inside x-coefficient is ${{negH}}$, so add {{squareAdd}} inside the grouping and compensate outside.",
          "The result is $f(x)={{a}}(x-({{h}}))^2+({{k}})$."
        ],
        "answerSummary": "Vertex $({{h}},{{k}})$; axis $x={{h}}$."
      },
      "attemptFeedback": [
        "Complete the square after factoring a from both variable terms, not before."
      ],
      "supportHints": [
        "Inside the parentheses, half the x-coefficient and square it."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "choice",
            "values": [
              2,
              3,
              4
            ]
          },
          "h": {
            "type": "int",
            "min": -5,
            "max": 5
          },
          "k": {
            "type": "int",
            "min": -7,
            "max": 7
          }
        },
        "derived": {
          "b": "-2*a*h",
          "c": "a*h*h+k",
          "innerB": "-2*h",
          "squareAdd": "h*h",
          "negH": "-h"
        }
      },
      "variants": [
