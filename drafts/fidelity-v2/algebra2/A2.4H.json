              "id": "two",
              "label": "2"
            }
          ],
          "expected": "zero"
        },
        {
          "id": "interval",
          "label": "Complete solution set",
          "inputProfile": "interval",
          "expected": "(-inf,inf)"
        }
      ],
      "solutionReview": {
        "headline": "No real zeros means the sign never changes.",
        "reasoning": [
          "The discriminant {{disc}} is negative, so the quadratic never crosses or touches the x-axis.",
          "The leading coefficient is positive, so the quadratic stays positive for every real x.",
          "Therefore the strict inequality is true for all real numbers."
        ],
        "answerSummary": "$(-\\infty,\\infty)$"
      },
      "attemptFeedback": [
        "Do not return an empty set just because there are no real zeros; determine whether the whole parabola lies above or below the x-axis."
      ],
      "supportHints": [
        "Negative discriminant + positive leading coefficient means the quadratic is always positive."
      ],
      "generator": {
