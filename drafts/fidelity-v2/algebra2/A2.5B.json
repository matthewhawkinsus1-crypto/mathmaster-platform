  "rationale": "A2.5B requires formulation, not recognition. Fidelity V2 makes students author explicit and recursive exponential models from growth, decay, and tabular evidence, plus an authentic logarithmic scale equation from a real-world ratio context.",
  "documents": [
    {
      "id": "mm_A2_5B_v2_growth-explicit-and-recursive",
      "active": true,
      "alignmentKeys": [
        "texas:A2.5B"
      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.5B:v2-growth-explicit-and-recursive",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.5B",
      "representation": "context",
      "difficultyBand": 2,
      "dok": 2,
      "taskType": "modeling",
      "prompt": "A population starts at {{p0}} and grows by {{pct}}% each year. Formulate BOTH an explicit exponential model and a recursive model. Use year 0 as the initial time.",
      "responseFields": [
        {
          "id": "factor",
          "label": "Annual growth factor",
          "inputProfile": "number",
          "expected": "{{factor}}"
        },
        {
          "id": "explicit",
          "label": "Explicit model $P(t)$",
          "inputProfile": "equation",
          "expected": "P={{p0}}({{factor}})^t"
        },
        {
          "id": "initial",
          "label": "Recursive initial condition",
          "inputProfile": "equation",
          "expected": "P_0={{p0}}"
        },
        {
          "id": "recursive",
          "label": "Recursive step",
          "inputProfile": "equation",
          "expected": "P_n={{factor}}P_(n-1)"
        }
      ],
      "solutionReview": {
        "headline": "The same multiplicative factor appears in both explicit and recursive exponential models.",
        "reasoning": [
          "{{pct}}% growth means retain 100% and add {{pct}}%, giving factor {{factor}}.",
          "The explicit model multiplies by that factor t times.",
          "The recursive model starts at {{p0}} and multiplies each new term by {{factor}}."
        ],
        "answerSummary": "$P={{p0}}({{factor}})^t$; $P_0={{p0}},\\;P_n={{factor}}P_{n-1}$"
      },
      "attemptFeedback": [
        "Do not use the percent itself as the base; convert the percent change to the full multiplicative growth factor."
      ],
      "supportHints": [
        "For r% growth, the factor is $1+r/100$."
      ],
      "generator": {
        "parameters": {
          "p0": {
            "type": "int",
            "min": 80,
            "max": 500,
            "step": 20
          },
          "pct": {
            "type": "choice",
            "values": [
              5,
              10,
              15,
              20,
              25
            ]
          }
        },
        "derived": {
          "factor": "1+pct/100"
        }
      }
    },
    {
