      "courseId": "algebra2",
      "familyId": "mathmaster:A2.5B:v2-logarithmic-ratio-scale-model",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.5B",
      "representation": "multipleRepresentation",
      "difficultyBand": 4,
      "dok": 3,
      "taskType": "modeling",
      "prompt": "A sound-level index L is defined as 10 times the base-10 logarithm of the ratio between measured intensity I and reference intensity {{ref}}. Formulate the logarithmic model for L in terms of I.",
      "stimulus": {
        "kind": "table",
        "title": "Log-scale definition",
        "table": {
          "headers": [
            "Quantity",
            "Meaning"
          ],
          "rows": [
            [
              "I",
              "measured intensity"
            ],
            [
              "{{ref}}",
              "reference intensity"
            ],
            [
              "L",
              "10 × log base 10 of the intensity ratio"
            ]
          ]
        }
      },
      "responseFields": [
        {
          "id": "ratio",
          "label": "Dimensionless intensity ratio",
          "inputProfile": "expression",
          "expected": "I/{{ref}}"
        },
        {
          "id": "model",
          "label": "Logarithmic model",
          "inputProfile": "equation",
          "expected": "L=10log_10(I/{{ref}})"
        },
        {
          "id": "domain",
          "label": "Physical input restriction",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "positive",
              "label": "I must be positive"
            },
            {
              "id": "all",
              "label": "Any real I is allowed"
            },
            {
              "id": "negative",
              "label": "I must be negative"
            }
          ],
          "expected": "positive"
        }
      ],
      "solutionReview": {
        "headline": "A logarithmic measurement scale models multiplicative ratios.",
        "reasoning": [
          "The measured quantity must first be compared with the reference, giving I/{{ref}}.",
          "The model applies base-10 logarithm to that ratio and scales the result by 10.",
          "A physical intensity and the logarithm's input must both be positive."
        ],
        "answerSummary": "$L=10\\log_{10}(I/{{ref}})$ with $I>0$."
      },
      "attemptFeedback": [
        "The logarithm is applied to the ratio I/reference, not to I and the reference separately."
      ],
      "supportHints": [
        "Translate the verbal definition in order: ratio first, log base 10 second, multiply by 10 last."
      ],
      "generator": {
        "parameters": {
          "ref": {
            "type": "choice",
            "values": [
              1,
              2,
              5,
              10
            ]
          }
        }
      }
    },
