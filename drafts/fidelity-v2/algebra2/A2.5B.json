            ],
            [
              "3",
              "{{a3}}"
            ]
          ]
        }
      },
      "responseFields": [
        {
          "id": "ratio",
          "label": "Common multiplier",
          "inputProfile": "number",
          "expected": "{{r}}"
        },
        {
          "id": "explicit",
          "label": "Explicit model",
          "inputProfile": "equation",
          "expected": "a_n={{a0}}({{r}})^n"
        },
        {
          "id": "initial",
          "label": "Recursive initial condition",
          "inputProfile": "equation",
          "expected": "a_0={{a0}}"
        },
        {
          "id": "recursive",
          "label": "Recursive step",
          "inputProfile": "equation",
          "expected": "a_n={{r}}a_(n-1)"
        }
      ],
      "solutionReview": {
        "headline": "A constant ratio in a table determines both forms of the exponential relationship.",
        "reasoning": [
          "Each output is {{r}} times the previous output.",
          "Starting at a_0={{a0}}, the explicit rule is $a_n={{a0}}({{r}})^n$.",
          "The recursive rule says each term is {{r}} times the preceding term."
        ],
        "answerSummary": "Ratio {{r}}; $a_n={{a0}}({{r}})^n$; $a_0={{a0}},\\;a_n={{r}}a_{n-1}$"
      },
      "attemptFeedback": [
        "Use ratios of consecutive outputs, not differences, to identify the exponential multiplier."
      ],
      "supportHints": [
        "Compute $a_1/a_0$ and verify the same ratio repeats."
      ],
      "generator": {
        "parameters": {
