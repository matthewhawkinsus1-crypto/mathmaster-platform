      "assessedConstruct": "A2.5B",
      "representation": "table",
      "difficultyBand": 3,
      "dok": 3,
      "taskType": "representationTranslation",
      "prompt": "The table shows an exponential relationship. Infer the common multiplier from the data, then formulate both the explicit rule and the recursive rule.",
      "stimulus": {
        "kind": "table",
        "title": "Exponential data",
        "table": {
          "headers": [
            "n",
            "a_n"
          ],
          "rows": [
            [
              "0",
              "{{a0}}"
            ],
            [
              "1",
              "{{a1}}"
            ],
            [
              "2",
