      "representation": "symbolic",
      "difficultyBand": 3,
      "dok": 2,
      "taskType": "interpretation",
      "prompt": "Compared with $y=\\sqrt{x}$, determine ALL major graph effects of $g(x)={{a}}\\sqrt{{{b}}(x-({{h}}))}{{k|signed}}$. Use the transformation model $a\\sqrt{b(x-h)}+k$.",
      "responseFields": [
        {
          "id": "vertical-scale",
          "label": "Vertical scale factor $|a|$",
          "inputProfile": "number",
          "expected": "{{verticalScale}}"
        },
        {
          "id": "horizontal-scale",
          "label": "Horizontal scale factor $1/|b|$",
          "inputProfile": "number",
          "expected": "{{horizontalScale}}"
        },
        {
          "id": "x-reflection",
          "label": "Reflection across the x-axis?",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "yes",
              "label": "Yes"
            },
            {
              "id": "no",
              "label": "No"
            }
          ],
          "expected": "yes"
        },
        {
          "id": "horizontal-reflection",
          "label": "Horizontal reflection (across the parent y-axis before translation)?",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "yes",
              "label": "Yes"
            },
            {
              "id": "no",
              "label": "No"
            }
          ],
          "expected": "no"
        },
        {
          "id": "endpoint",
          "label": "Transformed endpoint",
          "inputProfile": "orderedPair",
          "expected": "({{h}},{{k}})"
        },
        {
          "id": "ray",
          "label": "Direction the square-root ray extends from the endpoint",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "right",
              "label": "Right"
            },
            {
              "id": "left",
              "label": "Left"
            }
          ],
          "expected": "right"
        }
      ],
      "solutionReview": {
        "headline": "Outside parameters change outputs; inside parameters change inputs.",
        "reasoning": [
          "$|a|={{verticalScale}}$ gives the vertical scale and a<0 reflects across the x-axis.",
          "$1/|b|={{horizontalScale}}$ gives the horizontal scale. Here b>0, so there is no horizontal reflection and the domain extends right from the endpoint.",
          "The translations move the parent endpoint to $({{h}},{{k}})$."
        ],
        "answerSummary": "Vertical factor {{verticalScale}}, horizontal factor {{horizontalScale}}, x-axis reflection, no horizontal reflection, endpoint $({{h}},{{k}})$, ray right."
      },
      "attemptFeedback": [
        "Do not use |b| itself as the horizontal scale factor; inside scaling acts reciprocally."
      ],
      "supportHints": [
        "Outside negative → x-axis reflection. Inside negative → horizontal reflection. Horizontal scale is 1/|b|."
      ],
