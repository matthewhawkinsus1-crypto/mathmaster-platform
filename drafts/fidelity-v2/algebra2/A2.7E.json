      "prompt": "Factor $x^4+{{c}}x^3-{{n3}}x-{{cn3}}$ completely. First factor the quartic by grouping, then factor the remaining difference of cubes. Report the two linear factors and the quadratic factor.",
      "responseFields": [
        {
          "id": "group-factor",
          "label": "Common binomial from grouping",
          "inputProfile": "expression",
          "expected": "x+{{c}}"
        },
        {
          "id": "cubic-after-grouping",
          "label": "Other factor after grouping",
