        {
          "id": "behavior",
          "label": "Overall behavior for base > 1",
          "kind": "text",
          "responseMode": "text",
          "expected": [
            "decreasing"
          ]
        }
      ],
      "solutionReview": {
        "headline": "A negative outside scale reflects the exponential across the x-axis before translation.",
        "reasoning": [
          "The magnitude |a|={{scale}} vertically scales distances from the translated asymptote.",
          "Because a<0 and base>1, the graph is decreasing and lies below the horizontal asymptote $y={{k}}$.",
          "Horizontal translation moves the reference x-location to h={{h}}; vertical translation moves the asymptote to y={{k}}."
        ],
        "answerSummary": "Asymptote $y={{k}}$, domain all real, range $(-\\infty,{{k}})$, decreasing."
      },
      "attemptFeedback": [
        "Use the sign of a to decide the reflection/range direction and k to locate the horizontal asymptote."
      ],
      "supportHints": [
        "At x=h, the exponent is 0, so the transformed anchor is $(h,a+k)$."
      ],
      "generator": {
        "parameters": {
          "scale": {
            "type": "int",
