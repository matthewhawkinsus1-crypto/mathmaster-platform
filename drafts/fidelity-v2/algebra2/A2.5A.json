            "{{yleft}}"
          ]
        },
        {
          "id": "anchor",
          "label": "Plot the transformed reference point at x=h",
          "x": "{{h}}",
          "expected": [
            "{{h}}",
            "{{yanchor}}"
          ]
        },
        {
          "id": "right",
          "label": "Plot one unit right of x=h",
          "x": "{{hp1}}",
          "expected": [
            "{{hp1}}",
            "{{yright}}"
          ]
        }
      ],
      "analysisRequests": [
        {
          "id": "hasym",
          "label": "Horizontal asymptote y-value",
          "kind": "value",
          "responseMode": "text",
          "expected": [
            "{{k}}"
          ]
        },
        {
          "id": "domain",
          "label": "Domain",
          "kind": "domain",
          "notation": "interval",
          "responseMode": "text",
          "expected": [
            "(-∞,∞)",
            "all real numbers"
          ]
        },
        {
          "id": "range",
          "label": "Range",
          "kind": "range",
          "notation": "interval",
          "responseMode": "text",
          "expected": [
            "(-∞,{{k}})"
          ]
