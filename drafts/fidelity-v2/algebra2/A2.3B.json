          "id": "z",
          "label": "z",
          "inputProfile": "number",
          "expected": "{{z}}"
        }
      ],
      "solutionReview": {
        "headline": "Substitution uses a known variable to reduce the system one equation at a time.",
        "reasoning": [
          "Start with $z={{z}}$ and substitute into $y+z={{b}}$ to get $y={{y}}$.",
          "Then substitute both known values into $x+2y-z={{c}}$ to get $x={{x}}$."
        ],
        "answerSummary": "$(x,y,z)=({{x}},{{y}},{{z}})$"
      },
      "attemptFeedback": [
        "Do not skip the substitution equations; this family is measuring the substitution method as well as the final triple."
