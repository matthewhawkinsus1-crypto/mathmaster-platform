          "id": "real-part",
          "label": "Resulting real part",
          "inputProfile": "number",
          "expected": "0"
        },
        {
          "id": "imag-coefficient",
          "label": "Resulting imaginary coefficient",
          "inputProfile": "number",
          "expected": "{{im}}"
