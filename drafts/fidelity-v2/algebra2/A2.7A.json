          "id": "answer",
          "label": "Simplified complex number",
          "inputProfile": "expression",
          "expected": "{{re}}+({{im}})*i"
        }
      ],
      "solutionReview": {
        "headline": "Add like components of complex numbers.",
        "reasoning": [
          "Real parts: {{a}}+{{c}}={{re}}.",
          "Imaginary coefficients: {{b}}+{{d}}={{im}}.",
          "The result is {{re}}+({{im}})i."
        ],
        "answerSummary": "${{re}}+({{im}})i$"
      },
      "attemptFeedback": [
        "Combine real with real and imaginary coefficient with imaginary coefficient before writing standard form."
      ],
