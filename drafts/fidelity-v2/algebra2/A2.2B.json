        "requireInverseSketch": true,
        "requireInverseEquation": true,
        "expectedEquation": "f^-1(x)=(x-({{b}}))/{{m}}",
        "equationLabel": "Write the equation of the inverse using inverse-function notation.",
        "inverseLineLabel": "Draw the inverse graph through the reflected points."
      },
      "solutionReview": {
        "headline": "An inverse swaps every input-output pair.",
        "reasoning": [
          "Reflecting across $y=x$ sends each point $(x,y)$ on $f$ to $(y,x)$ on $f^{-1}$.",
          "Swapping $x$ and $y$ in the linear equation and isolating $y$ gives the inverse equation."
        ],
        "answerSummary": "$f^{-1}(x)=\\frac{x-({{b}})}{{{m}}}$"
      },
      "attemptFeedback": [
        "Use the same two source points for the reflection; do not take a reciprocal of the original equation."
      ],
      "supportHints": [
        "An inverse reflection swaps the coordinates of every point."
      ],
      "generator": {
        "parameters": {
          "m": {
