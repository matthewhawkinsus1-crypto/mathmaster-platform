{
  "standard": "A2.2D",
  "verdict": "REBUILD",
  "certificationStatus": "candidate-two-direction-composition-inverse-determination-with-domain-restrictions",
  "rationale": "A2.2D requires composition to be the evidence used to decide whether two functions are inverses, with domain restrictions handled when needed. Fidelity V2 therefore makes one- or two-direction compositions, inverse conclusions, and restriction reasoning part of the graded response rather than treating composition as an unrelated calculation.",
  "documents": [
    {
      "id": "mm_A2_2D_v2_linear-two-way-proof",
      "active": true,
      "alignmentKeys": [
        "texas:A2.2D"
      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.2D:v2-linear-two-way-proof",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.2D",
      "representation": "symbolic",
      "difficultyBand": 2,
      "dok": 2,
      "taskType": "interpretation",
      "prompt": "Use composition in BOTH directions to determine whether $f(x)={{a}}x{{b|signed}}$ and $g(x)=\\frac{x-({{b}})}{{{a}}}$ are inverse functions.",
      "responseFields": [
        {
          "id": "fog",
          "label": "Simplify $f(g(x))$",
          "inputProfile": "expression",
          "expected": "x"
        },
        {
          "id": "gof",
          "label": "Simplify $g(f(x))$",
          "inputProfile": "expression",
          "expected": "x"
        },
        {
          "id": "conclusion",
          "label": "Conclusion",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "yes",
              "label": "Yes. Both composition orders return the original input."
            },
            {
              "id": "no-one-way",
              "label": "No. Only one composition order returns the original input."
            },
            {
              "id": "no-reciprocal",
              "label": "No. Inverse functions must be reciprocals."
            }
          ],
          "expected": "yes"
        }
      ],
      "solutionReview": {
        "headline": "A two-sided composition check verifies the inverse relationship.",
        "reasoning": [
          "Substituting $g(x)$ into $f$ cancels the division by {{a}} and the shift {{b|signed}}, so $f(g(x))=x$.",
          "Substituting $f(x)$ into $g$ reverses the same scale and shift, so $g(f(x))=x$.",
          "Because both compositions return the original input on their domains, the functions are inverses."
        ],
        "answerSummary": "$f(g(x))=x$ and $g(f(x))=x$; yes, the functions are inverses."
      },
      "attemptFeedback": [
        "An inverse conclusion needs the composition evidence, not just similar-looking formulas."
      ],
      "supportHints": [
        "Work from the inside function outward in each composition order."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "choice",
            "values": [
              -5,
              -4,
              -3,
              -2,
              2,
              3,
              4,
              5
            ]
          },
          "b": {
            "type": "int",
            "min": -9,
            "max": 9
          }
        }
      }
    },
    {
      "id": "mm_A2_2D_v2_table-counterexample",
      "active": true,
      "alignmentKeys": [
        "texas:A2.2D"
      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.2D:v2-table-counterexample",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.2D",
      "representation": "table",
      "difficultyBand": 3,
      "dok": 2,
      "taskType": "interpretation",
      "prompt": "Use the tables to evaluate the two composition orders at $x={{t}}$. Decide whether the proposed functions can be inverses.",
      "stimulus": {
        "kind": "table",
        "title": "Values needed for the composition check",
        "table": {
          "headers": [
            "Function",
            "Input",
            "Output"
          ],
          "rows": [
            [
              "$g$",
              "{{t}}",
              "{{gt}}"
            ],
            [
              "$f$",
              "{{gt}}",
              "{{fog}}"
            ],
            [
              "$f$",
              "{{t}}",
              "{{ft}}"
            ],
            [
              "$g$",
              "{{ft}}",
              "{{gof}}"
            ]
          ]
        },
        "note": "For inverse functions, both $f(g(x))$ and $g(f(x))$ must return the starting input wherever the compositions are defined."
      },
      "responseFields": [
        {
          "id": "fog",
          "label": "$f(g({{t}}))$",
          "inputProfile": "number",
          "expected": "{{fog}}"
        },
        {
          "id": "gof",
          "label": "$g(f({{t}}))$",
          "inputProfile": "number",
          "expected": "{{gof}}"
        },
        {
          "id": "conclusion",
          "label": "What does this composition evidence prove?",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "not-inverse",
              "label": "They are not inverses because at least one composition does not return {{t}}."
            },
            {
              "id": "inverse",
              "label": "They are inverses because both functions are linear."
            },
            {
              "id": "unknown",
              "label": "Composition cannot be used to test inverses."
            }
          ],
          "expected": "not-inverse"
        }
      ],
      "solutionReview": {
        "headline": "One counterexample is enough to disprove an inverse claim.",
        "reasoning": [
          "The table gives $f(g({{t}}))={{fog}}$ and $g(f({{t}}))={{gof}}$.",
          "The starting input was {{t}}. Since the composition does not return that input, the proposed pair cannot be inverse functions."
        ],
        "answerSummary": "The functions are not inverses."
      },
      "attemptFeedback": [
        "Follow the output of the inside function into the outside function, then compare with the starting input."
      ],
      "supportHints": [
        "If a composition returns something other than the original x, the inverse claim fails."
      ],
      "generator": {
        "parameters": {
          "a": {
            "type": "choice",
            "values": [
              -4,
              -3,
              -2,
              2,
              3,
              4
            ]
          },
          "b": {
            "type": "int",
            "min": -6,
            "max": 6
          },
          "d": {
            "type": "choice",
            "values": [
              -3,
              -2,
              -1,
              1,
              2,
              3
            ]
          },
          "t": {
            "type": "int",
            "min": -4,
            "max": 4
          }
        },
        "derived": {
          "gt": "(t-b)/a+d",
          "fog": "a*gt+b",
          "ft": "a*t+b",
          "gof": "(ft-b)/a+d"
        }
      }
