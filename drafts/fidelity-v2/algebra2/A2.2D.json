    {
      "id": "mm_A2_2D_v2_right-quadratic-root-composition",
      "active": true,
      "alignmentKeys": [
        "texas:A2.2D"
      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.2D:v2-right-quadratic-root-composition",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.2D",
      "representation": "multipleRepresentation",
      "difficultyBand": 4,
      "dok": 3,
      "taskType": "reverseReasoning",
      "prompt": "Let $f(x)=(x-({{h}}))^2{{k|signed}}$ and $g(x)=\\sqrt{x-({{k}})}+{{h}}$. Use composition and the needed domain restrictions to determine whether they are inverses.",
      "stimulus": {
        "kind": "expressions",
        "title": "Proposed inverse pair",
        "expressions": [
          "$f(x)=(x-({{h}}))^2{{k|signed}}$",
          "$g(x)=\\sqrt{x-({{k}})}+{{h}}$",
          "$g(f(x))=\\sqrt{(x-({{h}}))^2}+{{h}}$"
        ]
      },
      "responseFields": [
        {
          "id": "fog",
          "label": "On the domain of $g$, simplify $f(g(x))$",
          "inputProfile": "expression",
          "expected": "x"
        },
        {
          "id": "gof",
          "label": "After the correct restriction on $f$, simplify $g(f(x))$",
          "inputProfile": "expression",
          "expected": "x"
        },
        {
          "id": "f-domain",
          "label": "Required domain restriction on $f$",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "right",
              "label": "$x\\ge {{h}}$"
            },
            {
              "id": "left",
              "label": "$x\\le {{h}}$"
            },
            {
              "id": "all",
              "label": "All real x"
            }
          ],
          "expected": "right"
        },
        {
          "id": "g-domain",
          "label": "Domain required for $f(g(x))$",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "from-k",
              "label": "$x\\ge {{k}}$"
            },
            {
              "id": "from-h",
              "label": "$x\\ge {{h}}$"
            },
            {
              "id": "all",
              "label": "All real x"
            }
          ],
          "expected": "from-k"
        },
        {
          "id": "conclusion",
          "label": "Conclusion",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "yes-restricted",
              "label": "Yes, with the stated right-branch restriction on $f$."
            },
            {
              "id": "yes-all",
              "label": "Yes, with no restriction on the quadratic."
            },
            {
              "id": "no",
              "label": "No restriction can make this pair inverse."
            }
          ],
          "expected": "yes-restricted"
        }
      ],
      "solutionReview": {
        "headline": "The principal square root reverses only the right branch of the quadratic.",
        "reasoning": [
          "$f(g(x))=x$ where the square root is defined, so that composition uses $x\\ge {{k}}$.",
          "$g(f(x))=\\sqrt{(x-({{h}}))^2}+{{h}}=|x-{{h}}|+{{h}}$.",
          "Restricting $f$ to $x\\ge {{h}}$ makes $|x-{{h}}|=x-{{h}}$, so the reverse composition also becomes x."
        ],
        "answerSummary": "They are inverses when $f$ is restricted to $x\\ge {{h}}$."
      },
      "attemptFeedback": [
        "The absolute value created by the square root of a square determines which quadratic branch is valid."
      ],
      "supportHints": [
        "For the principal square root, $\\sqrt{u^2}=|u|$."
      ],
      "generator": {
        "parameters": {
          "h": {
            "type": "int",
            "min": -5,
            "max": 5
          },
          "k": {
            "type": "int",
            "min": -5,
            "max": 5
          }
        }
      }
    },
    {
