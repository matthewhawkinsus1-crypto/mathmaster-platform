      ],
      "courseId": "algebra2",
      "familyId": "mathmaster:A2.2D:v2-unrestricted-quadratic-error-analysis",
      "familyVersion": 3,
      "questionType": "response",
      "activityRole": "practice",
      "calculatorPolicy": "inherit",
      "assessedConstruct": "A2.2D",
      "representation": "verbal",
      "difficultyBand": 5,
      "dok": 3,
      "taskType": "errorAnalysis",
      "prompt": "A student claims $f(x)=(x-({{h}}))^2{{k|signed}}$ on all real x and $g(x)=\\sqrt{x-({{k}})}+{{h}}$ are inverses because $f(g(x))=x$. Analyze the claim using the other composition.",
      "stimulus": {
        "kind": "steps",
        "title": "Student's inverse check",
        "steps": [
          {
            "id": "s1",
            "label": "Step 1",
            "work": "Compute $f(g(x))$ and get x where $g$ is defined."
          },
          {
            "id": "s2",
            "label": "Step 2",
            "work": "Stop after one composition and declare the functions inverses."
          },
          {
            "id": "s3",
            "label": "Missing check",
            "work": "$g(f(x))=\\sqrt{(x-({{h}}))^2}+{{h}}$"
          }
        ],
        "note": "Use the generated input $x={{testX}}$, which lies left of the vertex, to test the missing composition."
      },
      "responseFields": [
        {
          "id": "simplify",
          "label": "Simplify $g(f(x))$ before imposing a branch restriction",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "absolute",
              "label": "$|x-{{h}}|+{{h}}$"
            },
            {
              "id": "always-x",
              "label": "$x$ for every real x"
            },
            {
              "id": "reciprocal",
              "label": "$1/x$"
            }
          ],
          "expected": "absolute"
        },
        {
          "id": "counterexample",
          "label": "Evaluate $g(f({{testX}}))$",
          "inputProfile": "number",
          "expected": "{{composition}}"
        },
        {
          "id": "diagnosis",
          "label": "Diagnosis",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "fails",
              "label": "The inverse claim fails on all real x because the second composition does not always return the original input."
            },
            {
              "id": "works",
              "label": "The first composition is enough to prove the functions are inverses."
            },
            {
              "id": "reciprocal",
              "label": "The only problem is that g should be the reciprocal of f."
            }
          ],
          "expected": "fails"
        },
        {
          "id": "repair",
          "label": "Restriction that repairs the principal-root inverse pair",
          "inputProfile": "choice",
          "choices": [
            {
              "id": "right",
              "label": "Restrict $f$ to $x\\ge {{h}}$."
            },
            {
              "id": "left",
              "label": "Restrict $f$ to $x\\le {{h}}$ without changing g."
            },
            {
              "id": "none",
              "label": "No restriction is needed."
            }
          ],
          "expected": "right"
        }
      ],
      "solutionReview": {
        "headline": "Both composition orders matter, and domain restrictions can be essential.",
        "reasoning": [
          "$g(f(x))=\\sqrt{(x-({{h}}))^2}+{{h}}=|x-{{h}}|+{{h}}$.",
          "At $x={{testX}}$, that composition gives {{composition}}, not {{testX}}, so the all-real inverse claim is false.",
          "Restricting the quadratic to $x\\ge {{h}}$ makes the principal square root undo that branch."
        ],
        "answerSummary": "The unrestricted pair is not inverse; restrict $f$ to $x\\ge {{h}}$."
      },
      "attemptFeedback": [
        "A single successful composition does not justify an inverse claim when the other direction can fail."
      ],
      "supportHints": [
        "Test $g(f(x))$ and remember that $\\sqrt{u^2}=|u|$."
      ],
