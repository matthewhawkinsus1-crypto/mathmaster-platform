      "taskType": "reverseReasoning",
      "prompt": "Solve $(x-({{h}}))^(2/3)={{r2}}$ over the real numbers. Do not lose the negative cube-root branch. Give both solutions from least to greatest and the complete solution set.",
      "stimulus": {
        "kind": "table",
        "title": "Equivalent substitution",
        "table": {
          "headers": [
            "Let",
            "Then"
          ],
          "rows": [
            [
              "u=(x-({{h}}))^(1/3)",
              "u²={{r2}}"
            ]
          ]
        }
      },
      "responseFields": [
        {
          "id": "u-low",
          "label": "Smaller value of u",
          "inputProfile": "number",
          "expected": "{{negR}}"
