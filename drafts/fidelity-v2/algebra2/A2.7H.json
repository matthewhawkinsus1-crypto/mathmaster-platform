      "solutionReview": {
        "headline": "An even numerator can create two real branches even when the root index is odd.",
        "reasoning": [
          "Let u=(x-({{h}}))^(1/3). Then u²={{r2}}, so u=±{{r}}.",
          "Cubing gives x-({{h}})=±{{r3}}.",
          "Therefore x={{xlow}} or x={{xhigh}}."
        ],
        "answerSummary": "$x={{xlow}},{{xhigh}}$"
      },
      "attemptFeedback": [
        "After reaching u²={{r2}}, include both positive and negative square-root possibilities."
      ],
      "supportHints": [
        "The cube-root substitution is defined for every real x, so both u branches can be valid."
