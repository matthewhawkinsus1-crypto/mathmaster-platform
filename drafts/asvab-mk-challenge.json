   "prompt": "How many multiples of ${{m}}$ lie strictly between $-{{a}}$ and ${{b}}$?",
   "solutionReview": {
    "headline": "Zero is a multiple of every number and sits inside the range.",
    "reasoning": [
     "The multiples run from $-{{a}}+{{m}}$ up to ${{b}}-{{m}}$, and zero is one of them.",
     "That is ${{ka}}+{{kb}}-1={{answer}}$ values."
    ],
    "answerSummary": "There are ${{answer}}$."
   },
   "attemptFeedback": [
    "The range does not reach as far below zero as it does above, or the other way round."
   ],
   "supportHints": [
    "Count the multiples on each side of zero, then zero itself."
   ],
   "generator": {
    "parameters": {
     "m": {
      "type": "int",
      "min": 2,
      "max": 6
     },
     "ka": {
      "type": "int",
      "min": 2,
      "max": 8
     },
     "kb": {
      "type": "int",
      "min": 2,
      "max": 8
     }
    },
    "derived": {
     "a": "m*ka",
     "b": "m*kb",
     "answer": "ka+kb-1",
     "d_signError": "2*kb-1",
     "d_partialTotal": "kb-1",
     "d_wrongPercentBase": "a+b-1"
    },
    "constraints": [
