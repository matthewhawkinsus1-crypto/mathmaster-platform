   "prompt": "Doubling a number and adding ${{b}}$ gives ${{result}}$. What is the number?",
   "solutionReview": {
    "headline": "Undo the addition before undoing the doubling.",
    "reasoning": [
     "Taking ${{b}}$ off ${{result}}$ leaves twice the number.",
     "Halving that gives ${{answer}}$."
    ],
    "answerSummary": "The number is ${{answer}}$."
   },
   "attemptFeedback": [
    "Halving before removing the addition halves part of the wrong quantity."
   ],
   "supportHints": [
    "The addition happened last, so it comes off first."
   ],
