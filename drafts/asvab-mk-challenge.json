   "prompt": "Which statement is true of every rational number?",
   "solutionReview": {
    "headline": "Rational means expressible as a ratio of integers.",
    "reasoning": [
     "A rational number is by definition a ratio of two integers with a non-zero denominator.",
     "The other statements each fail for a value such as $\\frac{1}{{{n}}}$."
    ],
    "answerSummary": "It is a ratio of two integers."
   },
   "attemptFeedback": [
    "A non-repeating, non-terminating decimal is irrational, not rational."
   ],
   "supportHints": [
    "Test each claim against a simple fraction."
   ],
