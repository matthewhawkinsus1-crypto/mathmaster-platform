   "prompt": "A {{vehicle}} uses {{g1}} gallons of fuel to travel {{m1}} miles. At that rate, how many gallons are needed to travel {{m2}} miles?",
   "solutionReview": {
    "headline": "Find what one gallon covers, then share the new distance into it.",
    "reasoning": [
     "{{m1}} miles on {{g1}} gallons is {{mpg}} miles per gallon.",
     "{{m2}} divided by {{mpg}} is {{answer}}."
    ],
    "answerSummary": "It takes ${{answer}}$ gallons."
   },
   "attemptFeedback": [
    "Check which distance goes with which amount of fuel."
   ],
   "supportHints": [
    "Work out how far the {{vehicle}} goes on a single gallon first."
   ],
