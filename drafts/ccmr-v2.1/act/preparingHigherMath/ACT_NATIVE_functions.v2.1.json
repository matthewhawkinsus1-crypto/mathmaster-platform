ersion":"2.1","authored":true,"nativeSkillId":"functions","officialSkillFamily":"functions","stemProfile":"logarithmic-value","answerChoiceCount":4},"prompt":"If $\\log_{{{b}}}{{x}}=n$, what is the value of $n$?","generator":{"parameters":{"b":{"type":"int","min":2,"max":5},"n":{"type":"int","min":2,"max":5}},"derived":{"x":"b^n","answer":"n","d1":"b*n","d2":"x","d3":"n+1"},"constraints":["answer!=d1","answer!=d2","answer!=d3","d1!=d2","d1!=d3","d2!=d3"]},"assessmentItemFormat":"multipleChoice","choices":[{"id":"act-correct","label":"${{answer}}$"},{"id":"act-d1","label":"${{d1}}$"},{"id":"act-d2","label":"${{d2}}$"},{"id":"act-d3","label":"${{d3}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"act-correct"}],"attemptFeedback":["Use the function definition, representation, or transformation in the question to determine the requested value or feature."],"supportHints":["Track which input is being used and how the function rule or graph feature changes."],"solutionReview":{"headline":"A logarithm is an exponent: $n={{answer}}$.","reasoning":["$\\log_{ {{b}} }{{x}}=n$ means ${{b}}^n={{x}}$.","${{b}}^{ {{n}} }={{x}}$, so $n={{answer}}$."],"commonError":"Multiplying the base by the exponent instead of raising it to the power.","answerSummary":"$n={{answer}}$"}},{"id":"mm_act_fn_ch1_composition_v21","active":true,"alignmentKeys":[],"alignments":[{"framework":"act","domainId":"preparingHigherMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"act","examStyle":true,"domainId":"preparingHigherMath","nativeSkillId":"functions","actSubcategory":"functions","modeling":false},"familyId":"mathmaster:act:native:functions:challenge-composition","familyVersion":1,"questionType":"response","activityRole":"practice","difficultyBand":4,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"ACT-native:functions","taskType":"functionComposition","representation":"symbolic","ccmrChallengeTier"