      "prompt": "For the positive integer {{p}}, which of the following numbers is irrational?",
      "generator": {
        "parameters": {
          "p": {
            "type": "choice",
            "values": [
              2,
              3,
              5,
              7,
              11,
              13
            ]
          }
        }
      },
      "assessmentItemFormat": "multipleChoice",
      "choices": [
        {
          "id": "act-correct",
          "label": "$\\sqrt{{{p}}}$"
        },
        {
          "id": "act-d1",
          "label": "$\\dfrac{{{p}}}{2}$"
        },
        {
          "id": "act-d2",
          "label": "${{p}}$"
        },
        {
          "id": "act-d3",
          "label": "$0.125$"
        }
      ],
      "responseFields": [
        {
          "id": "answer",
          "label": "Choose the correct answer",
          "inputProfile": "choice",
          "expected": "act-correct"
        }
      ],
      "attemptFeedback": [
        "Use the stated numerical relationships and operations to determine the requested quantity."
      ],
      "supportHints": [
        "Track signs, exponents, units, and matrix or vector positions carefully."
      ],
      "solutionReview": {
        "headline": "{{p}} is not a perfect square, so $\\sqrt{{{p}}}$ is irrational.",
        "reasoning": [
          "A rational number is a ratio of integers. ${{p}}$ and $\\frac{ {{p}} }{2}$ are already ratios of integers, and $0.125=\\frac{1}{8}$.",
          "The square root of a positive integer is rational only when the integer is a perfect square, and {{p}} is not one.",
          "So $\\sqrt{{{p}}}$ is the irrational number."
        ],
        "commonError": "Thinking a fraction or a terminating decimal is irrational because it is not a whole number.",
        "answerSummary": "$\\sqrt{{{p}}}$"
      }
