","choices":[{"id":"act-correct","label":"${{answer}}$"},{"id":"act-d1","label":"${{d1}}$"},{"id":"act-d2","label":"${{d2}}$"},{"id":"act-d3","label":"${{d3}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"act-correct"}]},{"id":"mm_act_geo_ch3_similar-area-scale_v21","active":true,"alignmentKeys":[],"alignments":[{"framework":"act","domainId":"preparingHigherMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"act","examStyle":true,"domainId":"preparingHigherMath","nativeSkillId":"geometry","actSubcategory":"geometry","modeling":false},"familyId":"mathmaster:act:native:geometry:challenge-similar-area-scale","familyVersion":1,"questionType":"response","activityRole":"practice","difficultyBand":5,"dok":3,"calculatorPolicy":"graphing","assessedConstruct":"ACT-native:geometry","taskType":"similarityArea","representation":"triangles","ccmrChallengeTier":2,"ccmrFamilyRole":"challenge","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"nativeSkillId":"geometry","officialSkillFamily":"geometry","stemProfile":"challenge-similar-area-scale","answerChoiceCount":4,"authoredChallenge":true},"attemptFeedback":["Use the geometric relationships and measurements in the question to determine the requested value."],"supportHints":["Identify the relevant length, angle, area, volume, coordinate, or conic relationship before calculating."],"solutionReview":{"headline":"Areas scale by the square of the side ratio: {{answer}}.","reasoning":["Side ratio: $\\frac{ {{bigside}} }{ {{s}} }={{k}}$.","Area grows by the square of that ratio: ${{A}}\\cdot {{k}}^2={{answer}}$."],"commonError":"Multiplying the area by the side ratio only once.","answerSummary":"${{answer}}$"},"prompt":"Two similar triangles have corresponding side lengths {{s}} and {{bigside}}. If the smaller triangle has area {{A}}, what is the area of the larger triangle?","generator":{"parameters":{"s":{"type":"int","min":3,"max":8},