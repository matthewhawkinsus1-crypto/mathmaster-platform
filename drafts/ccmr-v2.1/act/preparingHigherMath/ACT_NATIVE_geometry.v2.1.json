nt?","generator":{"parameters":{"x1":{"type":"int","min":-8,"max":6},"y1":{"type":"int","min":-8,"max":6},"dx":{"type":"int","min":2,"max":8},"dy":{"type":"int","min":2,"max":8}},"derived":{"x2":"x1+2*dx","y2":"y1+2*dy","mx":"x1+dx","my":"y1+dy","xsum":"x1+x2","ysum":"y1+y2"},"constraints":["x1!=-dx","x2!=0"]},"assessmentItemFormat":"multipleChoice","choices":[{"id":"act-correct","label":"$({{mx}},{{my}})$"},{"id":"act-d1","label":"$({{xsum}},{{ysum}})$"},{"id":"act-d2","label":"$({{mx}},{{y1}})$"},{"id":"act-d3","label":"$({{x1}},{{my}})$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"act-correct"}]},{"id":"mm_act_geo_3_ellipse-vertex_v21","active":true,"alignmentKeys":[],"alignments":[{"framework":"act","domainId":"preparingHigherMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"act","examStyle":true,"domainId":"preparingHigherMath","nativeSkillId":"geometry","actSubcategory":"geometry","modeling":false},"familyId":"mathmaster:act:native:geometry:ellipse-vertex","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"ACT-native:geometry","taskType":"conicSection","representation":"equation","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"nativeSkillId":"geometry","officialSkillFamily":"geometry","stemProfile":"ellipse-vertex","answerChoiceCount":4},"attemptFeedback":["Use the geometric relationships and measurements in the question to determine the requested value."],"supportHints":["Identify the relevant length, angle, area, volume, coordinate, or conic relationship before calculating."],"solutionReview":{"headline":"The major axis is horizontal; go $a={{a}}$ right of the center: $({{xp}},{{k}})$.","reasoning":["The center is $({{h}},{{k}})$. The larger denominator, ${{a2}}={{a}}^2$, is under the $x$-term, so the major axis is horizontal.","Major-axis vertices are {{a}} units left and right of the center, at the same $y$-value {{k}}.","${{h}}+{{a}}={{xp}}$, so $({{xp}},{{k}})$ is a vertex."],"commonError":"Moving vertically by $b={{b}}$, which reaches an end of the minor axis instead.","answerSummary":"$({{xp}},{{k}})$"},"prompt":"The ellipse $\\dfrac{(x {{nh|signed}})^2}{{{a2}}}+\\dfrac{(y {{nk|signed}})^2}{{{b2}}}=1$ has $a>b$. Which point is a vertex on its major axis?","generator":{"parameters":{"h":{"type":"int","min":-5,"max":5},"k":{"type":"int","min":-5,"max":5},"a":{"type":"int","min":4,"max":8},"b":{"type":"int","min":2,"max":3}},"derived":{"a2":"a*a","b2":"b*b","nh":"-h","nk":"-k","xp":"h+a","xm":"h-a","yp":"k+b","ym":"k-b"},"constraints":["a>b"]},"assessmentItemFormat":"multipleChoice","choices":[{"id":"act-correct","label":"$({{xp}},{{k}})$"},{"id":"act-d1","label":"$({{h}},{{yp}})$"},{"id":"act-d2","label":"$({{xm}},{{yp}})$"},{"id":"act-d3","label":"$({{h}},{{ym}})$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"act-correct"}]},{"id":"mm_act_geo_4_cylinder-surface-area_v21","active":true,"alignmentKeys":[],"alignments":[{"framework":"act","domainId":"preparingHigherMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"act","examStyle":true,"domainId":"preparingHigherMath","nativeSkillId":"geometry","actSubcategory":"geometry","modeling":false},"familyId":"mathmaster:act:native:geometry:cylinder-surface-area","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"ACT-native:geometry","taskType":"surfaceArea","representation":"solid","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"nativeSkillId":"geometry","officialSkillFamily":"geometry","stemProfile":"cylinder-surface-area","answerChoiceCount":4},"attemptFeedback":["Use the geometric relationships and measurements in the question to determine the requested value."],"supportHints":["Identify the relevant length, angle, area, volume, coordinate, or conic relationship before calculating."],"solutionReview":{"headline":"Two circular ends plus the curved side: $n={{answer}}$.","reasoning":["Surface area $=2\\pi r^2+2\\pi rh$: two circles and the rectangle that wraps around.","Ends: $2\\cdot {{r}}^2={{tops}}$. Side: $2\\cdot {{r}}\\cdot {{h}}={{side}}$.","${{tops}}+{{side}}={{answer}}$, so the area is ${{answer}}\\pi$ and $n={{answer}}$."],"commonError":"Leaving out one or both circular ends.","answerSummary":"$n={{answer}}$"},"prompt":"A closed right circular cylinder has radius {{r}} and height {{h}}. Its total surface area is $n\\pi$. What is the value of $n$?","generator":{"parameters":{"r":{"type":"int","min":2,"max":8},"h":{"type":"int","min":3,"max":12}},"derived":{"answer":"2*r*r+2*r*h","d1":"2*r*h","d2":"r*r*h","d3":"r*r+2*r*h","tops":"2*r*r","side":"2*r*h"},"constraints":["answer!=d1","answer!=d2","answer!=d3","d1!=d2","d1!=d3","d2!=d3"]},"assessmentItemFormat":"multipleChoice","choices":[{"id":"act-correct","label":"${{answer}}$"},{"id":"act-d1","label":"${{d1}}$"},{"id":"act-d2","label":"${{d2}}$"},{"id":"act-d3","label":"${{d3}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"act-correct"}]},{"id":"mm_act_geo_5_tangent-ratio_v21","active":true,"alignmentKeys":[],"alignments":[{"framework":"act","domainId":"preparingHigherMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"act","examStyle":true,"domainId":"preparingHigherMath","nativeSkillId":"geometry","actSubcategory":"geometry","modeling":false},"familyId":"mathmaster:act:native:geometry:right-triangle-tangent","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"ACT-native:geometry","taskType":"trigonometricRatio","representation":"rightTriangle","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"nativeSkillId":"geometry","officialSkillFamily":"geometry","stemProfile":"right-triangle-tangent","answerChoiceCount":4},"attemptFeedback":["Use the geometric relationships and measurements in the question to determine the requested value."],"supportHints":["Identify the relevant length, angle, area, volume, coordinate, or conic relationship before calculating."],"solutionReview":{"headline":"Tangent is opposite over adjacent: $\\dfrac{5}{12}$.","reasoning":["$\\tan\\theta$ is the leg opposite $\\theta$ divided by the leg adjacent to it.","$\\frac{ {{opp}} }{ {{adj}} }=\\frac{5}{12}$ in lowest terms."],"commonError":"Flipping the ratio (adjacent over opposite), or using the hypotenuse.","answerSummary":"$\\tan\\theta=\\dfrac{5}{12}$"},"prompt":"In a right triangle, relative to acute angle $\\theta$, the opposite leg has length {{opp}} and the adjacent leg has length {{adj}}. What is $\\tan\\theta$?","generator":{"parameters":{"k":{"type":"int","min":1,"max":10}},"derived":{"opp":"5*k","adj":"12*k"}},"assessmentItemFormat":"multipleChoice","choices":[{"id":"act-correct","label":"$\\dfrac{5}{12}$"},{"id":"act-d1","label":"$\\dfrac{12}{5}$"},{"id":"act-d2","label":"$\\dfrac{5}{13}$"},{"id":"act-d3","label":"$\\dfrac{12}{13}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"act-correct"}]},{"id":"mm_act_geo_ch1_hollow-cylinder-volume_v21","active":true,"alignmentKeys":[],"alignments":[{"framework":"act","domainId":"preparingHigherMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"act","examStyle":true,"domainId":"preparingHigherMath","nativeSkillId":"geometry","actSubcategory":"geometry","modeling":true},"familyId":"mathmaster:act:native:geometry:challenge-hollow-cylinder-volume","familyVersion":1,"questionType":"response","activi