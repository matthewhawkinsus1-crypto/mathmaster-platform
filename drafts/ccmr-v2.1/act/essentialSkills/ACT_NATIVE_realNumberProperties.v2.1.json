)(-{{c}})={{neg}}$."],"commonError":"Treating the product as positive because \"two negatives make a positive.\"","answerSummary":"${{neg}}$"},"prompt":"What is the value of $(-{{a}})(-{{b}})(-{{c}})$?","generator":{"parameters":{"a":{"type":"int","min":2,"max":8},"b":{"type":"int","min":2,"max":8},"c":{"type":"int","min":2,"max":8}},"derived":{"p":"a*b*c","neg":"-a*b*c","ab":"a*b","bc":"b*c"},"constraints":["a*b*c!=a*b","a*b*c!=b*c","a*b!=b*c"]},"assessmentItemFormat":"multipleChoice","choices":[{"id":"act-correct","label":"${{neg}}$"},{"id":"act-d1","label":"${{p}}$"},{"id":"act-d2","label":"${{ab}}$"},{"id":"act-d3","label":"${{bc}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"act-correct"}]},{"id":"mm_act_ies_rnp_3_additive-inverse-combination_v21","active":true,"alignmentKeys":[],"alignments":[{"framework":"act","domainId":"essentialSkills","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"act","examStyle":true,"domainId":"essentialSkills","nativeSkillId":"realNumberProperties","actSubcategory":"integratingEssentialSkills","modeling":false},"familyId":"mathmaster:act:native:realNumberProperties:additive-inverse-combination","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":2,"dok":1,"calculatorPolicy":"graphing","assessedConstruct":"ACT-native:realNumberProperties","taskType":"propertyRecognition","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"nativeSkillId":"realNumberProperties","officialSkillFamily":"properties of real numbers","stemProfile":"additive-inverse-combination","answerChoiceCount":4},"attemptFeedback":["Combine the essential skills in the question and check that each step answers the quantity actually requested."],"supportHints":["Use the numerical relationship or property that makes the computation most efficient, then verify the units or sign."],"solutionReview":{"headline":"A number and its additive inverse cancel, leaving $y$.","reasoning":["Regroup with the commutative and associative properties: $(x+y)+(-x)=(x+(-x))+y$.","A number plus its additive inverse is $0$, so $(x+y)+(-x)=y$."],"commonError":"Thinking $x+(-x)$ is $2x$, or that $-x$ changes the sign of $y$.","answerSummary":"$y$"},"prompt":"For real numbers $x$ and $y$, which expression is equivalent to $(x+y)+(-x)$?","generator":{"parameters":{"d":{"type":"int","min":2,"max":9}}},"assessmentItemFormat":"multipleChoice","choices":[{"id":"act-correct","label":"$y$"},{"id":"act-d1","label":"$x$"},{"id":"act-d2","label":"$-y$"},{"id":"act-d3","label":"$2x+y$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"act-correct"}]},{"id":"mm_act_ies_rnp_4_fraction-reciprocal-product_v21","active":true,"alignmentKeys":[],"alignments":[{"framework":"act","domainId":"essentialSkills","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"act","examStyle":true,"domainId":"essentialSkills","nativeSkillId":"realNumberProperties","actSubcategory":"integratingEssentialSkills","modeling":false},"familyId":"mathmaster:act:native:realNumberProperties:fraction-reciprocal-product","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":2,"dok":1,"calculatorPolicy":"graphing","assessedConstruct":"ACT-native:realNumberProperties","taskType":"reciprocalProperty","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"nativeSkillId":"realNumberProperties","officialSkillFamily":"properties of real numbers","stemProfile":"fraction-reciprocal-product","answerChoiceCount":4},"attemptFeedback":["Combine the essential skills in the question and check that each step answers the quantity actually requested."],"supportHints":["Use the numerical relationship or property that makes the computation most efficient, then verify the units or sign."],"solutionReview":{"headline":"A nonzero number times its reciprocal is $1$.","reasoning":["$\\frac{b}{a}$ is the reciprocal of $\\frac{a}{b}$.","Multiply the numerators and the denominators: $\\frac{a}{b}\\cdot\\frac{b}{a}=\\frac{ab}{ba}=1$."],"commonError":"Squaring one of the fractions instead of noticing that the factors cancel.","answerSummary":"$1$"},"prompt":"For nonzero real numbers $a$ and $b$, what is $\\dfrac{a}{b}\\cdot\\dfrac{b}{a}$?","generator":{"parameters":{"a":{"type":"int","min":2,"max":12},"b":{"type":"int","min":2,"max":12}},"constraints":["a!=b"]},"assessmentItemFormat":"multipleChoice","choices":[{"id":"act-correct","label":"$1$"},{"id":"act-d1","label":"$0$"},{"id":"act-d2","label":"$\\dfrac{a^2}{b^2}$"},{"id":"act-d3","label":"$\\dfrac{b^2}{a^2}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"act-correct"}]},{"id":"mm_act_ies_rnp_5_factor-shared-sum_v21","active":true,"alignmentKeys":[],"alignments":[{"framework":"act","domainId":"essentialSkills","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"act","examStyle":true,"domainId":"essentialSkills","nativeSkillId":"realNumberProperties","actSubcategory":"integratingEssentialSkills","modeling":false},"familyId":"mathmaster:act:native:realNumberProperties:factor-shared-sum","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"ACT-native:realNumberProperties","taskType":"distributiveComputation","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"nativeSkillId":"realNumberProperties","officialSkillFamily":"properties of real numbers","stemProfile":"factor-shared-sum","answerChoiceCount":4},"attemptFeedback":["Combine the essential skills in the question and check that each step an