raicExpressions","officialSkillFamily":"writing algebraic expressions","stemProfile":"mean-expression","answerChoiceCount":4},"attemptFeedback":["Combine the essential skills in the question and check that each step answers the quantity actually requested."],"supportHints":["Translate the stated relationship into mathematics, keep units or constraints attached to the quantities, and verify the result in the original context."],"solutionReview":{"headline":"Average is the sum of all three values divided by 3.","reasoning":["Sum of the values: $x+{{a}}+{{b}}=x+{{ab}}$.","There are 3 values, so the whole sum is divided by 3: $\\dfrac{x+{{a}}+{{b}}}{3}$."],"commonError":"Dividing only {{a}} and {{b}} by 3 and leaving $x$ undivided.","answerSummary":"$\\dfrac{x+{{a}}+{{b}}}{3}$"},"prompt":"The values in a data set are $x$, {{a}}, and {{b}}. Which expression gives the average of the 3 values?","generator":{"parameters":{"a":{"type":"int","min":4,"max":20},"b":{"type":"int","min":4,"max":20}},"constraints":["a!=b"],"derived":{"ab":"a+b"}},"assessmentItemFormat":"multipleChoice","choices":[{"id":"act-correct","label":"$\\dfrac{x+{{a}}+{{b}}}{3}$"},{"id":"act-d1","label":"$x+\\dfrac{{{a}}+{{b}}}{3}$"},{"id":"act-d2","label":"$\\dfrac{x+{{a}}+{{b}}}{2}$"},{"id":"act-d3","label":"$3(x+{{a}}+{{b}})$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"act-correct"}]},{"id":"mm_act_ies_writingalgebraicexpressions_5_rectangle-perimeter-expression_v21","active":true,"alignmentKeys":[],"alignments":[{"framework":"act","domainId":"essentialSkills","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"act","examStyle":true,"domainId":"essentialSkills","nativeSkillId":"writingAlgebraicExpressions","actSubcategory":"integratingEssentialSkills","modeling":true},"familyId":"mathmaster:act:native:writingAlgebraicExpressions:rectangle-perimeter-expression","familyVersion":2,"questionType":"response","activityRole