      "prompt": "A venue sells standard tickets for {{standard}} dollars and student tickets for {{student}} dollars. It plans to sell at least {{minimum}} tickets and collect no more than {{revenue}} dollars. Which system represents the possible nonnegative numbers $x$ of standard tickets and $y$ of student tickets?",
      "generator": {
        "parameters": {
          "standard": {
            "type": "int",
            "min": 12,
            "max": 24
          },
          "student": {
            "type": "int",
            "min": 6,
            "max": 11
          },
          "minimum": {
            "type": "int",
            "min": 30,
            "max": 70
          },
          "revenue": {
            "type": "int",
            "min": 500,
            "max": 1200
          }
        },
        "constraints": [
          "standard>student"
        ]
      },
      "assessmentItemFormat": "multipleChoice",
      "responseFields": [
        {
          "id": "answer",
          "label": "Choose the correct answer",
          "inputProfile": "choice",
          "expected": "sat-correct"
        }
      ],
      "choices": [
        {
          "id": "sat-correct",
          "label": "$x+y\\ge {{minimum}},\\; {{standard}}x+{{student}}y\\le {{revenue}},\\; x\\ge0,\\; y\\ge0$"
        },
        {
          "id": "sat-d1",
          "label": "$x+y\\le {{minimum}},\\; {{standard}}x+{{student}}y\\le {{revenue}},\\; x\\ge0,\\; y\\ge0$"
        },
        {
          "id": "sat-d2",
          "label": "$x+y\\ge {{minimum}},\\; {{standard}}x+{{student}}y\\ge {{revenue}},\\; x\\ge0,\\; y\\ge0$"
        },
        {
          "id": "sat-d3",
          "label": "$x+y={{minimum}},\\; {{standard}}x+{{student}}y={{revenue}},\\; x\\ge0,\\; y\\ge0$"
        }
      ],
