}\\end{array}$\n\nThe line is represented by ${{A}}x+{{B}}y=C$. What is the value of $C$?","solutionReview":{"headline":"Use either table row as a solution of the equation.","reasoning":["Substituting $({{x1}},{{y1}})$ gives $C={{A}}({{x1}})+{{B}}({{y1}})={{C}}$."],"answerSummary":"$C={{C}}$"},"attemptFeedback":["Check that the equation satisfies every condition in the question."],"supportHints":["A point on the line must satisfy the equation. Substitute either row into ${{A}}x+{{B}}y=C$."],"generator":{"parameters":{"A":{"type":"int","min":2,"max":7},"B":{"type":"int","min":2,"max":7},"x1":{"type":"int","min":-5,"max":2},"y1":{"type":"int","min":-5,"max":5,"exclude":[0]},"step":{"type":"int","min":1,"max":4}},"derived":{"C":"A*x1+B*y1","x2":"x1+B*step","y2":"y1-A*step","dSignError":"A*x1-B*y1","dSwappedCoordinates":"A*y1+B*x1","dDroppedCoefficients":"x1+y1"},"constraints":["A!=B","x1!=y1","dDroppedCoefficients!=C","dDroppedCoefficients!=dSignError","dDroppedCoefficients!=dSwappedCoordinates","dSignError!=dSwappedCoordinates"]},"assessmentItemFormat":"multipleChoice","responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-c"}],"choices":[{"id":"choice-c","label":"{{C}}"},{"id":"choice-d","label":"{{dSignError}}"},{"id":"choice-a","label":"{{dSwappedCoordinates}}"},{"id":"choice-b","label":"{{dDroppedCoefficients}}"}]}]}
