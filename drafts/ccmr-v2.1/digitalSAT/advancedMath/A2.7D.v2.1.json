{"schemaVersion":1,"releaseTarget":"ccmr-fidelity-v2.1-authentic-language","framework":"digitalSAT","domainId":"advancedMath","officialSkillFamily":"equivalent expressions","standard":"A2.7D","status":"authored-pass-1","documents":[{"id":"mm_sat_A2_7D_factor_from_roots_cubic_v21","active":true,"alignmentKeys":["texas:A2.7D"],"alignments":[{"framework":"teks","code":"A2.7D","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra2","familyId":"mathmaster:sat:A2.7D:factor-from-roots-cubic","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A2.7D","taskType":"factorIdentification","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"officialSkillFamily":"equivalent expressions","stemProfile":"factor-from-roots-cubic"},"prompt":"A polynomial has zeros ${{r1}}$, ${{r2}}$, and ${{r3}}$. Which expression must be a factor of the polynomial?","generator":{"parameters":{"r1":{"type":"int","min":1,"max":4},"r2":{"type":"int","min":5,"max":8},"r3":{"type":"int","min":9,"max":12}},"derived":{"r1p":"r1+1","r2p":"r2+1","r3p":"r3+1"}},"attemptFeedback":["Use the algebraic structure of the expression and preserve equivalence."],"supportHints":["Use polynomial operations, factor structure, or polynomial division as appropriate."],"solutionReview":{"headline":"A zero $r$ gives the factor $x-r$: $x-{{r1}}$.","reasoning":["By the factor theorem, if $r$ is a zero of a polynomial, then $x-r$ is a factor.","The zero {{r1}} gives the factor $x-{{r1}}$, which is 0 at $x={{r1}}$: ${{r1}}-{{r1}}=0$."],"commonError":"Using $x+{{r1}}$: that factor is 0 at $x=-{{r1}}$, which is not a zero of the polynomial.","answerSummary":"$x-{{r1}}$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-b","label":"$x-{{r1}}$"},{"id":"choice-c","label":"$x+{{r1}}$"},{"id":"choice-d","label":"$x-{{r1p}}$"},{"id":"choice-a","label":"$x+{{r2}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-b"}]},{"id":"mm_sat_A2_7D_factor_theorem_evaluation_v21","active":true,"alignmentKeys":["texas:A2.7D"],"alignments":[{"framework":"teks","code":"A2.7D","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra2","familyId":"mathmaster:sat:A2.7D:factor-theorem-evaluation","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A2.7D","taskType":"factorTheorem","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"officialSkillFamily":"equivalent expressions","stemProfile":"factor-theorem-evaluation"},"prompt":"For a polynomial $P$, $P({{r}})=0$. Which expression must be a factor of $P(x)$?","generator":{"parameters":{"r":{"type":"int","min":2,"max":12}},"derived":{"rp":"r+1","rm":"r-1"}},"attemptFeedback":["Use the algebraic structure of the expression and preserve equivalence."],"supportHints":["Use polynomial operations, factor structure, or polynomial division as appropriate."],"solutionReview":{"headline":"$P({{r}})=0$ means $x-{{r}}$ is a factor.","reasoning":["By the factor theorem, if $P(r)=0$ then $x-r$ is a factor of $P(x)$.","Here {{r}} is a zero, and $x-{{r}}$ is the factor that is 0 there: ${{r}}-{{r}}=0$. So $x-{{r}}$ must be a factor."],"commonError":"Choosing $x+{{r}}$: that factor is 0 at $x=-{{r}}$, not at {{r}}.","answerSummary":"$x-{{r}}$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-a","label":"$x-{{r}}$"},{"id":"choice-b","label":"$x+{{r}}$"},{"id":"choice-c","label":"$x-{{rp}}$"},{"id":"choice-d","label":"$x-{{rm}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-a"}]},{"id":"mm_sat_A2_7D_cubic_known_factors_v21","active":true,"alignmentKeys":["texas:A2.7D"],"alignments":[{"framework":"teks","code":"A2.7D","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra2","familyId":"mathmaster:sat:A2.7D:cubic-known-factors","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A2.7D","taskType":"factorIdentification","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"officialSkillFamily":"equivalent expressions","stemProfile":"cubic-known-factors"},"prompt":"The polynomial $P(x)=(x-{{p}})(x+{{q}})(x-{{r}})$. Which of the following is a linear factor of $P(x)$?","generator":{"parameters":{"p":{"type":"int","min":2,"max":7},"q":{"type":"int","min":8,"max":12},"r":{"type":"int","min":13,"max":17}},"derived":{"p1":"p+1","q1":"q+1"},"constraints":["q1!=0"]},"attemptFeedback":["Use the algebraic structure of the expression and preserve equivalence."],"supportHints":["Use polynomial operations, factor structure, or polynomial division as appropriate."],"solutionReview":{"headline":"Read the linear factors straight from the product: $x+{{q}}$.","reasoning":["$P(x)$ is already a product of linear factors: $x-{{p}}$, $x+{{q}}$ and $x-{{r}}$.","Of the choices, $x+{{q}}$ is one of them; it is 0 at $x=-{{q}}$, a zero of $P$: $-{{q}}+{{q}}=0$."],"commonError":"Changing the sign: $x-{{q}}$ would be 0 at $x={{q}}$, which is not a zero of $P$.","answerSummary":"$x+{{q}}$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-c","label":"$x+{{q}}$"},{"id":"choice-d","label":"$x-{{q}}$"},{"id":"choice-a","label":"$x+{{p}}$"},{"id":"choice-b","label":"$x+{{q1}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-c"}]},{"id":"mm_sat_A2_7D_parameter_factor_theorem_v21","active":true,"alignmentKeys":["texas:A2.7D"],"alignments":[{"framework":"teks","code":"A2.7D","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra2","familyId":"mathmaster:sat:A2.7D:parameter-factor-theorem","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A2.7D","taskType":"parameterReasoning","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"officialSkillFamily":"equivalent expressions","stemProfile":"parameter-factor-theorem"},"prompt":"The polynomial $P(x)=x^3-{{r}}x^2+kx-{{c}}$ has factor $x-{{a}}$. What is the value of $k$?","generator":{"parameters":{"r":{"type":"int","min":2,"max":6},"a":{"type":"int","min":2,"max":6},"k0":{"type":"int","min":3,"max":12}},"derived":{"c":"a*a*a-r*a*a+k0*a","a3":"a*a*a","ra2":"r*a*a","ka":"k0*a"},"constraints":["a*a*a-r*a*a+k0*a>0"]},"attemptFeedback":["Use the algebraic structure of the expression and preserve equivalence."],"supportHints":["Use polynomial operations, factor structure, or polynomial division as appropriate."],"solutionReview":{"headline":"$x-{{a}}$ is a factor, so $P({{a}})=0$: $k={{k0}}$.","reasoning":["By the factor theorem, $P({{a}})=0$: ${{a}}^3-{{r}}\\cdot {{a}}^2+k\\cdot {{a}}-{{c}}=0$.","That is ${{a3}}-{{ra2}}+{{a}}k-{{c}}=0$, so ${{a}}k={{c}}-{{a3}}+{{ra2}}={{ka}}$.","So $k=\\frac{{{ka}}}{{{a}}}={{k0}}$."],"commonError":"Substituting $x=-{{a}}$: the factor $x-{{a}}$ means $P({{a}})=0$.","answerSummary":"$k={{k0}}$"},"assessmentItemFormat":"studentProducedResponse","responseFields":[{"id":"answer","label":"Answer","inputProfile":"number","expected":"{{k0}}"}]},{"id":"mm_sat_A2_7D_identify_nonfactor_v21","active":true,"alignmentKeys":["texas:A2.7D"],"alignments":[{"framework":"teks","code":"A2.7D","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra2","familyId":"mathmaster:sat:A2.7D:identify-nonfactor","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A2.7D","taskType":"factorIdentification","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"officialSkillFamily":"equivalent expressions","stemProfile":"identify-nonfactor"},"prompt":"The polynomial $P(x)=(x-{{a}})(x-{{b}})(x+{{c}})(x+{{d}})$. Which expression is NOT a factor of $P(x)$?","generator":{"parameters":{"a":{"type":"int","min":1,"max":4},"b":{"type":"int","min":5,"max":8},"c":{"type":"int","min":9,"max":12},"d":{"type":"int","min":13,"max":16}},"derived":{"bp":"b+1","val":"(b+1-a)*(b+1+c)*(b+1+d)"}},"attemptFeedback":["Use the algebraic structure of the expression and preserve equivalence."],"supportHints":["Use polynomial operations, factor structure, or polynomial division as appropriate."],"solutionReview":{"headline":"$x-{{bp}}$ is not one of the four factors.","reasoning":["The linear factors of $P(x)$ are $x-{{a}}$, $x-{{b}}$, $x+{{c}}$ and $x+{{d}}$.","$x-{{bp}}$ would need ${{bp}}$ to be a zero, but $({{bp}}-{{a}})({{bp}}-{{b}})({{bp}}+{{c}})({{bp}}+{{d}})={{val}}$, not 0.","So the expression that is NOT a factor is $x-{{bp}}$."],"commonError":"Choosing one of the factors that appears in the product: the question asks for the one that does not.","answerSummary":"$x-{{bp}}$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-b","label":"$x-{{bp}}$"},{"id":"choice-c","label":"$x-{{a}}$"},{"id":"choice-d","label":"$x-{{b}}$"},{"id":"choice-a","label":"$x+{{c}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-b"}]},{"id":"mm_sat_A2_7D_challenge_recover_factor_from_quadratic_v21","active":true,"alignmentKeys":["texas:A2.7D"],"alignments":[{"framework":"teks","code":"A2.7D","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra2","familyId":"mathmaster:sat:A2.7D:ccmr-challenge-recover-factor-from-quadratic","familyVersion":1,"questionType":"response","activityRole":"practice","difficultyBand":4,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A2.7D","taskType":"factorIdentification","representation":"symbolic","ccmrChallengeTier":2,"ccmrFamilyRole":"challenge","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"authoredChallenge":true,"officialSkillFamily":"equivalent expressions","stemProfile":"recover-factor-from-quadratic"},"prompt":"A cubic polynomial is $(x-{{p}})(x^2-{{sum}}x+{{prod}})$, where the quadratic factor has integer zeros {{q}} and {{r}}. Which expression is another linear factor of the polynomial?","generator":{"parameters":{"p":{"type":"int","min":2,"max":5},"q":{"type":"int","min":6,"max":9},"r":{"type":"int","min":10,"max":13}},"derived":{"sum":"q+r","prod":"q*r","qp":"q+1"},"constraints":["prod!=0","sum!=0","sum!=1","sum!=-1"]},"attemptFeedback":["Use the algebraic structure of the expression and preserve equivalence."],"supportHints":["Use polynomial operations, factor structure, or polynomial division as appropriate."],"solutionReview":{"headline":"The quadratic's zeros {{q}} and {{r}} give factors: $x-{{q}}$.","reasoning":["A quadratic with zeros {{q}} and {{r}} is $(x-{{q}})(x-{{r}})$; check: ${{q}}+{{r}}={{sum}}$ and ${{q}}\\cdot {{r}}={{prod}}$.","So the cubic is $(x-{{p}})(x-{{q}})(x-{{r}})$, and $x-{{q}}$ is another linear factor."],"commonError":"Using $x+{{q}}$: a zero {{q}} gives the factor $x-{{q}}$.","answerSummary":"$x-{{q}}$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-c","label":"$x-{{q}}$"},{"id":"choice-d","label":"$x+{{q}}$"},{"id":"choice-a","label":"$x-{{qp}}$"},{"id":"choice-b","label":"$x+{{r}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-c"}]},{"id":"mm_sat_A2_7D_challenge_factor_parameter_cubic_v21","active":true,"alignmentKeys":["texas:A2.7D"],"alignments":[{"framework":"teks","code":"A2.7D","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra2","familyId":"mathmaster:sat:A2.7D:ccmr-challenge-factor-parameter-cubic","familyVersion":1,"questionType":"response","activityRole":"practice","difficultyBand":4,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A2.7D","taskType":"parameterReasoning","representation":"symbolic","ccmrChallengeTier":2,"ccmrFamilyRole":"challenge","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"authoredChallenge":true,"officialSkillFamily":"equivalent expressions","stemProfile":"factor-parameter-cubic"},"prompt":"The polynomial $P(x)=x^3+{{b}}x^2+{{c}}x+k$ has factor $x+{{p}}$. If $k$ is positive, what is the value of $k$?","generator":{"parameters":{"p":{"type":"int","min":2,"max":6},"b":{"type":"int","min":7,"max":12},"c":{"type":"int","min":15,"max":25}},"derived":{"k":"p*p*p-b*p*p+c*p","p3":"p*p*p","bp2":"b*p*p","cp":"c*p"},"constraints":["p*p*p-b*p*p+c*p>0"]},"attemptFeedback":["Use the algebraic structure of the expression and preserve equivalence."],"supportHints":["Use polynomial operations, factor structure, or polynomial division as appropriate."],"solutionReview":{"headline":"$x+{{p}}$ is a factor, so $P(-{{p}})=0$: $k={{k}}$.","reasoning":["By the factor theorem, $P(-{{p}})=0$: $(-{{p}})^3+{{b}}(-{{p}})^2+{{c}}(-{{p}})+k=0$.","That is $-{{p3}}+{{bp2}}-{{cp}}+k=0$, so $k={{p3}}-{{bp2}}+{{cp}}={{k}}$."],"commonError":"Substituting $x={{p}}$ instead of $x=-{{p}}$: the factor $x+{{p}}$ is 0 at $x=-{{p}}$.","answerSummary":"$k={{k}}$"},"assessmentItemFormat":"studentProducedResponse","responseFields":[{"id":"answer","label":"Answer","inputProfile":"number","expected":"{{k}}"}]},{"id":"mm_sat_A2_7D_challenge_quartic_factor_structure_v21","active":true,"alignmentKeys":["texas:A2.7D"],"alignments":[{"framework":"teks","code":"A2.7D","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra2","familyId":"mathmaster:sat:A2.7D:ccmr-challenge-quartic-factor-structure","familyVersion":1,"questionType":"response","activityRole":"practice","difficultyBand":5,"dok":3,"calculatorPolicy":"graphing","assessedConstruct":"A2.7D","taskType":"factorIdentification","representation":"symbolic","ccmrChallengeTier":2,"ccmrFamilyRole":"challenge","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"authoredChallenge":true,"officialSkillFamily":"equivalent expressions","stemProfile":"quartic-factor-structure"},"prompt":"The polynomial $P(x)=(x^2-{{a2}})(x^2+{{b}}x+{{c}})$. Which expression must be a linear factor of $P(x)$?","generator":{"parameters":{"a":{"type":"int","min":2,"max":9},"b":{"type":"int","min":1,"max":8,"exclude":[1]},"c":{"type":"int","min":1,"max":9}},"derived":{"a2":"a*a","ap":"a+1"},"constraints":["ap!=0"]},"attemptFeedback":["Use the algebraic structure of the expression and preserve equivalence."],"supportHints":["Use polynomial operations, factor structure, or polynomial division as appropriate."],"solutionReview":{"headline":"$x^2-{{a2}}$ is a difference of squares, so $x-{{a}}$ is a factor.","reasoning":["$x^2-{{a2}}=(x-{{a}})(x+{{a}})$, a difference of squares.","So $P(x)=(x-{{a}})(x+{{a}})(x^2+{{b}}x+{{c}})$, and $x-{{a}}$ must be a linear factor."],"commonError":"Choosing $x-{{a2}}$: the factors of $x^2-{{a2}}$ use the square root {{a}}, not {{a2}}.","answerSummary":"$x-{{a}}$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-c","label":"$x-{{a}}$"},{"id":"choice-d","label":"$x-{{a2}}$"},{"id":"choice-a","label":"$x+{{ap}}$"},{"id":"choice-b","label":"$x-{{ap}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-c"}]}]}
