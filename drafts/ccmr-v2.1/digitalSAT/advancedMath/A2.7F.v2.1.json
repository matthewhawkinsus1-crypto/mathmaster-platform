{"schemaVersion":1,"releaseTarget":"ccmr-fidelity-v2.1-authentic-language","framework":"digitalSAT","domainId":"advancedMath","officialSkillFamily":"equivalent expressions","standard":"A2.7F","status":"authored-pass-1","documents":[{"id":"mm_sat_A2_7F_1_multiply-cancel-rational_v21","active":true,"alignmentKeys":["texas:A2.7F"],"alignments":[{"framework":"teks","code":"A2.7F","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra2","familyId":"mathmaster:sat:A2.7F:multiply-cancel-rational","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A2.7F","taskType":"structuralRewrite","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"officialSkillFamily":"equivalent expressions","stemProfile":"multiply-cancel-rational"},"prompt":"Where the expressions are defined, which expression is equivalent to $\\dfrac{x+{{p}}}{x+{{q}}}\\cdot\\dfrac{x+{{q}}}{x+{{r}}}$?","generator":{"parameters":{"p":{"type":"int","min":2,"max":6},"q":{"type":"int","min":7,"max":11},"r":{"type":"int","min":12,"max":16}}},"attemptFeedback":["Use the algebraic structure of the expression and preserve equivalence."],"supportHints":["Combine like terms, distribute, factor, or simplify the radical structure as appropriate."],"solutionReview":{"headline":"Write it as one fraction and cancel what is above and below: $\\dfrac{x+{{p}}}{x+{{r}}}$.","reasoning":["As one fraction: $\\frac{x+{{p}}}{x+{{q}}}\\cdot\\frac{x+{{q}}}{x+{{r}}}=\\frac{(x+{{p}})(x+{{q}})}{(x+{{q}})(x+{{r}})}$.","The factor $x+{{q}}$ is above and below, so it cancels where the expression is defined: the result is $\\dfrac{x+{{p}}}{x+{{r}}}$."],"commonError":"Cancelling a factor that appears only once, or turning the result upside down.","answerSummary":"$\\dfrac{x+{{p}}}{x+{{r}}}$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-a","label":"$\\dfrac{x+{{p}}}{x+{{r}}}$"},{"id":"choice-b","label":"$\\dfrac{x+{{q}}}{x+{{r}}}$"},{"id":"choice-c","label":"$\\dfrac{x+{{p}}}{x+{{q}}}$"},{"id":"choice-d","label":"$\\dfrac{x+{{r}}}{x+{{p}}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-a"}]},{"id":"mm_sat_A2_7F_2_divide-rational_v21","active":true,"alignmentKeys":["texas:A2.7F"],"alignments":[{"framework":"teks","code":"A2.7F","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra2","familyId":"mathmaster:sat:A2.7F:divide-rational","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A2.7F","taskType":"structuralRewrite","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"officialSkillFamily":"equivalent expressions","stemProfile":"divide-rational"},"prompt":"Where the expressions are defined, which expression is equivalent to $\\dfrac{x+{{u}}}{x+{{v}}}\\div\\dfrac{x+{{w}}}{x+{{v}}}$?","generator":{"parameters":{"u":{"type":"int","min":3,"max":7},"v":{"type":"int","min":8,"max":12},"w":{"type":"int","min":13,"max":17}}},"attemptFeedback":["Use the algebraic structure of the expression and preserve equivalence."],"supportHints":["Combine like terms, distribute, factor, or simplify the radical structure as appropriate."],"solutionReview":{"headline":"Multiply by the reciprocal, then cancel $x+{{v}}$: $\\dfrac{x+{{u}}}{x+{{w}}}$.","reasoning":["Dividing by a fraction is multiplying by its reciprocal: $\\frac{x+{{u}}}{x+{{v}}}\\div\\frac{x+{{w}}}{x+{{v}}}=\\frac{x+{{u}}}{x+{{v}}}\\cdot\\frac{x+{{v}}}{x+{{w}}}$.","Cancel $x+{{v}}$, which is above and below: the result is $\\dfrac{x+{{u}}}{x+{{w}}}$."],"commonError":"Turning the first fraction over instead of the second, which gives the reciprocal of the answer.","answerSummary":"$\\dfrac{x+{{u}}}{x+{{w}}}$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-a","label":"$\\dfrac{x+{{u}}}{x+{{w}}}$"},{"id":"choice-b","label":"$\\dfrac{x+{{u}}}{x+{{v}}}$"},{"id":"choice-c","label":"$\\dfrac{x+{{w}}}{x+{{u}}}$"},{"id":"choice-d","label":"$\\dfrac{x+{{v}}}{x+{{w}}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-a"}]},{"id":"mm_sat_A2_7F_3_add-common-denominator_v21","active":true,"alignmentKeys":["texas:A2.7F"],"alignments":[{"framework":"teks","code":"A2.7F","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra2","familyId":"mathmaster:sat:A2.7F:add-common-denominator","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A2.7F","taskType":"structuralRewrite","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"officialSkillFamily":"equivalent expressions","stemProfile":"add-common-denominator"},"prompt":"Which expression is equivalent to $\\dfrac{{{a}}x+{{b}}}{x+{{p}}}+\\dfrac{{{c}}x+{{d}}}{x+{{p}}}$?","generator":{"parameters":{"a":{"type":"int","min":2,"max":6},"b":{"type":"int","min":1,"max":8},"c":{"type":"int","min":1,"max":5,"exclude":[1]},"d":{"type":"int","min":1,"max":8},"p":{"type":"int","min":2,"max":9}},"derived":{"A":"a+c","B":"b+d","A1":"a+c+1","B1":"b+d+1"},"constraints":["A!=0","A!=1","A!=-1","A1!=0","A1!=1","A1!=-1","B!=0","B1!=0"]},"attemptFeedback":["Use the algebraic structure of the expression and preserve equivalence."],"supportHints":["Combine like terms, distribute, factor, or simplify the radical structure as appropriate."],"solutionReview":{"headline":"Same denominator: add the numerators, keep $x+{{p}}$.","reasoning":["The denominators match, so add the numerators: $({{a}}x+{{b}})+({{c}}x+{{d}})={{A}}x+{{B}}$.","Keep the denominator: $\\frac{{{a}}x+{{b}}}{x+{{p}}}+\\frac{{{c}}x+{{d}}}{x+{{p}}}=\\dfrac{{{A}}x+{{B}}}{x+{{p}}}$."],"commonError":"Adding the denominators as well: a common denominator stays as it is.","answerSummary":"$\\dfrac{{{A}}x+{{B}}}{x+{{p}}}$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-d","label":"$\\dfrac{{{A}}x+{{B}}}{x+{{p}}}$"},{"id":"choice-a","label":"$\\dfrac{{{A1}}x+{{B}}}{x+{{p}}}$"},{"id":"choice-b","label":"$\\dfrac{{{A}}x+{{B1}}}{x+{{p}}}$"},{"id":"choice-c","label":"$\\dfrac{{{A}}x+{{B}}}{2x+{{p}}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-d"}]},{"id":"mm_sat_A2_7F_4_subtract-common-denominator_v21","active":true,"alignmentKeys":["texas:A2.7F"],"alignments":[{"framework":"teks","code":"A2.7F","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra2","familyId":"mathmaster:sat:A2.7F:subtract-common-denominator","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A2.7F","taskType":"structuralRewrite","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"officialSkillFamily":"equivalent expressions","stemProfile":"subtract-common-denominator"},"prompt":"Which expression is equivalent to $\\dfrac{{{a}}x+{{b}}}{x+{{p}}}-\\dfrac{{{c}}x+{{d}}}{x+{{p}}}$?","generator":{"parameters":{"a":{"type":"int","min":7,"max":12},"b":{"type":"int","min":8,"max":14},"c":{"type":"int","min":1,"max":5,"exclude":[1]},"d":{"type":"int","min":1,"max":6},"p":{"type":"int","min":2,"max":9}},"derived":{"A":"a-c","B":"b-d","Aw":"a+c","Bw":"b+d"},"constraints":["A!=0","A!=1","A!=-1","Aw!=0","Aw!=1","Aw!=-1","B!=0","Bw!=0"]},"attemptFeedback":["Use the algebraic structure of the expression and preserve equivalence."],"supportHints":["Combine like terms, distribute, factor, or simplify the radical structure as appropriate."],"solutionReview":{"headline":"Same denominator: subtract the whole second numerator, keep $x+{{p}}$.","reasoning":["Subtract the numerators, every term: $({{a}}x+{{b}})-({{c}}x+{{d}})={{A}}x+{{B}}$.","Keep the denominator: $\\frac{{{a}}x+{{b}}}{x+{{p}}}-\\frac{{{c}}x+{{d}}}{x+{{p}}}=\\dfrac{{{A}}x+{{B}}}{x+{{p}}}$."],"commonError":"Subtracting only the first term of the second numerator, or changing the denominator.","answerSummary":"$\\dfrac{{{A}}x+{{B}}}{x+{{p}}}$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-a","label":"$\\dfrac{{{A}}x+{{B}}}{x+{{p}}}$"},{"id":"choice-b","label":"$\\dfrac{{{Aw}}x+{{B}}}{x+{{p}}}$"},{"id":"choice-c","label":"$\\dfrac{{{A}}x+{{Bw}}}{x+{{p}}}$"},{"id":"choice-d","label":"$\\dfrac{{{A}}x+{{B}}}{2x+{{p}}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-a"}]},{"id":"mm_sat_A2_7F_5_simplify-two-factor-rational_v21","active":true,"alignmentKeys":["texas:A2.7F"],"alignments":[{"framework":"teks","code":"A2.7F","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra2","familyId":"mathmaster:sat:A2.7F:simplify-two-factor-rational","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A2.7F","taskType":"structuralRewrite","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"officialSkillFamily":"equivalent expressions","stemProfile":"simplify-two-factor-rational"},"prompt":"Where the expression is defined, which expression is equivalent to $\\dfrac{(x+{{u}})(x+{{v}})}{(x+{{u}})(x+{{w}})}$?","generator":{"parameters":{"u":{"type":"int","min":2,"max":5},"v":{"type":"int","min":6,"max":9},"w":{"type":"int","min":10,"max":13}}},"attemptFeedback":["Use the algebraic structure of the expression and preserve equivalence."],"supportHints":["Combine like terms, distribute, factor, or simplify the radical structure as appropriate."],"solutionReview":{"headline":"Cancel the factor above and below: $\\dfrac{x+{{v}}}{x+{{w}}}$.","reasoning":["The factor $x+{{u}}$ is in the numerator and in the denominator, and it is not 0 where the expression is defined.","Cancel it: $\\frac{(x+{{u}})(x+{{v}})}{(x+{{u}})(x+{{w}})}=\\dfrac{x+{{v}}}{x+{{w}}}$."],"commonError":"Cancelling a factor that appears only once, or turning the result upside down.","answerSummary":"$\\dfrac{x+{{v}}}{x+{{w}}}$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-a","label":"$\\dfrac{x+{{v}}}{x+{{w}}}$"},{"id":"choice-b","label":"$\\dfrac{x+{{u}}}{x+{{w}}}$"},{"id":"choice-c","label":"$\\dfrac{x+{{v}}}{x+{{u}}}$"},{"id":"choice-d","label":"$\\dfrac{x+{{w}}}{x+{{v}}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-a"}]},{"id":"mm_sat_A2_7F_challenge_1_add-unlike-linear-denominators_v21","active":true,"alignmentKeys":["texas:A2.7F"],"alignments":[{"framework":"teks","code":"A2.7F","role":"primary","evidenceLevel":"assessed"},{"framewo