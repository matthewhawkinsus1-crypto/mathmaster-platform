icialSkillFamily":"nonlinear functions","stemProfile":"standard-linear-coefficient-from-zeros"},"prompt":"A monic quadratic has zeros {{r1}} and {{r2}}. If it is written as $x^2+bx+c$, what is the value of $b$?","generator":{"parameters":{"r1":{"type":"int","min":-8,"max":-1},"r2":{"type":"int","min":2,"max":9}},"derived":{"b":"-(r1+r2)","f1":"-r1","f2":"-r2","c":"r1*r2"}},"attemptFeedback":["Use the structure of the nonlinear relationship and the information given to determine the requested value or representation."],"supportHints":["Connect the equation, factors, zeros, vertex, or graph features that describe the same function."],"solutionReview":{"headline":"Write the factors and expand: $b={{b}}$.","reasoning":["The zeros give the factors: $(x {{f1|signed}})(x {{f2|signed}})$.","Expand: $(x {{f1|signed}})(x {{f2|signed}})=x^2 {{b|xterm}} {{c|signed}}$.","The $x$-coefficient is the sum of the constants in the factors: $b={{f1}}+{{f2|paren}}={{b}}$."],"commonError":"Adding the zeros without changing the sign: $b$ is the negative of their sum.","answerSummary":"$b={{b}}$"},"assessmentItemFormat":"studentProducedResponse","responseFields":[{"id":"answer","label":"Answer","inputProfile":"number","expected":"{{b}}"}]},{"id":"mm_sat_A_6C_graph-intercepts-to-equation_v21","active":true,"alignmentKeys":["texas:A.6C"],"alignments":[{"framework":"teks","code":"A.6C","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra1","familyId":"mathmaster:sat:A.6C:graph-intercepts-to-equation","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A.6C","taskType":"representationConnection","representation":"graphDescription","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"officialSkillFamily":"nonlinear functions","stemProfile":"graph-intercepts-to-equation"},"prompt":"A parabola crosses the $x$-axis at $x={{r1}}$ and $x={{r2}}$ and opens upward. Which equation could represent it?","generator":{"parameters":{"r1":{"type":"int","min":-7,"max":-1},"r2":{"type":"int","min":2,"max":8}},"derived":{"r1p":"r1+1","r2p":"r2+1","f1":"-r1","f2":"-r2","nr1p":"-(r1+1)","nr2p":"-(r2+1)"},"constraints":["r1+r2!=-1","-r1!=r2","f1!=0","f2!=0","nr1p!=0","nr2p!=0"]},"attemptFeedback":["Use the structure of the nonlinear relationship and the information given to determine the requested value or representation."],"supportHints":["Connect the equation, factors, zeros, vertex, or graph features that describe the same function."],"solutionReview":{"headline":"Factors from the intercepts, no minus sign in front: $y=(x {{f1|signed}})(x {{f2|signed}})$.","reasoning":["Crossing at $x={{r1}}$ and $x={{r2}}$ gives the factors $x {{f1|signed}}$ and $x {{f2|signed}}$. Check: $({{r1}} {{f1|signed}})({{r1}} {{f2|signed}})=0$.","Opening upward needs a positive leading coefficient, so there is no minus sign in front.","So the graph could be $y=(x {{f1|signed}})(x {{f2|signed}})$."],"commonError":"Using the intercepts' own signs in the factors, or putting a minus sign in front, which makes the graph open downward.","answerSummary":"$y=(x {{f1|signed}})(x {{f2|signed}})$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-a","label":"$y=(x {{f1|signed}})(x {{f2|signed}})$"},{"id":"choice-b","label":"$y=-(x {{f1|signed}})(x {{f2|signed}})$"},{"id":"choice-c","label":"$y=(x {{r1|signed}})(x {{r2|signed}})$"},{"id":"choice-d","label":"$y=(x {{nr1p|signed}})(x {{nr2p|signed}})$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-a"}]},{"id":"mm_sat_A_6C_challenge_challenge-y-intercept-from-roots_v21","active":true,"alignmentKeys":["texas:A.6C"],"alignments":[{"framewor