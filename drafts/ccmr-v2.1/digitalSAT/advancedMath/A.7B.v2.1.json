emProfile":"sum-of-zeros","secondarySkillFamily":"nonlinear functions"},"prompt":"The zeros of $x^2-{{S}}x+{{P}}$ are $r$ and $s$. What is the value of $r+s$?","generator":{"parameters":{"r":{"type":"int","min":2,"max":8},"s":{"type":"int","min":9,"max":15}},"derived":{"S":"r+s","P":"r*s"},"constraints":["P!=0","S!=0","S!=1","S!=-1"]},"attemptFeedback":["Use the structure of the nonlinear relationship and the information given to determine the requested value or representation."],"supportHints":["Connect the equation, factors, zeros, vertex, or graph features that describe the same function."],"solutionReview":{"headline":"Factor, then add the zeros: $r+s={{S}}$.","reasoning":["$x^2-{{S}}x+{{P}}=(x-{{r}})(x-{{s}})$, so the zeros are $r={{r}}$ and $s={{s}}$.","$r+s={{r}}+{{s}}={{S}}$: for a monic quadratic, the sum of the zeros is the opposite of the $x$-coefficient."],"commonError":"Giving the product {{P}}, or $-{{S}}$ with the sign of the coefficient.","answerSummary":"$r+s={{S}}$"},"assessmentItemFormat":"studentProducedResponse","responseFields":[{"id":"answer","label":"Answer","inputProfile":"number","expected":"{{S}}"}]},{"id":"mm_sat_A_7B_product-of-zeros_v21","active":true,"alignmentKeys":["texas:A.7B"],"alignments":[{"framework":"teks","code":"A.7B","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra1","familyId":"mathmaster:sat:A.7B:product-of-zeros","familyVersion":2,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A.7B","taskType":"reverseReasoning","representation":"standardForm","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"officialSkillFamily":"equivalent expressions","stemProfile":"product-of-zeros","secondarySkillFamily":"nonlinear functions"},"prompt":"The zeros of $x^2-{{S}}x+{{P}}$ are $r$ and $s$. What is the value of $rs$?","generator":{"parameters":{"p":{"type":"int","min":1,"max":6},"q":{"type":"int","min":7,"max":12}},"derived":{"r":"p+1","s":"q+1","S":"r+s","P":"r*s"},"constraints":["P!=0","S!=0","S!=1","S!=-1"]},"attemptFeedback":["Use the structure of the nonlinear relationship and the information given to determine the requested value or representation."],"supportHints":["Connect the equation, factors, zeros, vertex, or graph features that describe the same function."],"solutionReview":{"headline":"Factor, then multiply the zeros: $rs={{P}}$.","reasoning":["$x^2-{{S}}x+{{P}}=(x-{{r}})(x-{{s}})$, so the zeros are $r={{r}}$ and $s={{s}}$.","$rs={{r}}\\cdot {{s}}={{P}}$: for a monic quadratic, the product of the zeros is the constant term."],"commonError":"Giving the sum {{S}} of the zeros instead of their product.","answerSummary":"$rs={{P}}$"},"assessmentItemFormat":"studentProducedResponse","responseFields":[{"id":"answer","label":"Answer","inputProfile":"number","expected":"{{P}}"}]},{"id":"mm_sat_A_7B_challenge_challenge-scaled-factors-zero_v21","active":true,"alignmentKeys":["texas:A.7B"],"alignments":[{"framework":"teks","code":"A.7B","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra1","familyId":"mathmaster:sat:A.7B:ccmr-challenge-challenge-scaled-factors-zero","familyVersion":1,"questionType":"response","activityRole":"practice","difficultyBand":4,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A.7B","taskType":"factorZeroConnection","representation":"factoredForm","ccmrChallengeTier":2,"ccmrFamilyRole":"challenge","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"authoredChallenge":true,"officialSkillFamily":"equivalent expressions","stemProfile":"challenge-scaled-factors-zero","secondarySkillFamily":"nonlinear functions"},"prompt":"The equation ${{a}}(x {{f1|signed}})(x {{f2|signed}})=0$ has two real solutions. Which pair gives the solutions?","generator":{"parameters":{"a":{"type":"int","min":2,"max":7},"r1":{"type":"int","min":-8,"max":-1},"r2":{"type":"int","min":2,"max":9}},"derived":{"nr1":"-r1","nr2":"-r2","r2p":"r2+1","f1":"-r1","f2":"-r2"},"constraints":["-r1!=r2","f1!=0","f2!=0"]},"attemptFeedback":["Use the structure of the nonlinear relationship and the information given to determine the requested value or representation."],"supportHints":["Connect the equation, factors, zeros, vertex, or graph features that describe the same function."],"solutionReview":{"headline":"The factor {{a}} is never 0; set each bracket equal to 0: {{r1}} and {{r2}}.","reasoning":["A product is 0 only when a factor is 0, and {{a}} is not 0.","$x {{f1|signed}}=0$ gives $x={{r1}}$, and $x {{f2|signed}}=0$ gives $x={{r2}}$.","So the solutions are ${{r1}}$ and ${{r2}}$."],"commonError":"Reading the numbers in the brackets as the solutions: $x {{f1|signed}}$ is 0 at $x={{r1}}$, the opposite sign.","answerSummary":"${{r1}}$ and ${{r2}}$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-b","label":"${{r1}}$ and ${{r2}}$"},{"id":"choice-c","label":"${{nr1}}$ and ${{nr2}}$"},{"id":"choice-d","label":"${{r1}}$ and ${{nr2}}$"},{"id":"choice-a","label":"${{r1}}$ and ${{r2p}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-b"}]},{"id":"mm_sat_A_7B_challenge_challenge-coefficient-from-roots_v21","active":true,"alignmentKeys":["texas:A.7B"],"alignments":[{"framework":"teks","code":"A.7B","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra1","familyId":"ma