stitute $({{t1}},{{y1}})$: ${{y1}}=a({{t1}}-{{v}})^2+{{k}}=a\\cdot {{dt2}}+{{k}}$, so $a=\\frac{{{y1}}-{{k}}}{{{dt2}}}={{aneg}}$.","So the height can be modeled by $h(t)={{aneg|coef}}(t-{{v}})^2+{{k}}$."],"commonError":"Using a positive leading coefficient: that graph opens upward and has a minimum, not a maximum.","answerSummary":"$h(t)={{aneg|coef}}(t-{{v}})^2+{{k}}$"},"assessmentItemFormat":"multipleChoice","choices":[{"id":"choice-b","label":"$h(t)={{aneg|coef}}(t-{{v}})^2+{{k}}$"},{"id":"choice-c","label":"$h(t)={{a0|coef}}(t-{{v}})^2+{{k}}$"},{"id":"choice-d","label":"$h(t)={{aneg|coef}}(t+{{v}})^2+{{k}}$"},{"id":"choice-a","label":"$h(t)={{aneg|coef}}(t-{{v1}})^2+{{k1}}$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"choice-b"}]},{"id":"mm_sat_A_6B_challenge_challenge-recover-vertex-k_v21","active":true,"alignmentKeys":["texas:A.6B"],"alignments":[{"framework":"teks","code":"A.6B","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra1","familyId":"mathmaster:sat:A.6B:ccmr-challenge-challenge-recover-vertex-k","familyVersion":1,"questionType":"response","activityRole":"practice","difficultyBand":4,"dok":2,"calculatorPolicy":"graphing","assessedConstruct":"A.6B","taskType":"parameterReasoning","representation":"vertexForm","ccmrChallengeTier":2,"ccmrFamilyRole":"challenge","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"authoredChallenge":true,"officialSkillFamily":"nonlinear functions","stemProfile":"challenge-recover-vertex-k"},"prompt":"The function $f(x)={{a|coef}}(x {{nh|term}})^2+k$ passes through $({{x1}},{{y1}})$. What is the value of $k$?","generator":{"parameters":{"a":{"type":"int","min":1,"max":5},"h":{"type":"int","min":-4,"max":4},"k0":{"type":"int","min":-8,"max":8},"dx":{"type":"int","min":2,"max":5}},"derived":{"x1":"h+dx","y1":"a*dx*dx+k0","nh":"-h","dx2":"dx*dx","ady":"a*dx*dx"},"constraints":["nh!=0"]},"attemptFeedback":["Use the structure of the nonlinear relationship and the information given to determine the requested value or representation."],"supportHints":["Connect the equation, factors, zeros, vertex, or graph features that describe the same function."],"solutionReview":{"headline":"Substitute the point and solve for $k$: $k={{k0}}$.","reasoning":["Substitute $({{x1}},{{y1}})$: ${{y1}}={{a|coef}}({{x1}} {{nh|term}})^2+k={{a}}\\cdot {{dx2}}+k={{ady}}+k$.","Subtract {{ady}}: $k={{y1}}-{{ady}}={{k0}}$."],"commonError":"Forgetting to square $({{x1}} {{nh|term}})$, or not multiplying the square by {{a}}.","answerSummary":"$k={{k0}}$"},"assessmentItemFormat":"studentProducedResponse","responseFields":[{"id":"answer","label":"Answer","inputProfile":"number","expected":"{{k0}}"}]},{"id":"mm_sat_A_6B_challenge_challenge-standard-to-vertex-parameter_v21","active":true,"alignmentKeys":["texas:A.6B"],"alignments":[{"framework":"teks","code":"A.6B","role":"primary","evidenceLevel":"assessed"},{"framework":"digitalSAT","domainId":"advancedMath","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"digitalSAT","examStyle":true,"domainId":"advancedMath"},"courseId":"algebra1","familyId":"mathmaster:sat:A.6B:ccmr-challenge-challenge-standard-to-vertex-parameter","familyVersion":1,"questionType":"response","activityRole":"practice","difficultyBand":5,"dok":3,"calculatorPolicy":"graphing","assessedConstruct":"A.6B","taskType":"equivalentRepresentation","representation":"standardToVertex","ccmrChallengeTier":2,"ccmrFamilyRole":"challenge","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"authoredChallenge":true,"officialSkillFamily":"nonlinear functions","stemProfile":"challenge-standard-to-vertex-parameter"},"prompt":"The quadratic $f(x)=x^2-{{twoh}}x {{c|signed}}$ can be written as $f(x)=(x-h)^2 {{k|signed}}$. What is t