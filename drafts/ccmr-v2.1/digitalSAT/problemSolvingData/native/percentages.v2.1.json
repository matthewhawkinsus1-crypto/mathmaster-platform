ice", "expected": "choice-c"}]}, {"id": "mm_sat_native_pct_4_percent-change_v21", "active": true, "alignmentKeys": ["digitalSAT:problemSolvingData:percentages"], "alignments": [{"framework": "digitalSAT", "domainId": "problemSolvingData", "skillFamily": "percentages", "role": "primary", "evidenceMode": "direct"}], "assessmentContext": {"framework": "digitalSAT", "examStyle": true, "domainId": "problemSolvingData", "nativeSkillId": "percentages"}, "familyId": "mathmaster:sat:native:percentages:percent-change", "familyVersion": 2, "questionType": "response", "activityRole": "practice", "difficultyBand": 3, "dok": 2, "calculatorPolicy": "graphing", "assessedConstruct": "digitalSAT:problemSolvingData:percentages", "taskType": "percentChange", "representation": "values", "ccmrChallengeTier": 1, "ccmrFamilyRole": "direct", "ccmrAuthenticLanguage": {"version": "2.1", "authored": true, "nativeSkillId": "percentages", "officialSkillFamily": "percentages", "stemProfile": "percent-change"}, "attemptFeedback": ["Use the stated percent as a fraction of 100 and keep track of which quantity is the original, part, or new amount."], "supportHints": ["A percent increase or decrease is applied to the original amount. Reverse-percent questions require undoing that multiplier."], "solutionReview": {"headline": "Divide the increase by the original value: ${{p}}\\%$.", "reasoning": ["The increase is ${{new}}-{{old}}={{points}}$.", "As a fraction of the original: $\\frac{{{points}}}{{{old}}}=\\frac{{{p}}}{100}$, so the increase is ${{p}}\\%$."], "commonError": "Dividing by the new value, or giving the new value as a percent of the old one ({{grow}}%).", "answerSummary": "${{p}}\\%$"}, "prompt": "A value increases from {{old}} to {{new}}. What is the percent increase?", "generator": {"parameters": {"p": {"type": "choice", "values": [10, 20, 40, 50]}, "k": {"type": "int", "min": 1, "max": 10}}, "derived": {"old": "20*k", "new": "20*k*(100+p)/100", "grow": "100+p", "half": "p/2", "points": "2