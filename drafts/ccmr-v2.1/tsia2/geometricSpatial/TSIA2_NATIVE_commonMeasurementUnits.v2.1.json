d2","label":"{{height}} miles"},{"id":"tsia2-d3","label":"{{height}} gallons"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"tsia2-correct"}]},{"id":"mm_tsia2_gsr_cmu_7_v21","active":true,"alignmentKeys":[],"alignments":[{"framework":"tsia2","domainId":"geometricSpatial","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"tsia2","examStyle":true,"domainId":"geometricSpatial","nativeSkillId":"commonMeasurementUnits","tsia2TestScope":"diagnosticOnly"},"familyId":"mathmaster:tsia2:native:commonMeasurementUnits:reasonable-drink-capacity","familyVersion":1,"questionType":"response","activityRole":"practice","difficultyBand":2,"dok":2,"examCalculatorMode":"none","assessedConstruct":"TSIA2-native:commonMeasurementUnits","taskType":"reasonableDrinkCapacity","representation":"measurement-reasonableness","ccmrChallengeTier":2,"ccmrFamilyRole":"challenge","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"authoredChallenge":true,"nativeSkillId":"commonMeasurementUnits","officialSkillFamily":"common measurement units","stemProfile":"reasonable-bottle-capacity","answerChoiceCount":4},"supportHints":["A single drink bottle holds less than a liter or about that amount, not hundreds of liters."],"solutionReview":{"headline":"A drink bottle holds about half a liter: {{capacity}} milliliters.","reasoning":["Capacity is a volume, so kilograms (mass) and meters (length) are out.","{{capacity}} milliliters is $\\frac{ {{capacity}} }{1000}={{liters}}$ of a liter, a usual bottle size. {{capacity}} liters would fill a bathtub several times over."],"commonError":"Picking liters because liters measure volume, without checking the size.","answerSummary":"{{capacity}} milliliters"},"prompt":"Which of the following could reasonably be the capacity of a drink bottle?","generator":{"parameters":{"capacity":{"type":"int","min":250,"max":900}},"derived":{"liters":"capacity/1000"}},"assessmentItemFormat":"multipleChoice","choices":[{"id":"tsia2-correct","label":"{{capacity}} milliliters"},{"id":"tsia2-d1","label":"{{capacity}} liters"},{"id":"tsia2-d2","label":"{{capacity}} kilograms"},{"id":"tsia2-d3","label":"{{capacity}} meters"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"tsia2-correct"}]},{"id":"mm_tsia2_gsr_cmu_8_v21","active":true,"alignmentKeys":[],"alignments":[{"framework":"tsia2","domainId":"geometricSpatial","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"tsia2","examStyle":true,"domainId":"geometricSpatial","nativeSkillId":"commonMeasurementUnits","tsia2TestScope":"diagnosticOnly"},"familyId":"mathmaster:tsia2:native:commonMeasurementUnits:floor-area-unit","familyVersion":1,"questionType":"response","activityRole":"practice","difficultyBand":2,"dok":2,"examCalculatorMode":"none","assessedConstruct":"TSIA2-native:commonMeasurementUnits","taskType":"floorAreaUnit","representation":"measurement-dimension-sense","ccmrChallengeTier":2,"ccmrFamilyRole":"challenge","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"authoredChallenge":true,"nativeSkillId":"commonMeasurementUnits","officialSkillFamily":"common measurement units","stemProfile":"reasonable-floor-area-unit","answerChoiceCount":4},"supportHints":["Area is measured in square units."],"solutionReview":{"headline":"Area is measured in square units: {{area}} square feet.","reasoning":["Area counts squares that cover the floor, so it needs square units.","Feet measure length, cubic feet measure volume and ounces measure weight; only square feet measure area, and {{area}} square feet is a reasonable room size."],"commonError":"Using plain feet, which measure length rather than area.","answerSummary":"{{area}} square feet"},"prompt":"A room has a floor area of about {{area}} units. Which choice gives a reasonable measurement for that area?","generator":{"parameters":{"area":{"type":"int","min":100,"max":500}}},"as