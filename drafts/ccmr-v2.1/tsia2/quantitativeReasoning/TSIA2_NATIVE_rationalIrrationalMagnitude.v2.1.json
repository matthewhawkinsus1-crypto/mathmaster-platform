.","reasoning":["$(\\sqrt{ {{radPlus}} }+\\sqrt{ {{radMinus}} })^2={{tn2}}+2\\sqrt{ {{n4k}} }$.","$\\sqrt{ {{n4k}} }<\\sqrt{ {{n4}} }={{n2}}$, so $(p+q)^2<{{tn2}}+2\\cdot {{n2}}={{twice}}^2$ and $p+q<{{twice}}$.","$p-q$ is less than 1 because $p$ and $q$ are both close to {{n}}, and $q-p$ is negative. So {{twice}} is the greatest."],"commonError":"Assuming $p+q$ equals {{twice}} because $p$ and $q$ are both close to {{n}}.","answerSummary":"${{twice}}$"},"prompt":"Let $p=\\sqrt{ {{radPlus}} }$ and $q=\\sqrt{ {{radMinus}} }$. Which expression has the greatest value?","generator":{"parameters":{"n":{"type":"int","min":4,"max":12},"k":{"type":"int","min":1,"max":3}},"derived":{"radPlus":"n*n+k","radMinus":"n*n-k","twice":"2*n","n2":"n*n","n4":"n^4","n4k":"n^4-k*k","tn2":"2*n*n"},"constraints":["radMinus>0"]},"assessmentItemFormat":"multipleChoice","choices":[{"id":"tsia2-correct","label":"${{twice}}$"},{"id":"tsia2-d1","label":"$p+q$"},{"id":"tsia2-d2","label":"$p-q$"},{"id":"tsia2-d3","label":"$q-p$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"tsia2-correct"}]},{"id":"mm_tsia2_qr_rim_8_v21","active":true,"alignmentKeys":[],"alignments":[{"framework":"tsia2","domainId":"quantitativeReasoning","role":"primary","evidenceMode":"direct"}],"assessmentContext":{"framework":"tsia2","examStyle":true,"domainId":"quantitativeReasoning","nativeSkillId":"rationalIrrationalMagnitude","tsia2TestScope":"crcAndDiagnostic"},"familyId":"mathmaster:tsia2:native:rationalIrrationalMagnitude:conjugate-rationality","familyVersion":1,"questionType":"response","activityRole":"practice","difficultyBand":4,"dok":3,"examCalculatorMode":"squareRoot","assessedConstruct":"TSIA2-native:rationalIrrationalMagnitude","taskType":"conjugateRationality","representation":"symbolic","ccmrChallengeTier":2,"ccmrFamilyRole":"challenge","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"nativeSkillId":"rationalIrrationalMagnitude","officialSkillFamily":"rational and irrational numbers and magnitude","stemProfile":"conjugate-rationality","answerChoiceCount":4,"authoredChallenge":true},"supportHints":["Compare or rewrite the values in a common form before deciding which relationship is true."],"solutionReview":{"headline":"A sum times a difference removes the square root.","reasoning":["$(a+b)(a-b)=a^2-b^2$, so the product is $(\\sqrt{ {{nonSquare}} })^2-{{c}}^2={{nonSquare}}-{{c2}}={{nc}}$, an integer.","The other three are irrational: an irrational number plus, times or divided by a nonzero rational number stays irrational.","The rational one is $(\\sqrt{ {{nonSquare}} }+{{c}})(\\sqrt{ {{nonSquare}} }-{{c}})$."],"commonError":"Thinking a product of two irrational numbers must be irrational.","answerSummary":"$(\\sqrt{ {{nonSquare}} }+{{c}})(\\sqrt{ {{nonSquare}} }-{{c}})$"},"prompt":"Exactly one expression below has a rational value. Which one is it?","generator":{"parameters":{"nonSquare":{"type":"choice","values":[2,3,5,6,7,10,11,12,13,14,15]},"c":{"type":"int","min":1,"max":5}},"derived":{"c2":"c*c","nc":"nonSquare-c*c"},"constraints":[]},"assessmentItemFormat":"multipleChoice","choices":[{"id":"tsia2-correct","label":"$(\\sqrt{ {{nonSquare}} }+{{c}})(\\sqrt{ {{nonSquare}} }-{{c}})$"},{"id":"tsia2-d1","label":"$\\sqrt{ {{nonSquare}} }+{{c}}$"},{"id":"tsia2-d2","label":"${{c}}\\sqrt{ {{nonSquare}} }$"},{"id":"tsia2-d3","label":"$\\frac{\\sqrt{ {{nonSquare}} }}{ {{c}} }$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"tsia2-correct"}]}]}
