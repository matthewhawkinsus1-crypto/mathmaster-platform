:native:rationalIrrationalMagnitude:combine-like-radicals","familyVersion":1,"questionType":"response","activityRole":"practice","difficultyBand":3,"dok":2,"examCalculatorMode":"basic","assessedConstruct":"TSIA2-native:rationalIrrationalMagnitude","taskType":"combineLikeRadicals","representation":"symbolic","ccmrChallengeTier":1,"ccmrFamilyRole":"direct","ccmrAuthenticLanguage":{"version":"2.1","authored":true,"nativeSkillId":"rationalIrrationalMagnitude","officialSkillFamily":"rational and irrational numbers and magnitude","stemProfile":"combine-like-radicals","answerChoiceCount":4},"supportHints":["Compare or rewrite the values in a common form before deciding which relationship is true."],"solutionReview":{"headline":"Like radicals combine like like terms: ${{sum}}\\sqrt{ {{radicand}} }$.","reasoning":["Both terms have $\\sqrt{ {{radicand}} }$, so add the coefficients.","${{a}}\\sqrt{ {{radicand}} }+{{b|coef}}\\sqrt{ {{radicand}} }=({{a}}+{{b}})\\sqrt{ {{radicand}} }={{sum}}\\sqrt{ {{radicand}} }$."],"commonError":"Multiplying the coefficients, or adding the radicands under one root.","answerSummary":"${{sum}}\\sqrt{ {{radicand}} }$"},"prompt":"What is the value of ${{a}}\\sqrt{ {{radicand}} }+{{b}}\\sqrt{ {{radicand}} }$ after the like radicals are combined?","generator":{"parameters":{"a":{"type":"int","min":2,"max":8},"b":{"type":"int","min":1,"max":7},"radicand":{"type":"choice","values":[2,3,5,6,7,10,11,13]}},"derived":{"sum":"a+b","product":"a*b","difference":"abs(a-b)","plain":"sum*radicand"},"constraints":["a!=b","sum!=product"]},"assessmentItemFormat":"multipleChoice","choices":[{"id":"tsia2-correct","label":"${{sum}}\\sqrt{ {{radicand}} }$"},{"id":"tsia2-d1","label":"${{product}}\\sqrt{ {{radicand}} }$"},{"id":"tsia2-d2","label":"${{plain}}$"},{"id":"tsia2-d3","label":"${{difference}}\\sqrt{ {{radicand}} }$"}],"responseFields":[{"id":"answer","label":"Choose the correct answer","inputProfile":"choice","expected":"tsia2-correct"}]},{"id":"mm_tsia2_qr_rim