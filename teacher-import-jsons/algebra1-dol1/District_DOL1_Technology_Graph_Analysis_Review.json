        {
          "standard": "A.12C",
          "dok": 2,
          "difficultyBand": 3,
          "prompt": "An arithmetic sequence starts at 7 and each term is 4 more than the term before it. Find the second, third and fifth terms.",
          "studentActions": [
            "multipleResponses"
          ],
          "sequence": {
            "kind": "arithmetic",
            "first": 7,
            "commonDifference": 4
          },
          "answerFields": [
            {
              "id": "a2",
              "label": "a(2)",
              "answer": "11"
            },
            {
              "id": "a3",
              "label": "a(3)",
              "answer": "15"
            },
            {
              "id": "a5",
              "label": "a(5)",
              "answer": "23"
            }
          ],
          "scaffold": {
            "prompt": "Let’s back up. In this sequence, how do you get from one term to the next?",
            "options": [
              "Add 4",
              "Multiply by 4"
            ],
            "correct": "Add 4"
          },
          "solutionReview": {
            "headline": "Each term is the one before it plus 4: start at 7 and add 4 until you reach the term you need.",
            "reasoning": [
              "a(2): add 4 to the first term: 7 + 4 = 11.",
              "a(3): add 4 again: 11 + 4 = 15.",
              "a(5): two more steps of 4: a(4) = 15 + 4 = 19, so a(5) = 19 + 4 = 23."
            ],
            "answerSummary": "a(2) = 11, a(3) = 15 and a(5) = 23."
          }
        },
