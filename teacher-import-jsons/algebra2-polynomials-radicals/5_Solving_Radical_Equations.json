          "questionFamily": {
            "scope": "assignment"
          },
          "scaffold": {
            "prompt": "Let’s back up. Multiplying powers with the same base, you…",
            "options": [
              "add the exponents",
              "multiply the exponents"
            ],
            "correct": "add the exponents"
          },
          "solutionReview": {
            "headline": "Add the exponents.",
            "reasoning": [
              "w^({{a}}/{{n}}) · w^({{b}}/{{n}}) = w^(({{a}} + {{b}})/{{n}}).",
              "({{a}} + {{b}})/{{n}} = {{kn}}/{{n}} = {{k}}, so the product is w^{{k}}."
            ],
            "answerSummary": "w^{{k}}",
            "commonError": "Multiplying the exponents instead of adding them."
          }
        },
