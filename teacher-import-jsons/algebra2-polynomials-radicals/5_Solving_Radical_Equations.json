            {
              "id": "value",
              "label": "Value",
              "answer": "{{v}}",
              "inputProfile": "number"
            }
          ],
          "hints": [
            "Take the root first (the denominator {{n}} is the index), then raise it to the power {{m}}."
          ],
          "scaffold": {
            "prompt": "Let’s back up. In b^(m/n), the root you take is the…",
            "options": [
              "nth root",
              "mth root"
            ],
            "correct": "nth root"
          },
          "generator": {
            "parameters": {
              "n": {
                "type": "int",
                "min": 2,
                "max": 4
              },
              "c": {
                "type": "int",
                "min": 2,
                "max": 9
              },
              "m": {
                "type": "int",
                "min": 2,
                "max": 4
              }
            },
            "derived": {
              "b": "c^n",
              "v": "c^m"
            },
            "constraints": [
              "c^n <= 1000",
              "c^m <= 1000",
              "gcd(m, n) == 1"
            ]
          },
          "questionFamily": {
            "scope": "assignment"
          },
          "solutionReview": {
            "headline": "Root first, then the power.",
            "reasoning": [
              "{{b}}^(1/{{n}}) = {{c}}, because {{c}}^{{n}} = {{b}}.",
              "Raise it to the power {{m}}: {{b}}^({{m}}/{{n}}) = {{v}}."
            ],
            "answerSummary": "{{v}}",
            "commonError": "Raising {{b}} to the power {{m}} before taking the root makes the numbers much larger; the root first keeps them small."
          }
        },
        {
          "questionId": "sr-wu-2",
          "standard": "A2.7G",
          "alignments": [
            {
              "framework": "teks",
              "code": "A2.7G",
