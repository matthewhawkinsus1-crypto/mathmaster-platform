node_modules
dist
*-debug.log
.firebase

# Deployment environment. `VITE_MATHMASTER_EXECUTION_MODE` decides whether a
# build talks to the secure Path or refuses to run, so it is set per deployment
# and never committed — a checked-in value would follow the repo into somebody
# else's environment and quietly configure it.
.env
.env.local
.env.*.local

# Firestore emulator artefacts
firebase-debug.log
firestore-debug.log
ui-debug.log

# Project snapshots. Uploading a whole-project zip into the repo adds megabytes
# to every clone forever, and invites someone to unpack it over the working
# tree — which silently reverts whatever landed after the zip was cut. Hand
# packages to the coding session directly instead.
*.zip

# One-off analysis scripts belong in a scratch directory, not at the repo root.
check_module1.mjs

# Rendered screenshots from the browser gates. 18MB per Work View matrix run,
# regenerated from scratch every time: they belong in a CI artifact, where they
# can be looked at, and not in every clone forever. The findings JSON beside
# them IS committed — that is the part the ordinary suite asserts.
tests/browser/artifacts/
.playwright-mcp/
dist-harness
release-reports

# Written by the FIRST predeploy step of each Functions codebase
# (scripts/write-functions-provenance.mjs): the commit a deploy was made from.
# Generated on every deploy, so never committed — but deliberately NOT in the
# codebases' `ignore` lists in firebase.json, because the Firebase CLI packages
# by those lists, not by this file, and the deployed functions read it.
functions/deploy-provenance.json
functions-path-admin/deploy-provenance.json

# Student identity audit/backfill reports (scripts/student-identity-repair.mjs).
# Counts-only by default, but --list-ids adds student ids and --include-names
# adds student names: never commit them. Runbook:
# docs/handoffs/STUDENT_IDENTITY_REPAIR_RUNBOOK.md
identity-reports/

# My Math Path choice-id report detail (scripts/report-path-choice-id-regrade.mjs).
# Lists student ids (never names): never commit it.
path-choice-reports/

# Job K classroom re-grade report detail (scripts/report-classroom-regrade-candidates.mjs).
# Lists student ids and their submitted work (never names): never commit it.
classroom-regrade-reports/
