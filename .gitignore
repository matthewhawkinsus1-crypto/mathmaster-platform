node_modules
dist
*-debug.log
.firebase

# Deployment environment. `VITE_MATHMASTER_EXECUTION_MODE` decides whether a
# build talks to the secure Path or refuses to run, so it is set per deployment
# and never committed — a checked-in value would follow the repo into somebody
# else's environment and quietly configure it.
.env
.env.local
.env.*.local

# Firestore emulator artefacts
firebase-debug.log
firestore-debug.log
ui-debug.log

# Project snapshots. Uploading a whole-project zip into the repo adds megabytes
# to every clone forever, and invites someone to unpack it over the working
# tree — which silently reverts whatever landed after the zip was cut. Hand
# packages to the coding session directly instead.
*.zip

# One-off analysis scripts belong in a scratch directory, not at the repo root.
check_module1.mjs
