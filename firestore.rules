rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function teacher() {
      return signedIn() && request.auth.token.role == 'teacher';
    }

    function ownsStudent(studentId) {
      return signedIn()
        && request.auth.token.role == 'student'
        && request.auth.token.studentId == studentId;
    }

    // Student work: students can read/update only their own document. Teachers
    // can manage the roster. Students cannot delete their permanent record.
    match /grades/{studentId} {
      allow read: if teacher() || ownsStudent(studentId);
      allow create, update: if teacher() || ownsStudent(studentId);
      // Permanent roster deletion is callable-only. Even a root-admin browser
      // must use the audited server erasure path so related data is not orphaned.
      allow delete: if false;

      match /scratchpads/{scratchpadId} {
        allow read: if teacher() || ownsStudent(studentId);
        allow create, update: if teacher() || ownsStudent(studentId);
        allow delete: if teacher();
      }

      // Phase 5C evidence is append-only from the student client. Production
      // My Math Path writes through the Admin SDK and bypasses these rules.
      match /evidenceEvents/{eventId} {
        allow read: if teacher() || ownsStudent(studentId);
        allow create: if ownsStudent(studentId)
          && request.resource.data.studentId == studentId
          && request.resource.data.eventKey == eventId;
        allow update, delete: if false;
      }
    }

    // Shared instructional content is readable after sign-in. Only teachers
    // can mutate assignments, schedules, and the secure path question bank.
    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if teacher();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if teacher();
    }

    match /pathQuestionBank/{questionId} {
      allow read, create, update, delete: if teacher();
    }

    // Phase 6A private modeling criteria are never student-readable. Teachers
    // author them; grading reads them through the Admin SDK callable.
    match /modelingLabDefinitions/{labId} {
      allow read, create, update, delete: if teacher();
    }

    // Phase 6C exam item answer keys are teacher-authored. Runtime sessions,
    // responses, integrity logs, and submission markers are callable-only so
    // a student cannot bypass the server state machine with a direct write.
    match /examQuestionBank/{questionId} {
      allow read, create, update, delete: if teacher();
    }

    // Students can read their derived Phase 5 state but cannot forge it.
    match /studentMasteryProfiles/{studentId} {
      allow read: if teacher() || ownsStudent(studentId);
      allow write: if teacher();
    }

    match /studentRetentionSchedules/{studentId} {
      allow read: if teacher() || ownsStudent(studentId);
      allow write: if teacher();
    }

    // Authentication internals, Classroom integration, My Math Path sessions,
    // idempotency records, and mastery-application markers are server-only.
    match /teacherIntegrations/{docId} { allow read, write: if false; }
    match /oauthStates/{stateId} { allow read, write: if false; }
    match /classroomLinks/{publicationId} { allow read, write: if false; }
    match /classroomRosterLinks/{rosterLinkId} { allow read, write: if false; }
    match /classroomGradeSyncs/{syncId} { allow read, write: if false; }
    match /studentCredentials/{docId} { allow read, write: if false; }
    match /studentAliases/{docId} { allow read, write: if false; }
    match /studentDirectory/{docId} { allow read, write: if false; }
    match /teacherDirectory/{docId} { allow read, write: if false; }
    match /classJoinCodes/{docId} { allow read, write: if false; }
    match /authThrottle/{docId} { allow read, write: if false; }
    match /activePathLocks/{docId} { allow read, write: if false; }
    match /pathSessions/{docId} { allow read, write: if false; }
    match /pathSubmissions/{docId} { allow read, write: if false; }
    match /masteryEvidenceApplications/{docId} { allow read, write: if false; }
    match /modelingLabSubmissions/{docId} { allow read, write: if false; }
    match /examSessions/{docId} { allow read, write: if false; }
    match /examSubmissions/{docId} { allow read, write: if false; }
    match /examIntegrityEvents/{docId} { allow read, write: if false; }
    match /adminAuditLog/{docId} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
