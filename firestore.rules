rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /liveChallengeAchievementJobs/{jobId} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function teacher() {
      return signedIn() && request.auth.token.get('role', '') == 'teacher';
    }

    function rootAdmin() {
      return teacher()
        && request.auth.token.get('admin', false) == true
        && request.auth.token.get('rootAdmin', false) == true;
    }

    function ownsStudent(studentId) {
      return signedIn()
        && request.auth.token.get('role', '') == 'student'
        && request.auth.token.get('studentId', '') == studentId;
    }

    // A teacher's roster is the students in the classes they are teacher of
    // record for. `assignedTeacherEmail` is written onto the student by the
    // admin callables whenever their class or its teacher changes, and is read
    // here rather than following classId into the classes collection: a rule
    // that called get() per document would break any roster over ten students.
    //
    // A student with no class has no assignedTeacherEmail and so belongs to no
    // teacher — only the root administrator can see them, which is what makes
    // unplaced students findable and resolvable.
    function teachesStudent() {
      return teacher()
        && resource.data.get('assignedTeacherEmail', null) == request.auth.token.email;
    }

    // The same question for a child record — evidence, mastery, a scratchpad —
    // answered from the record itself for the same reason: a get() per document
    // would break any query over ten of them.
    //
    // The list holds the teacher this work happened under, who keeps access
    // because they are still accountable for it, and the student's current
    // teacher, who needs the history to teach them. See the policy note in
    // functions/shared/authorizationContext.mjs.
    function authorizedTeacher() {
      // hasAny works for both a stored list on a single-document get and the
      // LIST_CONTAINS constraint Firestore exposes while proving an
      // array-contains query. Using "in" here makes individual gets work but
      // list queries fail even when they use the exact authorized-teacher
      // constraint.
      return teacher()
        && resource.data.authorizedTeacherEmails.hasAny([request.auth.token.email]);
    }

    // Presence is readable only for a student the signed-in teacher currently
    // teaches. Live presence is intentionally NOT a school-wide teacher feed.
    function teachesPresenceStudent(studentId) {
      return teacher()
        && get(/databases/$(database)/documents/grades/$(studentId)).data.get('assignedTeacherEmail', null)
          == request.auth.token.email;
    }

    // "Ask my teacher" (src/platform/supports/helpRequest.js): a time and a
    // question position, nothing else — no text a student could use to
    // message through the teacher's monitor.
    function presenceHelpRequestValid(data) {
      return (!data.keys().hasAny(['helpRequestedAt']) || (data.helpRequestedAt is int && data.helpRequestedAt > 0))
        && (!data.keys().hasAny(['helpQuestionIndex']) || (data.helpQuestionIndex is int && data.helpQuestionIndex >= 0 && data.helpQuestionIndex < 1000))
        && !data.keys().hasAny(['helpMessage', 'helpNote', 'helpText']);
    }

    function presenceCarriesNoResponse(data) {
      return !data.keys().hasAny([
        'response', 'responses', 'rawResponse', 'answer', 'answerState',
        'keystrokes', 'screenshot', 'screen', 'url', 'browserHistory'
      ]);
    }

    // Roster membership is authorization, not ordinary grade/profile data.
    // Client updates may change student work fields, but moving a student or
    // changing their teacher must go through the audited Admin SDK callables.
    /*
     * THE RECORDED TEST CYCLE GRADE IS SERVER-DERIVED.
     *
     * `grades/{studentId}` is updatable by the teacher of record (the repair
     * flows their client runs) and, for one engagement field only, by the
     * student who owns it (studentChangesOnlyClientOwnedFields below). The Test
     * Cycle projection written there is different in kind: it is the single
     * source the Grade Center, the teacher gradebook and Google Classroom
     * passback all read, it is written ONLY by the secure release path, and
     * writing it is what wakes `syncGradeToClassroom`.
     *
     * Left open, a client with a console could set a recorded grade and have
     * the platform post it to Google Classroom on the student's behalf. So the
     * map is pinned from EVERY client exactly the way the roster fields are.
     * The Admin SDK bypasses rules, so the server release path is unaffected.
     */
    function testCycleGradesUnchanged() {
      return request.resource.data.get('testCycleGrades', {})
        == resource.data.get('testCycleGrades', {});
    }

    /*
     * A create has no prior document to compare against, so "unchanged" cannot
     * express the invariant there. The equivalent is that a client may not
     * bring the document INTO EXISTENCE with a recorded grade already in it:
     * before the row exists, an owner's `setDoc` is otherwise a blank cheque
     * for the very map the update rule above pins.
     */
    function testCycleGradesAbsentOnCreate() {
      return request.resource.data.get('testCycleGrades', {}) == {};
    }

    /*
     * PRACTICE-BASED RECOVERY IS SERVER-DERIVED, ON THE SAME CLIENT-WRITABLE DOC.
     *
     * `sectionRecoveryByAssignment` holds each Warm-Up/DOL Recovery: the
     * server-graded Practice evidence that unlocked it, its plan and its raw
     * score. The recorded grade the Grade Center, the gradebook, Grade
     * Transfer and Classroom passback show is derived from it, so a student
     * who could write it could raise their own DOL. Only the
     * `advanceSectionRecovery` callable (Admin SDK, rules bypassed) writes it.
     *
     * `warmupChallengeByAssignment` is the Live Challenge Warm-Up credit,
     * written only by the server's match finalization effects
     * (writeWarmupCreditFromResult, Admin SDK). Recovery reads it to
     * recognise a Warm-Up delivered as a Live Challenge, so it is pinned the
     * same way; no client has ever written it.
     */
    function serverRecoveryFieldsUnchanged() {
      return request.resource.data.get('sectionRecoveryByAssignment', {})
          == resource.data.get('sectionRecoveryByAssignment', {})
        && request.resource.data.get('warmupChallengeByAssignment', {})
          == resource.data.get('warmupChallengeByAssignment', {});
    }

    function serverRecoveryFieldsAbsentOnCreate() {
      return request.resource.data.get('sectionRecoveryByAssignment', {}) == {}
        && request.resource.data.get('warmupChallengeByAssignment', {}) == {};
    }

    /*
     * TEACHER GRADE OVERRIDES ARE SERVER-AUTHORITATIVE.
     *
     * Canonical question records remain client-writable for the teacher of
     * record's existing repair workflows, so an override cannot live inside a
     * question record that a browser may rewrite. The server stores the active
     * override in this top-level map and every client update must preserve it
     * byte-for-byte. The audited Admin SDK callables (overrideStudentResponseGrade,
     * overrideStudentAssignmentGrade) bypass rules and are the only writers.
     */
    function teacherGradeOverridesUnchanged() {
      return request.resource.data.get('teacherGradeOverridesByAssignment', {})
        == resource.data.get('teacherGradeOverridesByAssignment', {});
    }

    function teacherGradeOverridesAbsentOnCreate() {
      return request.resource.data.get('teacherGradeOverridesByAssignment', {}) == {};
    }

    /*
     * A STUDENT'S DEVICE MAY CHANGE EXACTLY ONE FIELD OF THEIR GRADE DOCUMENT.
     *
     * The grade document holds the canonical question records
     * (`gradesByAssignment`) and every projection the server derives from
     * them — Classwork completion, the DOL projection, support usage, the
     * Classroom release signals and receipts. Google Classroom passback, the
     * Grade Center, the teacher gradebook, Grade Transfer and server
     * ingestion's own attempt policy all read them. Since Student Persistence
     * V3 and server grading (#247, #412) every one of them is written by the
     * server, so a student's client has no business writing any of them —
     * and while the old rule ("the owner may update, except these pinned
     * maps") let it, a console could mark questions correct, reset an
     * exhausted attempt count, or force a final Classroom release.
     *
     * So the student branch is an ALLOW-LIST, not a list of pinned fields.
     * The only field a student's own client may change is `assignmentActivity`:
     * engagement time, which only the browser can measure. Everything else —
     * a canonical record or any field inside one, a projection, a release
     * signal, a receipt, or a field nothing reads yet — is refused, whether
     * the write is an update, a merge, a batch or a transaction, and whatever
     * the field path is spelled as. A value re-sent unchanged is not a change.
     *
     * Ordinary work still reaches the record: the durable outbox delivers it
     * to `ingestStudentSubmissions`, which authenticates the student, grades
     * the raw response and applies the attempt policy on the server.
     *
     * Mirrors STUDENT_CLIENT_OWNED_GRADE_FIELDS in
     * functions/shared/gradeDocumentAuthority.mjs; a parity test keeps them
     * equal (tests/platform/gradeDocumentAuthority.test.mjs).
     */
    function studentClientOwnedGradeFields() {
      return ['assignmentActivity'];
    }

    function studentChangesOnlyClientOwnedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(studentClientOwnedGradeFields());
    }

    /*
     * A row a student creates for themselves may not be born holding grade
     * state: before the row exists, an owner's `setDoc` would otherwise be a
     * blank cheque for exactly the fields the update rule protects.
     *
     * Create gets the same allow-list idea as update — there is just no prior
     * document to diff against. A student's create may carry only the roster
     * placement it has always carried (pinned from then on by the update
     * rule), the support-profile slot (empty), the engagement field, and the
     * grade maps — and those must be empty. Mirrors STUDENT_CREATE_FIELDS and
     * GRADE_FIELDS_EMPTY_ON_STUDENT_CREATE (the Test Cycle, override and
     * Recovery maps also have their own create checks below, for every creator).
     */
    function studentCreateFields() {
      return [
        'classId', 'classPeriod', 'assignedTeacherEmail', 'status', 'profile', 'assignmentActivity',
        'gradesByAssignment', 'classworkGradesByAssignment', 'dolGradesByAssignment', 'supportUsageByAssignment',
        'classroomReleaseSignals', 'classroomSyncStatusByAssignment', 'classroomSectionSyncStatusByAssignment',
        'testCycleGrades', 'teacherGradeOverridesByAssignment', 'sectionRecoveryByAssignment', 'warmupChallengeByAssignment'
      ];
    }

    function serverOwnedGradeStateAbsentOnStudentCreate() {
      return request.resource.data.keys().hasOnly(studentCreateFields())
        && request.resource.data.get('gradesByAssignment', {}) == {}
        && request.resource.data.get('classworkGradesByAssignment', {}) == {}
        && request.resource.data.get('dolGradesByAssignment', {}) == {}
        && request.resource.data.get('supportUsageByAssignment', {}) == {}
        && request.resource.data.get('classroomReleaseSignals', {}) == {}
        && request.resource.data.get('classroomSyncStatusByAssignment', {}) == {}
        && request.resource.data.get('classroomSectionSyncStatusByAssignment', {}) == {};
    }

    function rosterAuthorizationUnchanged() {
      return request.resource.data.get('classId', null) == resource.data.get('classId', null)
        && request.resource.data.get('classPeriod', null) == resource.data.get('classPeriod', null)
        && request.resource.data.get('assignedTeacherEmail', null)
          == resource.data.get('assignedTeacherEmail', null);
    }

    // SIS identity is an administrative/export identity, not student work.
    // Only audited Admin SDK callables may add or change it. This prevents a
    // student (or a normal grade update) from changing the TEAMS import key.
    function sisIdentityUnchanged() {
      return request.resource.data.get('sisStudentId', null) == resource.data.get('sisStudentId', null)
        && request.resource.data.get('sisStudentIdVerifiedAt', null) == resource.data.get('sisStudentIdVerifiedAt', null)
        && request.resource.data.get('sisStudentIdVerifiedBy', null) == resource.data.get('sisStudentIdVerifiedBy', null);
    }

    function sisIdentityAbsentOnClientCreate() {
      return !request.resource.data.keys().hasAny([
        'sisStudentId', 'sisStudentIdVerifiedAt', 'sisStudentIdVerifiedBy'
      ]);
    }

    /*
     * A STUDENT'S NAME IS SERVER-OWNED.
     *
     * The canonical name (firstName, lastName, displayName), every legacy and
     * Google Classroom copy the name resolver reads, the Google identity a
     * Classroom link copies, and the provenance of a correction or backfill are
     * written only by audited Admin SDK callables (createStudentAccount,
     * setStudentName, the Classroom link callables, the identity backfill),
     * which bypass these rules. A browser that could rewrite them could rename
     * a student, put an ID where a name belongs, or erase the only name a
     * legacy record has. No client writes any of them.
     *
     * The list mirrors SERVER_OWNED_IDENTITY_FIELDS in
     * functions/shared/studentIdentity.mjs; a parity test keeps them equal
     * (tests/platform/studentIdentityServerContract.test.mjs).
     */
    function serverOwnedIdentityFields() {
      return [
        'firstName', 'lastName', 'displayName', 'googleName', 'name', 'studentName',
        'googleEmail', 'googleUserId', 'identityBackfill', 'nameUpdatedAt', 'nameUpdatedBy'
      ];
    }

    function studentIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedIdentityFields());
    }

    function studentIdentityAbsentOnClientCreate() {
      return !request.resource.data.keys().hasAny(serverOwnedIdentityFields());
    }

    /*
     * THE SUPPORT PROFILE IS STAFF-AUTHORED.
     *
     * `profile` is the student-readable projection of their support plan
     * (functions/shared/supportProfileModel.mjs). The student's own runtime
     * applies it, the server derives entitlements and individualized deadlines
     * from it, and the support evidence report reads it — so the student it
     * describes must not be able to grant, remove or backdate their own
     * supports. The only client writer is the teacher of record (a revision
     * and this projection in one batch); the Admin SDK bypasses rules.
     */
    function supportProfileUnchanged() {
      return request.resource.data.get('profile', null) == resource.data.get('profile', null);
    }

    function supportProfileAbsentOnStudentCreate() {
      return request.resource.data.get('profile', {}) == {};
    }

    // --- Support evidence helpers (grades/{studentId}/support* subcollections) ---
    //
    // Every record is immutable, carries server time (== request.time), names
    // its author when staff wrote it, and is authorized to the student's
    // teacher of record at write time. Field lists mirror
    // functions/shared/supportEvidenceModel.mjs and supportProfileModel.mjs.

    function rosterRow(studentId) {
      return get(/databases/$(database)/documents/grades/$(studentId)).data;
    }

    function staffForStudent(studentId) {
      return rootAdmin() || teachesPresenceStudent(studentId);
    }

    function optionalString(data, key, maxSize) {
      return data.get(key, null) == null || (data.get(key, null) is string && data.get(key, '').size() <= maxSize);
    }

    function isDateKeyString(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function staffAuthorship(data, emailKey) {
      return data.get(emailKey, null) == request.auth.token.email
        && data.authorizedTeacherEmails == [request.auth.token.email];
    }

    // A staff record is filed under the student's real class (or none, for the
    // root administrator resolving an unplaced student).
    function classMatchesRoster(data, studentId) {
      return data.get('classId', null) == rosterRow(studentId).get('classId', null)
        || (rootAdmin() && data.get('classId', null) == null);
    }

    function supportRevisionValid(studentId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'schemaVersion', 'studentId', 'classId', 'revision', 'supersedesRevisionId', 'legacySnapshot',
          'status', 'effectiveStart', 'effectiveEnd', 'sourceLabel', 'sourceNote', 'inclusionStatus',
          'accommodations', 'modifications', 'serviceExpectations', 'translationLanguage',
          'createdByEmail', 'authorizedTeacherEmails', 'createdAt'
        ])
        && d.keys().hasAll([
          'schemaVersion', 'studentId', 'revision', 'status', 'sourceLabel', 'accommodations',
          'modifications', 'createdByEmail', 'authorizedTeacherEmails', 'createdAt'
        ])
        && d.schemaVersion == 1
        && d.studentId == studentId
        && d.revision is int && d.revision >= 0 && d.revision < 100000
        && d.status in ['active', 'inactive']
        && d.sourceLabel is string && d.sourceLabel.size() > 0 && d.sourceLabel.size() <= 120
        && optionalString(d, 'sourceNote', 600)
        && optionalString(d, 'supersedesRevisionId', 160)
        && optionalString(d, 'translationLanguage', 12)
        && d.get('inclusionStatus', false) is bool
        && d.get('legacySnapshot', false) is bool
        && d.accommodations is list && d.accommodations.size() <= 40
        && d.modifications is list && d.modifications.size() <= 40
        && (d.get('serviceExpectations', null) == null
          || (d.serviceExpectations is list && d.serviceExpectations.size() <= 6))
        // Only the one-time snapshot of a pre-versioning profile may be undated.
        && (isDateKeyString(d.get('effectiveStart', null)) || d.get('legacySnapshot', false) == true)
        && (d.get('effectiveEnd', null) == null || isDateKeyString(d.get('effectiveEnd', null)))
        && staffAuthorship(d, 'createdByEmail')
        && d.createdAt == request.time
        && classMatchesRoster(d, studentId);
    }

    function optionalIntIn(data, key, minValue, maxValue) {
      return data.get(key, null) == null
        || (data.get(key, null) is int && data.get(key, minValue) >= minValue && data.get(key, maxValue) <= maxValue);
    }

    function optionalStringIn(data, key, values) {
      return data.get(key, null) == null || data.get(key, '') in values;
    }

    // A record's compact, typed facts (functions/shared/supportEvidenceModel.mjs
    // EVIDENCE_DETAIL_FIELDS): what a reduced-item projection delivered, which
    // language resource a translation came from, why a support was
    // unavailable. Bounded so no record can carry question text, answers or a
    // copy of the profile.
    function evidenceDetailsValid(d) {
      let details = d.get('details', null);
      return details == null || (
        details is map
        && details.keys().hasOnly([
          'targetPercent', 'originalCount', 'assignedCount', 'actualPercentTenths', 'variance',
          'contentFingerprint', 'algorithmVersion', 'omittedIndices', 'language', 'provider',
          'coverage', 'deliveryMode', 'surface', 'toolType', 'reason', 'itemCount'
        ])
        && optionalIntIn(details, 'targetPercent', 0, 100)
        && optionalIntIn(details, 'originalCount', 0, 1000)
        && optionalIntIn(details, 'assignedCount', 0, 1000)
        && optionalIntIn(details, 'actualPercentTenths', 0, 1000)
        && optionalIntIn(details, 'algorithmVersion', 0, 99)
        && optionalIntIn(details, 'itemCount', 0, 1000)
        && (details.get('variance', null) == null || (details.get('variance', []) is list && details.get('variance', []).size() <= 8
          && details.get('variance', []).hasOnly([
            'rounding', 'too-few-items', 'coverage', 'indivisible-group', 'answered-before-reduction',
            'practice-pass', 'limited-to-activities', 'secure-assessment'
          ])))
        // At most 200 indices of up to three digits, as "1,5,9".
        && (details.get('omittedIndices', null) == null || (details.get('omittedIndices', '') is string
          && details.get('omittedIndices', '').matches('^[0-9]{1,3}(,[0-9]{1,3}){0,199}$')))
        && optionalString(details, 'contentFingerprint', 16)
        && optionalString(details, 'language', 12)
        && optionalString(details, 'provider', 32)
        && optionalString(details, 'toolType', 40)
        && optionalString(details, 'reason', 48)
        && optionalStringIn(details, 'coverage', ['full', 'partial', 'none'])
        && optionalStringIn(details, 'deliveryMode', ['automatic', 'on-demand'])
        && optionalStringIn(details, 'surface', ['assignment', 'path', 'rich-tool', 'enlarged'])
      );
    }

    function supportEvidenceCommonValid(studentId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'schemaVersion', 'studentId', 'classId', 'assignmentId', 'activityRole', 'questionIndex',
          'supportId', 'classification', 'profileRevisionId', 'eventType', 'source', 'actorType',
          'actorEmail', 'providerRole', 'note', 'durationSeconds', 'voidsEventId', 'details',
          'authorizedTeacherEmails', 'occurredAt'
        ])
        && evidenceDetailsValid(d)
        && d.keys().hasAll([
          'schemaVersion', 'studentId', 'supportId', 'classification', 'eventType', 'source',
          'actorType', 'authorizedTeacherEmails', 'occurredAt'
        ])
        && d.schemaVersion == 1
        && d.studentId == studentId
        && d.supportId is string && d.supportId.size() > 0 && d.supportId.size() <= 160
        && d.classification in ['accommodation', 'modification', 'service']
        && d.occurredAt == request.time
        && optionalString(d, 'assignmentId', 160)
        && optionalString(d, 'profileRevisionId', 160)
        && optionalString(d, 'voidsEventId', 160)
        && (d.get('activityRole', null) == null
          || d.get('activityRole', null) in ['warmup', 'classwork', 'practice', 'dol', 'quiz', 'test'])
        && (d.get('questionIndex', null) == null
          || (d.get('questionIndex', null) is int && d.get('questionIndex', -1) >= 0 && d.get('questionIndex', 1000) < 1000))
        && (d.get('durationSeconds', null) == null
          || (d.get('durationSeconds', null) is int && d.get('durationSeconds', 0) > 0 && d.get('durationSeconds', 0) <= 86400));
    }

    // A correction may withdraw only a staff record its own author wrote: a
    // later teacher cannot erase an earlier teacher's documentation from the
    // counts. The withdrawn record itself is never touched.
    function voidTargetIsOwnStaffRecord(studentId, eventId) {
      let target = /databases/$(database)/documents/grades/$(studentId)/supportEvidence/$(eventId);
      return exists(target)
        && get(target).data.get('actorType', '') in ['teacher', 'provider']
        && get(target).data.get('actorEmail', null) == request.auth.token.email;
    }

    function voidTargetIsOwnServiceEntry(studentId, entryId) {
      let target = /databases/$(database)/documents/grades/$(studentId)/supportServiceLog/$(entryId);
      return exists(target)
        && get(target).data.get('createdByEmail', null) == request.auth.token.email;
    }

    // Staff: one-click classroom actions, provider entries, determinations.
    function staffSupportEvidenceValid(studentId) {
      let d = request.resource.data;
      return staffForStudent(studentId)
        && d.eventType in ['teacher-documented', 'provider-documented', 'provided', 'declined', 'not-applicable']
        && d.source in ['teacher-click', 'provider-entry', 'existing-platform-event']
        && d.actorType in ['teacher', 'provider']
        && staffAuthorship(d, 'actorEmail')
        && (d.get('providerRole', null) == null || d.get('providerRole', null) in [
          'teacher-of-record', 'inclusion-teacher', 'special-education-teacher', 'paraprofessional',
          'related-service-provider', 'other'
        ])
        && (d.actorType != 'provider' || d.get('providerRole', null) != null)
        && d.get('details', null) == null
        && optionalString(d, 'note', 280)
        && (d.get('voidsEventId', null) == null || voidTargetIsOwnStaffRecord(studentId, d.get('voidsEventId', '')))
        && classMatchesRoster(d, studentId);
    }

    // The student's own client: platform telemetry about supports the student
    // is actually entitled to — never a staff fact, a note, or another class.
    function studentSupportEvidenceValid(studentId) {
      let d = request.resource.data;
      let roster = rosterRow(studentId);
      let profile = roster.get('profile', {});
      return ownsStudent(studentId)
        && d.eventType in ['available', 'provided', 'activated', 'used', 'not-applicable', 'unavailable']
        // Only the platform's own evaluations can be negative facts: a client
        // must never silence a "no staff record" gap for any other support.
        && (!(d.eventType in ['not-applicable', 'unavailable']) || d.supportId in [
          'reduced-item-count-same-rigor', 'text-to-speech', 'translation', 'glossary-lookup', 'chunked-directions', 'sentence-frames'
        ])
        && d.source == 'automatic-telemetry'
        && d.actorType in ['student', 'system']
        && d.get('actorEmail', null) == null
        && d.get('providerRole', null) == null
        && d.get('note', '') == ''
        && d.get('voidsEventId', null) == null
        && roster.get('assignedTeacherEmail', null) is string
        && d.authorizedTeacherEmails == [roster.get('assignedTeacherEmail', null)]
        && d.get('classId', null) == roster.get('classId', null)
        && (
          d.supportId in profile.get('accommodations', [])
          || d.supportId in profile.get('modifications', [])
          || d.supportId in profile.get('supportPlan', {}).get('entitledIds', [])
          // A pre-versioning profile authorizes translation by its language
          // alone (a versioned one lists it in entitledIds).
          || (d.supportId == 'translation' && profile.get('translationLanguage', null) is string
            && profile.get('translationLanguage', '').matches('^[a-z]{2,3}(-[a-z0-9]{2,8})?$')
            && !profile.get('translationLanguage', '').matches('^en(-.*)?$'))
          || (profile.get('inclusionStatus', false) == true && d.supportId in [
            'declutter-ui', 'visual-chunking', 'high-contrast', 'large-text', 'no-countdown', 'disable-idle-timer'
          ])
        );
    }

    // "Optional notes can be added after": the author of a staff record may
    // fill its EMPTY note once, within 15 minutes, and the time they did so is
    // recorded. Nothing else about the record — what, when, who — can change.
    function staffNoteAfterValid(studentId) {
      let before = resource.data;
      let after = request.resource.data;
      return staffForStudent(studentId)
        && before.get('actorEmail', null) == request.auth.token.email
        && before.get('actorType', '') in ['teacher', 'provider']
        && before.get('note', '') == ''
        && after.diff(before).affectedKeys().hasOnly(['note', 'noteAddedAt'])
        && after.note is string && after.note.size() > 0 && after.note.size() <= 280
        && after.noteAddedAt == request.time
        && request.time < before.occurredAt + duration.value(15, 'm');
    }

    // An imported gradebook snapshot saved with one student's case file
    // (Student Case Review). Staff only, immutable, one student's rows only —
    // the browser drops every other student before saving. Field list mirrors
    // functions/shared/sisGradebookSnapshot.mjs buildSisSnapshotDocument.
    function sisGradebookSnapshotValid(studentId) {
      let d = request.resource.data;
      return staffForStudent(studentId)
        && d.keys().hasOnly([
          'schemaVersion', 'studentId', 'classId', 'fileName', 'layout', 'matchedBy', 'items', 'categories',
          'categoryAverages', 'officialAverage', 'confirmedMatches', 'importedByEmail', 'authorizedTeacherEmails', 'importedAt'
        ])
        && d.keys().hasAll([
          'schemaVersion', 'studentId', 'layout', 'matchedBy', 'items', 'importedByEmail', 'authorizedTeacherEmails', 'importedAt'
        ])
        && d.schemaVersion == 1
        && d.studentId == studentId
        && d.layout in ['wide', 'long', 'mathmaster-teams']
        && d.matchedBy in ['sis-id', 'mathmaster-id', 'teacher-confirmed-row']
        && d.items is list && d.items.size() > 0 && d.items.size() <= 300
        && d.get('categories', []) is list && d.get('categories', []).size() <= 30
        && d.get('categoryAverages', []) is list && d.get('categoryAverages', []).size() <= 30
        && (d.get('officialAverage', null) == null || d.get('officialAverage', null) is number)
        && d.get('confirmedMatches', {}) is map && d.get('confirmedMatches', {}).size() <= 300
        && optionalString(d, 'fileName', 160)
        && staffAuthorship(d, 'importedByEmail')
        && d.importedAt == request.time
        && classMatchesRoster(d, studentId);
    }

    function serviceLogEntryValid(studentId) {
      let d = request.resource.data;
      return staffForStudent(studentId)
        && d.keys().hasOnly([
          'schemaVersion', 'studentId', 'classId', 'dateKey', 'startMinute', 'endMinute', 'minutes',
          'serviceType', 'classification', 'providerRole', 'providerLabel', 'assignmentId', 'topic',
          'note', 'voidsEntryId', 'createdByEmail', 'authorizedTeacherEmails', 'createdAt'
        ])
        && d.keys().hasAll([
          'schemaVersion', 'studentId', 'dateKey', 'minutes', 'serviceType', 'classification',
          'providerRole', 'createdByEmail', 'authorizedTeacherEmails', 'createdAt'
        ])
        && d.schemaVersion == 1
        && d.studentId == studentId
        && isDateKeyString(d.dateKey)
        && d.minutes is int && d.minutes >= 0 && d.minutes <= 600
        // Zero minutes only as a correction that voids an earlier entry.
        && (d.minutes > 0 || d.get('voidsEntryId', null) != null)
        && d.serviceType in [
          'inclusion-support', 'co-teaching', 'paraprofessional-support', 'small-group-instruction', 'other-service'
        ]
        && d.classification == 'service'
        && d.providerRole in [
          'teacher-of-record', 'inclusion-teacher', 'special-education-teacher', 'paraprofessional',
          'related-service-provider', 'other'
        ]
        && (d.get('startMinute', null) == null
          || (d.get('startMinute', null) is int && d.get('startMinute', -1) >= 0 && d.get('startMinute', 1440) < 1440))
        && (d.get('endMinute', null) == null
          || (d.get('endMinute', null) is int && d.get('endMinute', 0) > 0 && d.get('endMinute', 1441) <= 1440))
        && optionalString(d, 'providerLabel', 80)
        && optionalString(d, 'assignmentId', 160)
        && optionalString(d, 'topic', 120)
        && optionalString(d, 'note', 280)
        && optionalString(d, 'voidsEntryId', 160)
        && (d.get('voidsEntryId', null) == null || voidTargetIsOwnServiceEntry(studentId, d.get('voidsEntryId', '')))
        && staffAuthorship(d, 'createdByEmail')
        && d.createdAt == request.time
        && classMatchesRoster(d, studentId);
    }

    // The active-engagement ledger: the only minute a client may add is the
    // one the server clock is in (or the one before, for latency). A student
    // cannot backdate, pre-fill or replay minutes, and a second tab adding the
    // same minute changes nothing.
    function currentEpochMinute() {
      return int(request.time.toMillis() / 60000);
    }

    function engagementCreateValid(studentId, ledgerId) {
      let d = request.resource.data;
      let minute = currentEpochMinute();
      return d.keys().hasOnly(['schemaVersion', 'studentId', 'assignmentId', 'utcDay', 'minutes', 'lastRecordedAt'])
        && d.keys().hasAll(['schemaVersion', 'studentId', 'assignmentId', 'utcDay', 'minutes', 'lastRecordedAt'])
        && d.schemaVersion == 1
        && d.studentId == studentId
        && d.assignmentId is string && d.assignmentId.size() > 0 && d.assignmentId.size() <= 160
        && d.utcDay is int
        && (d.utcDay == int(request.time.toMillis() / 86400000)
          || d.utcDay == int((request.time.toMillis() - 60000) / 86400000))
        && ledgerId == d.assignmentId + '__' + string(d.utcDay)
        && d.lastRecordedAt == request.time
        && d.minutes is list && d.minutes.size() >= 1 && d.minutes.size() <= 2
        && d.minutes.toSet().hasOnly([minute, minute - 1]);
    }

    function engagementUpdateValid() {
      let d = request.resource.data;
      let minute = currentEpochMinute();
      return d.diff(resource.data).affectedKeys().hasOnly(['minutes', 'lastRecordedAt'])
        && d.lastRecordedAt == request.time
        && d.minutes is list && d.minutes.size() <= 1440
        && d.minutes.toSet().hasAll(resource.data.minutes)
        && d.minutes.toSet().difference(resource.data.minutes.toSet()).hasOnly([minute, minute - 1]);
    }

    // Student work: students read only their own document and change only its
    // client-owned engagement field (studentChangesOnlyClientOwnedFields); a
    // teacher only their own students; the root administrator the school.
    // Permanent account deletion is never a client permission — even the root
    // administrator must use the audited server callable that removes the
    // student's complete cross-collection footprint.
    match /grades/{studentId} {
      allow read: if rootAdmin() || ownsStudent(studentId) || teachesStudent();
      allow update: if (rootAdmin() || teachesStudent()
          || (ownsStudent(studentId) && supportProfileUnchanged() && studentChangesOnlyClientOwnedFields()))
        && rosterAuthorizationUnchanged()
        && sisIdentityUnchanged()
        && studentIdentityUnchanged()
        && testCycleGradesUnchanged()
        && teacherGradeOverridesUnchanged()
        && serverRecoveryFieldsUnchanged();
      // Creation stays open to any teacher: a roster row may be written before
      // the student has been placed in a class, and it carries no work yet.
      // "No work yet" is enforced, not assumed, for the one field that is
      // server-derived — otherwise the update rule's guarantee lasts only until
      // someone deletes and recreates the row, or creates it for the first time.
      allow create: if (teacher()
          || (ownsStudent(studentId) && supportProfileAbsentOnStudentCreate() && serverOwnedGradeStateAbsentOnStudentCreate()))
        && sisIdentityAbsentOnClientCreate()
        && studentIdentityAbsentOnClientCreate()
        && testCycleGradesAbsentOnCreate()
        && teacherGradeOverridesAbsentOnCreate()
        && serverRecoveryFieldsAbsentOnCreate();
      allow delete: if false;

      /*
       * STUDENT SUPPORT PROFILE HISTORY — privileged and immutable.
       * Source labels, notes and service expectations live here, never on the
       * student-readable roster row. A change is a new revision.
       */
      match /supportProfileRevisions/{revisionId} {
        allow read: if rootAdmin() || teachesPresenceStudent(studentId) || authorizedTeacher();
        allow create: if staffForStudent(studentId) && supportRevisionValid(studentId);
        allow update, delete: if false;
      }

      // Support evidence events: staff documentation and the student's own
      // platform telemetry. Students cannot read them (teacher notes, provider
      // roles) and nobody can edit or delete one.
      match /supportEvidence/{eventId} {
        allow read: if rootAdmin() || teachesPresenceStudent(studentId) || authorizedTeacher();
        allow create: if supportEvidenceCommonValid(studentId)
          && (staffSupportEvidenceValid(studentId) || studentSupportEvidenceValid(studentId));
        allow update: if staffNoteAfterValid(studentId);
        allow delete: if false;
      }

      // Service / support minutes. A correction is a new entry that voids an
      // older one; nothing is edited or deleted.
      match /supportServiceLog/{entryId} {
        allow read: if rootAdmin() || teachesPresenceStudent(studentId) || authorizedTeacher();
        allow create: if serviceLogEntryValid(studentId);
        allow update, delete: if false;
      }

      // Student Case Review: a gradebook snapshot the teacher chose to save with
      // this student's case file. Read-only analysis — nothing reads it to
      // change a grade. Students cannot read it; nobody can edit or delete it.
      match /sisGradebookSnapshots/{snapshotId} {
        allow read: if rootAdmin() || teachesPresenceStudent(studentId) || authorizedTeacher();
        allow create: if sisGradebookSnapshotValid(studentId);
        allow update, delete: if false;
      }

      // Attendance-extension grants: why a student's deadline moved (absence
      // dates, meetings, the granting teacher). One immutable record per
      // grant, written only by `applyStudentAttendanceExtension` and the
      // privacy migration (Admin SDK). The shared assignment document keeps
      // only the deadline (functions/shared/assignmentPrivacy.mjs). Staff
      // only: classmates never could need this, and the student's own screens
      // read only their deadline.
      match /attendanceExtensionGrants/{grantId} {
        allow read: if rootAdmin() || teachesPresenceStudent(studentId) || authorizedTeacher();
        allow create, update, delete: if false;
      }

      // The history of a student's assignment controls: one immutable entry
      // per change (who, before, after), the verbatim shared-copy data each
      // migration step moved, and the student's share of the DOL recovery
      // audit. Staff only — it names who granted what — and written only by
      // the Admin SDK (studentAssignmentOverrides.mjs).
      match /assignmentOverrideEvents/{eventId} {
        allow read: if rootAdmin() || teachesPresenceStudent(studentId) || authorizedTeacher();
        allow create, update, delete: if false;
      }

      // Server-timed active-engagement minutes, one ledger per assignment per
      // UTC day. Written only by the student's own client, only ever growing.
      match /engagementMinutes/{ledgerId} {
        allow read: if rootAdmin() || teachesPresenceStudent(studentId);
        allow create: if ownsStudent(studentId) && engagementCreateValid(studentId, ledgerId);
        allow update: if ownsStudent(studentId) && engagementUpdateValid();
        allow delete: if false;
      }

      /*
       * Immutable teacher correction audit. The inspector reads it through the
       * authenticated callable, so no browser needs direct access and no client
       * can forge, edit, or delete an audit entry.
       */
      match /gradeOverrideAudits/{auditId} {
        allow read, write: if false;
      }

      // Exact submitted-response/grader snapshots are Admin-SDK evidence.
      // Keeping them off the client-readable grade document prevents a student
      // from forging the evidence a teacher later uses for replay or diagnosis.
      match /responseInspectionEvidence/{evidenceId} {
        allow read, write: if false;
      }

      match /scratchpads/{scratchpadId} {
        allow read: if rootAdmin() || ownsStudent(studentId) || authorizedTeacher();
        allow create, update: if rootAdmin() || ownsStudent(studentId) || authorizedTeacher();
        allow delete: if rootAdmin() || authorizedTeacher();
      }

      // Attempt evidence is written ONLY by the Admin SDK (assignment
      // ingestion, the checkpoint finalizer, My Math Path, Live Challenge,
      // modeling labs, secure exams — all server paths that bypass rules).
      //
      // It used to be creatable from the student client with no schema, and
      // the mastery trigger (updateMyMathPathMasteryFromEvidence) credits what
      // it reads here: a student could mint "mastered" evidence, or copy an
      // arbitrary teacher onto their mastery profile. The only client writer
      // was dead code and has been removed, so creation is now closed.
      match /evidenceEvents/{eventId} {
        allow read: if rootAdmin() || ownsStudent(studentId) || authorizedTeacher();
        allow create, update, delete: if false;
      }

      // Misconception evidence from Section Recovery and Recovery Practice
      // items (functions/shared/misconceptionEvidenceSites.mjs). Teacher
      // evidence, never a grade: written only by the advanceSectionRecovery
      // callable (Admin SDK) and read only by the case review callable
      // (loadStudentCaseEvidence), which authorizes the teacher. No browser
      // reads or writes it — a forged record could otherwise become evidence,
      // and a student's own codes are not shown to students.
      match /misconceptionEvidence/{recordId} {
        allow read, write: if false;
      }
    }

    // Persistent teacher support / intervention history. This is deliberately
    // separate from live presence: presence is ephemeral telemetry, while these
    // records are the small set of signals, teacher confirmations, dismissals,
    // interventions and follow-up actions worth keeping.
    //
    // Records are append-only. A machine signal is never edited into a teacher
    // finding later; confirmation/dismissal/resolution is a new event. That
    // preserves the audit distinction between "the system suggested" and "the
    // teacher observed".
    match /studentSupportEvents/{eventId} {
      allow read: if rootAdmin() || authorizedTeacher();
      allow create: if rootAdmin() || (
        teacher()
        && request.resource.data.studentId is string
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.authorizedTeacherEmails is list
        // A teacher may not mint a record that grants another teacher access.
        // Reassignment adds the next authorized teacher through the audited
        // Admin SDK path later, while preserving the original teacher.
        && request.resource.data.authorizedTeacherEmails.size() == 1
        && request.auth.token.email in request.resource.data.authorizedTeacherEmails
        && get(/databases/$(database)/documents/grades/$(request.resource.data.studentId)).data.get('assignedTeacherEmail', null) == request.auth.token.email
        && (
          (
            get(/databases/$(database)/documents/grades/$(request.resource.data.studentId)).data.get('classId', null) != null
            && request.resource.data.get('classId', null)
              == get(/databases/$(database)/documents/grades/$(request.resource.data.studentId)).data.get('classId', null)
          )
          || (
            get(/databases/$(database)/documents/grades/$(request.resource.data.studentId)).data.get('classId', null) == null
            && request.resource.data.get('classPeriod', null)
              == get(/databases/$(database)/documents/grades/$(request.resource.data.studentId)).data.get('classPeriod', null)
          )
        )
      );
      allow update, delete: if false;
    }

    // Private parent-contact records. They are deliberately separate from the
    // student-readable grade tree and append-only. The fixed schema prevents
    // response/grader evidence from being copied into this human contact log.
    match /parentContactLogs/{contactId} {
      allow read: if rootAdmin() || authorizedTeacher();
      allow create: if rootAdmin() || (
        teacher()
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'studentId', 'studentName', 'classId', 'classPeriod',
          'occurredAt', 'method', 'category', 'notes', 'outcome', 'followUpDate',
          'recordType', 'parentContactId', 'createdByEmail', 'originTeacherEmail',
          'originClassId', 'authorizedTeacherEmails',
          'createdAt', 'createdAtServer'
        ])
        && request.resource.data.studentId is string
        && request.resource.data.recordType in ['contact', 'followUpResolution']
        && (request.resource.data.recordType == 'contact' || request.resource.data.parentContactId is string)
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.originTeacherEmail == request.auth.token.email
        && request.resource.data.originClassId == request.resource.data.classId
        && request.resource.data.authorizedTeacherEmails == [request.auth.token.email]
        && request.resource.data.method in ['phone', 'email', 'text', 'conference', 'voicemail', 'other']
        && request.resource.data.category in ['academics', 'missingWork', 'attendance', 'behavior', 'academicIntegrity', 'cellphone', 'positiveContact', 'other']
        && get(/databases/$(database)/documents/grades/$(request.resource.data.studentId)).data.get('assignedTeacherEmail', null) == request.auth.token.email
        && request.resource.data.get('classId', null) == get(/databases/$(database)/documents/grades/$(request.resource.data.studentId)).data.get('classId', null)
      );
      allow update, delete: if false;
    }

    // One temporary student-facing Path recommendation created only through
    // the audited teacher callable. Students may read their own instructional
    // recommendation; teachers may read only their current roster. Private
    // concern/reason notes never live here.
    match /studentPathInterventions/{studentId} {
      allow read: if rootAdmin() || ownsStudent(studentId) || teachesPresenceStudent(studentId);
      allow create, update, delete: if false;
    }

    // Compact server-generated session summaries. Students never write or read
    // these directly. They contain only counts/durations already visible to the
    // teacher in Live Class — no answers, URLs, screenshots or keystrokes.
    match /studentSessionSummaries/{summaryId} {
      allow read: if rootAdmin() || authorizedTeacher();
      allow create, update, delete: if false;
    }

    // Class Points: a classroom participation reward currency, scoped to
    // studentId + classId. It is NOT assignment credit, mastery, Live
    // Challenge score, or evidence of proficiency, and it never touches any
    // of those. See functions/shared/classPoints.mjs for the domain model.
    //
    // Every balance-changing write goes through awardClassPoints/
    // reverseClassPointAward on the Admin SDK, which bypasses these rules —
    // what the rules guarantee is the other direction: no client, not even
    // the root administrator, may write the ledger, the account projection,
    // or the idempotency record directly. A client that could write the
    // account could award itself points; a client that could write the
    // ledger could forge or erase the history behind it.
    //
    // Reads reuse `authorizedTeacherEmails`, the exact field
    // functions/shared/authorizationContext.mjs already uses for evidence and
    // support history, so a teacher's access here rises and falls with the
    // same roster reassignment logic instead of a second, parallel notion of
    // "this teacher's student."
    match /classPointAccounts/{accountId} {
      allow read: if rootAdmin() || ownsStudent(resource.data.studentId) || authorizedTeacher();
      allow create, update, delete: if false;
    }

    match /classPointTransactions/{transactionId} {
      allow read: if rootAdmin() || ownsStudent(resource.data.studentId) || authorizedTeacher();
      allow create, update, delete: if false;
    }

    // Idempotency records map a caller-supplied requestId to the transaction
    // it produced. They carry no student-facing information and exist purely
    // so a retried award cannot double-write; no client ever needs to read
    // one directly.
    match /classPointIdempotencyKeys/{idempotencyKey} {
      allow read, write: if false;
    }

    // Reward redemptions (Practice Pass, and any future reward) are the
    // server-written record of a spend already reflected in
    // classPointTransactions/classPointAccounts above. A student may read
    // only their own; the teacher of record for the redemption's own class
    // may read it for visibility into their roster. Nobody may create,
    // modify, or delete one from the client -- only the redemption callable
    // (Admin SDK, functions/index.js `redeemPracticePass`) may grant a
    // waiver.
    match /classPointRewardRedemptions/{redemptionId} {
      allow read: if rootAdmin()
        || ownsStudent(resource.data.studentId)
        || (teacher()
          && get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherOfRecord == request.auth.token.email);
      allow create, update, delete: if false;
    }

    // Item rewards a student holds — a Practice Pass, a badge — each its own
    // document with its own available/redeemed/expired/revoked history (see
    // functions/shared/rewardGrants.mjs). Issued only by the server from a
    // finished match's reward rules. A student reads their own; teachers read
    // through the same authorizedTeacherEmails field the ledger uses. No client
    // may issue, spend, revoke or erase one.
    match /rewardGrants/{grantId} {
      allow read: if rootAdmin() || ownsStudent(resource.data.studentId) || authorizedTeacher();
      allow create, update, delete: if false;
    }

    // Live class monitoring. Ephemeral by design: a student's client writes
    // its own document on a heartbeat and deletes it on leaving, and nothing
    // reads it outside the teacher's live grid. It carries no response text —
    // only which question the student is on and how many are right — so a
    // teacher reading it learns no more than walking past the desk.
    match /presence/{studentId} {
      allow read: if rootAdmin() || teachesPresenceStudent(studentId);
      // A teacher observes presence; only the student owns the heartbeat. This
      // prevents one teacher client from fabricating or clearing another
      // student's live telemetry.
      allow create, update: if ownsStudent(studentId)
        && presenceCarriesNoResponse(request.resource.data)
        && presenceHelpRequestValid(request.resource.data);
      allow delete: if ownsStudent(studentId);
    }

    // One authoritative, teacher-owned pace/timer document per walkthrough.
    // It contains no roster or answer data and is intentionally unreadable by
    // students; projector output is an allow-listed client projection.
    match /walkthroughSessions/{sessionId} {
      // A first-ever walkthrough has no document yet. Allow an authenticated
      // teacher to perform that single-document existence check without making
      // any existing teacher-owned session readable to another teacher.
      allow get: if rootAdmin() || (teacher() && (
        !exists(/databases/$(database)/documents/walkthroughSessions/$(sessionId))
        || resource.data.ownerUid == request.auth.uid
      ));
      allow list: if rootAdmin() || (teacher() && resource.data.ownerUid == request.auth.uid);
      allow create: if rootAdmin() || (teacher()
        && request.resource.data.sessionId == sessionId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.teacherEmail == request.auth.token.email
        && !request.resource.data.keys().hasAny([
          'students', 'studentNames', 'grades', 'responses', 'answers',
          'evidence', 'mastery', 'attemptHistory'
        ]));
      allow update: if rootAdmin() || (teacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.teacherEmail == resource.data.teacherEmail
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.assignmentId == resource.data.assignmentId
        && !request.resource.data.keys().hasAny([
          'students', 'studentNames', 'grades', 'responses', 'answers',
          'evidence', 'mastery', 'attemptHistory'
        ]));
      allow delete: if rootAdmin() || (teacher() && resource.data.ownerUid == request.auth.uid);
    }

    /*
     * Student Spotlight is deliberately separate from presence and private
     * workspace recovery. A request contains authorization/consent only; the
     * answer-bearing frame cannot exist until that request is affirmatively
     * accepted, and becomes unreadable as soon as it stops or expires.
     */
    function spotlightClassTeacher(classId) {
      return teacher()
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherOfRecord
          == request.auth.token.email;
    }

    function spotlightStudentInClass(studentId, classId) {
      return get(/databases/$(database)/documents/grades/$(studentId)).data.classId == classId;
    }

    function spotlightRequestTeacherCurrent(data) {
      return get(/databases/$(database)/documents/classes/$(data.classId)).data.teacherOfRecord
        == data.teacherEmail;
    }

    function activeSpotlightRequest(requestId) {
      let spotlight = get(/databases/$(database)/documents/liveSpotlightRequests/$(requestId)).data;
      return spotlight.status == 'accepted'
        && spotlight.expiresAt > request.time
        && spotlightRequestTeacherCurrent(spotlight)
        && spotlightStudentInClass(spotlight.studentId, spotlight.classId);
    }

    match /liveSpotlightRequests/{requestId} {
      allow create: if rootAdmin() || (
        spotlightClassTeacher(request.resource.data.classId)
        && spotlightStudentInClass(request.resource.data.studentId, request.resource.data.classId)
        && request.resource.data.requestId == requestId
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherEmail == request.auth.token.email
        && request.resource.data.status == 'requested'
        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentId.size() > 0
        && request.resource.data.requestedAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(5, 'm')
      );
      allow read: if rootAdmin()
        || ownsStudent(resource.data.studentId)
        || (spotlightClassTeacher(resource.data.classId)
          && resource.data.teacherEmail == request.auth.token.email
          && spotlightStudentInClass(resource.data.studentId, resource.data.classId));
      allow update: if rootAdmin()
        || (ownsStudent(resource.data.studentId)
          && resource.data.status == 'requested'
          && resource.data.expiresAt > request.time
          && spotlightRequestTeacherCurrent(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.respondedAt == request.time)
        || (ownsStudent(resource.data.studentId)
          && resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'stoppedAt', 'stoppedBy'])
          && request.resource.data.status == 'stopped'
          && request.resource.data.stoppedAt == request.time
          && request.resource.data.stoppedBy == 'student')
        || (spotlightClassTeacher(resource.data.classId)
          && resource.data.teacherEmail == request.auth.token.email
          && spotlightStudentInClass(resource.data.studentId, resource.data.classId)
          && resource.data.status in ['requested', 'accepted']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'stoppedAt', 'stoppedBy'])
          && request.resource.data.status == 'stopped'
          && request.resource.data.stoppedAt == request.time
          && request.resource.data.stoppedBy == 'teacher');
      allow delete: if false;
    }

    match /liveSpotlightFrames/{requestId} {
      allow read: if rootAdmin() || (
        activeSpotlightRequest(requestId)
        && spotlightClassTeacher(
          get(/databases/$(database)/documents/liveSpotlightRequests/$(requestId)).data.classId
        )
      );
      allow create, update: if ownsStudent(request.resource.data.studentId)
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'requestId', 'studentId', 'assignmentId',
          'assignmentTitle', 'questionIndex', 'studentLabel', 'question',
          'work', 'truncated', 'updatedAtMs', 'updatedAt', 'expiresAt'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion', 'requestId', 'studentId', 'assignmentId',
          'assignmentTitle', 'questionIndex', 'studentLabel', 'question',
          'work', 'updatedAtMs', 'updatedAt', 'expiresAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.requestId == requestId
        && request.resource.data.studentId
          == get(/databases/$(database)/documents/liveSpotlightRequests/$(requestId)).data.studentId
        && request.resource.data.assignmentId
          == get(/databases/$(database)/documents/liveSpotlightRequests/$(requestId)).data.assignmentId
        && request.resource.data.expiresAt
          == get(/databases/$(database)/documents/liveSpotlightRequests/$(requestId)).data.expiresAt
        && activeSpotlightRequest(requestId)
        && request.resource.data.updatedAt == request.time;
      // Content is removed at either party's stop path. The request remains as
      // a content-free session receipt, but an inactive request never grants a
      // frame read or write.
      allow delete: if ownsStudent(resource.data.studentId)
        || rootAdmin()
        || spotlightClassTeacher(
          get(/databases/$(database)/documents/liveSpotlightRequests/$(requestId)).data.classId
        ) && get(/databases/$(database)/documents/liveSpotlightRequests/$(requestId)).data.teacherEmail
          == request.auth.token.email;
    }

    // Live Challenge. All writes go through Cloud Functions so a student can
    // never post their own score or inspect an answer-bearing round record.
    // Each student gets one small invite pointer; that pointer is also the
    // membership proof the room read rule checks.
    match /liveChallengeInvites/{studentId} {
      allow read: if ownsStudent(studentId);
      allow create, update, delete: if false;
    }

    match /liveChallengeRooms/{roomId} {
      allow read: if rootAdmin()
        || (teacher() && resource.data.teacherEmail == request.auth.token.email)
        || (signedIn()
          && request.auth.token.role == 'student'
          && get(/databases/$(database)/documents/liveChallengeInvites/$(request.auth.token.studentId)).data.roomId == roomId);
      allow create, update, delete: if false;

      // Anonymous per-player standings are separate documents so a whole class
      // can answer at once without every response contending on one hot room
      // document. They contain only game aliases and score/progress counters.
      //
      // The student screen now listens to its OWN row only, and gets the
      // class's standings from the one snapshot below. Reading a classmate's
      // row stays allowed in this release so that a screen loaded before it
      // (which still lists every row) keeps working until it reloads; the
      // tightening to own-row-only is a later, separate rules deploy
      // (docs/handoffs/LIVE_CHALLENGE_STANDINGS_SCALE_2026-10-05.md).
      match /players/{playerKey} {
        allow read: if rootAdmin()
          || (teacher() && get(/databases/$(database)/documents/liveChallengeRooms/$(roomId)).data.teacherEmail == request.auth.token.email)
          || (signedIn()
            && request.auth.token.role == 'student'
            && get(/databases/$(database)/documents/liveChallengeInvites/$(request.auth.token.studentId)).data.roomId == roomId);
        allow create, update, delete: if false;
      }

      // The class's standings snapshot (standings/current): game aliases,
      // ranks and scores only, written by the server. Read by exactly the
      // audience of the room.
      match /standings/{snapshotId} {
        allow read: if rootAdmin()
          || (teacher() && get(/databases/$(database)/documents/liveChallengeRooms/$(roomId)).data.teacherEmail == request.auth.token.email)
          || (signedIn()
            && request.auth.token.role == 'student'
            && get(/databases/$(database)/documents/liveChallengeInvites/$(request.auth.token.studentId)).data.roomId == roomId);
        allow create, update, delete: if false;
      }

      // Anonymous round results — alias, rank, round points, placement points —
      // written once when a round closes. Readable by exactly the audience of
      // the standings above; they carry no student id.
      match /rounds/{roundIndex} {
        allow read: if rootAdmin()
          || (teacher() && get(/databases/$(database)/documents/liveChallengeRooms/$(roomId)).data.teacherEmail == request.auth.token.email)
          || (signedIn()
            && request.auth.token.role == 'student'
            && get(/databases/$(database)/documents/liveChallengeInvites/$(request.auth.token.studentId)).data.roomId == roomId);
        allow create, update, delete: if false;
      }

      // Per-device health is visible to the room owner only. Students may read
      // standings, but never another student's network/device diagnostics.
      match /diagnostics/{playerKey} {
        allow read: if rootAdmin()
          || (teacher() && get(/databases/$(database)/documents/liveChallengeRooms/$(roomId)).data.teacherEmail == request.auth.token.email);
        allow create, update, delete: if false;
      }
    }

    // One tiny pointer lets a teacher recover the currently active room after
    // a refresh without querying years of completed game history.
    match /liveChallengeTeacherActive/{teacherEmail} {
      allow read: if rootAdmin() || (teacher() && request.auth.token.email == teacherEmail);
      allow create, update, delete: if false;
    }

    // What a finished game left behind: which standards the class missed, who
    // never joined, and named per-student results. Students see aliases during
    // the game precisely so they are not ranked against each other by name, so
    // the report that does name them is readable only by the teacher who ran it.
    match /liveChallengeReports/{roomId} {
      allow read: if rootAdmin()
        || (teacher() && resource.data.teacherEmail == request.auth.token.email);
      allow create, update, delete: if false;
    }

    // A teacher's rehearsal of their own challenge. It holds the question ids
    // for that dry run, so it is server-only for the same reason the private
    // game state is: a document a browser can read is a document a browser can
    // be made to read. The teacher sees the questions through the callable,
    // which decides what to send.
    match /liveChallengeDryRuns/{dryRunId} {
      allow read, create, update, delete: if false;
    }

    // The durable final result of a finished match: named standings, the
    // reward policy it was played under, and the bookkeeping of its
    // finalization effects. Teachers see it through the report; nothing but
    // the server reads or writes it.
    match /liveChallengeMatchResults/{roomId} {
      allow read, write: if false;
    }

    // Question IDs, roster membership, per-student scores before public
    // anonymization, and all other private game state stay server-only.
    match /liveChallengePrivate/{roomId} {
      allow read, write: if false;
    }
    match /liveChallengePrivate/{roomId}/{document=**} {
      allow read, write: if false;
    }

    // Route history: why the adaptive path sent a student where it did. A
    // student may read their own so the app can explain a decision back to
    // them, but only the platform's teacher role writes it — a student who
    // could forge routing history could talk themselves out of remediation.
    match /pathHistory/{studentId} {
      allow read: if teacher() || ownsStudent(studentId);
      allow create, update: if teacher() || ownsStudent(studentId);
      allow delete: if teacher();
    }

    // Shared instructional content is readable after sign-in. Only teachers
    // can mutate assignments, schedules, and the secure path question bank.
    //
    // `studentOverrides` is the one field a client update may never touch,
    // whatever else it changes. It carries per-student attendance-extension
    // final cutoffs (src/platform/attendance/extensionReconciliation.js) and
    // the existing excused/reopened flags, and — like the Class Points
    // ledger below — is written only by the `applyStudentAttendanceExtension`
    // Cloud Function, which runs with Admin SDK credentials and independently
    // re-verifies the caller is this student's own class's teacher of record
    // AND that the proposed cutoff never shortens one already on file
    // (functions/shared/attendanceExtensionAuthorization.mjs). A blanket
    // `teacher()` rule has no roster/class scoping at all, so allowing this
    // field through it would let any teacher move any other class's
    // student's deadline.
    //
    // READING. Any signed-in user may open one assignment by id. LISTING is
    // narrower for a student once the transition switch is on: a student's
    // list must be their own class's assignments (assignedClassIds contains
    // the class on their roster row), so a device no longer downloads every
    // class's assignments and every other class's per-student entries.
    // Old student tabs list the whole collection, and a rule that refused
    // them would cut off their live assignment updates mid-day, so the
    // narrowing waits on `platformFlags/assignmentReadScope.studentListScoped`
    // — set by a root administrator (`setAssignmentReadScope`) once this
    // release's client has been live for a school day (PR #407 deep dive §8,
    // "pair a rule that removes access with a client release one release
    // earlier"; functions/shared/assignmentPrivacy.mjs).
    function studentAssignmentListScoped() {
      let flag = /databases/$(database)/documents/platformFlags/assignmentReadScope;
      return exists(flag) && get(flag).data.get('studentListScoped', false) == true;
    }

    function studentListsOwnClassAssignments() {
      return signedIn()
        && request.auth.token.get('role', '') == 'student'
        && resource.data.assignedClassIds.hasAny([
          rosterRow(request.auth.token.get('studentId', '')).get('classId', '')
        ]);
    }

    /*
     * ONCE THE SHARED COPY IS RETIRED, NO CLIENT PUTS PER-STUDENT DATA BACK.
     *
     * A student's controls (deadline, excusal, reopen, DOL attempts) live in
     * `studentAssignmentOverrides` (below; functions/shared/
     * studentAssignmentOverrides.mjs). Until `platformFlags/
     * assignmentOverrideStorage.sharedRetired` is set, the server mirrors them
     * onto the shared assignment for the previous release's clients, and a
     * teacher tab from that release may still write a per-student DOL grant
     * the old way (the absorber trigger moves it into private storage).
     * Once it is set — after the new client has been live for a school day —
     * a client write may not add or change any per-student field: a stale
     * tab rewriting the whole `dol` map from an old snapshot would otherwise
     * publish every classmate's grant again. `studentOverrides` itself was
     * already server-only and still is.
     */
    function sharedStudentControlsRetired() {
      let flag = /databases/$(database)/documents/platformFlags/assignmentOverrideStorage;
      return exists(flag) && get(flag).data.get('sharedRetired', false) == true;
    }

    // Same-typed empty defaults: comparing a list or map with null is an
    // evaluation error in the rules language, not `false`. An empty list or
    // map carries no student's data, so it counts as absent.
    function perStudentSharedFieldsUnchanged() {
      return request.resource.data.get('excusedStudentIds', []) == resource.data.get('excusedStudentIds', [])
        && request.resource.data.get('reopenedStudentIds', []) == resource.data.get('reopenedStudentIds', [])
        && request.resource.data.get('dol', {}).get('attemptGrantsByStudentId', {})
          == resource.data.get('dol', {}).get('attemptGrantsByStudentId', {});
    }

    function perStudentSharedFieldsAbsent() {
      return request.resource.data.get('excusedStudentIds', []).size() == 0
        && request.resource.data.get('reopenedStudentIds', []).size() == 0
        && request.resource.data.get('dol', {}).get('attemptGrantsByStudentId', {}).size() == 0;
    }

    /*
     * THE ASSESSMENT CONTRACT AND THE LIFECYCLE CHANGE THROUGH THE SERVER ONLY.
     *
     * `assessmentPolicy` decides who owes corrections and the highest grade a
     * retest can record; `testBlueprint` / `secureTestReference` decide what the
     * secure Test asks; `archived` / `unpublished` close an assessment to every
     * student. All of them are set when an assignment is CREATED, and after
     * that change only through `updateTestCyclePolicy` and
     * `manageAssignmentLifecycle` — which check the caller is the teacher of
     * record, refuse a policy change that would contradict results already
     * released, and keep an audit row. A blanket `teacher()` update could
     * otherwise let any teacher raise another class's retest cap, swap its
     * blueprint, or archive its Test mid-period. A client save that DROPS one
     * of these fields is refused too: dropping `assessmentPolicy` is exactly
     * how a Test Cycle silently became an ordinary lesson.
     *
     * DELETING an assignment can erase student evidence, so it goes through
     * `manageAssignmentLifecycle` as well, which refuses once any student has
     * worked on it and offers Archive. Only the root administrator keeps a
     * direct client delete, for repair.
     */
    function serverOwnedAssignmentFields() {
      return [
        'assessmentPolicy', 'testBlueprint', 'secureTestReference', 'assessmentPolicyHistory',
        'archived', 'archivedAt', 'archivedBy',
        'unpublished', 'unpublishedAt', 'unpublishedBy',
        'lifecycleHistory',
      ];
    }

    match /assignments/{assignmentId} {
      allow get: if signedIn();
      allow list: if teacher()
        || studentListsOwnClassAssignments()
        || (signedIn() && !studentAssignmentListScoped());
      allow create: if teacher()
        && !request.resource.data.keys().hasAny(['studentOverrides'])
        && (!sharedStudentControlsRetired() || perStudentSharedFieldsAbsent());
      allow delete: if rootAdmin();
      allow update: if teacher()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentOverrides'])
        && (rootAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedAssignmentFields()))
        && (!sharedStudentControlsRetired() || perStudentSharedFieldsUnchanged());
    }

    /*
     * ONE STUDENT'S CONTROLS ON ONE ASSIGNMENT (functions/shared/
     * studentAssignmentOverrides.mjs): their individual final cutoff, the
     * extension stub attendance reconciliation compares, excused/reopened, and
     * their DOL attempt grant. Keyed `{len}:{studentId}:{assignmentId}`.
     *
     * The student reads their own (the query the client makes is
     * `where('studentId', '==', <their id>)`), their teacher reads through the
     * record's own `authorizedTeacherEmails` (one bounded query for a whole
     * roster, never a get() per student — authorizationContext.mjs), and the
     * root administrator reads all. A classmate can neither read one nor list
     * them: every list must prove one of those three from its constraints.
     *
     * Nobody writes one from a browser — not the student, not a teacher, not
     * the root administrator. They change only through callables that check
     * the caller is the class's teacher of record (Admin SDK), so a student
     * cannot give themselves a later deadline, a reopen or an attempt, and a
     * teacher cannot touch another class's student.
     */
    match /studentAssignmentOverrides/{overrideId} {
      allow read: if rootAdmin() || ownsStudent(resource.data.studentId) || authorizedTeacher();
      allow create, update, delete: if false;
    }

    // Verbatim copies of per-student data removed from a shared assignment
    // (several students per document), and the resumable migration state.
    // Root administrator only; written only by the Admin SDK.
    match /assignmentOverrideArchives/{archiveId} {
      allow read: if rootAdmin();
      allow create, update, delete: if false;
    }

    match /platformMigrations/{migrationId} {
      allow read: if rootAdmin();
      allow create, update, delete: if false;
    }

    /*
     * A RESPONSE CHECKPOINT IS A DRAFT A STUDENT WRITES AND A FUNCTION READS.
     *
     * That combination is what makes these rules load-bearing: an Admin SDK
     * function later acts on this document, so the shape a student can write
     * must not be sufficient to forge a grade. The finalizer re-validates all
     * of it — these rules exist to reject the obviously malformed early, and
     * to pin the identity a later write must keep.
     *
     * The acknowledgement time is request.time, so an offline browser cannot
     * backdate work across a cutoff no matter what its own clock says. Secure
     * and Test Cycle responses are rejected outright and stay in their
     * dedicated server-owned state machines.
     */
    function checkpointCarriesNoGrade(data) {
      return !data.keys().hasAny([
        'isCorrect', 'score', 'grade', 'record', 'submissionEnvelope',
        'evidenceEvent', 'evidence', 'mastery', 'masteryResult',
        'partialCredit', 'partialCreditPercent', 'partGrades',
        'totalAttempts', 'attemptCount', 'answerKey', 'acceptedAnswers',
        'solution', 'seed',
      ]);
    }

    function checkpointIdentityUnchanged(incoming, existing, checkpointId) {
      return incoming.studentId == existing.studentId
        && incoming.assignmentId == existing.assignmentId
        && incoming.questionIndex == existing.questionIndex
        && incoming.questionId == existing.questionId
        && incoming.variantIndex == existing.variantIndex
        && incoming.generationKey == existing.generationKey
        && incoming.activityRole == existing.activityRole
        && incoming.documentId == checkpointId;
    }

    match /studentResponseCheckpoints/{checkpointId} {
      allow read: if rootAdmin() || ownsStudent(resource.data.studentId);
      allow create: if ownsStudent(request.resource.data.studentId)
        && request.resource.data.documentId == checkpointId
        && request.resource.data.secure == false
        && request.resource.data.schemaVersion == 2
        && request.resource.data.serverAcknowledgedAt == request.time
        && request.resource.data.status == 'active'
        // A null query time is a checkpoint that is simply never due. It is
        // allowed so an edge case (a deadline a teacher has not set yet) keeps
        // recoverable work instead of failing the student's write.
        && (request.resource.data.candidateFinalizeAt is timestamp || request.resource.data.candidateFinalizeAt == null)
        && request.resource.data.isComplete is bool
        && request.resource.data.revision is number
        && request.resource.data.previousTotalAttempts is number
        && checkpointCarriesNoGrade(request.resource.data);
      // A new revision keeps the identity and moves forward. A student may
      // also retire their own checkpoint when they submit explicitly, which
      // takes it out of the scheduler's active query.
      allow update: if ownsStudent(resource.data.studentId)
        && checkpointIdentityUnchanged(request.resource.data, resource.data, checkpointId)
        && request.resource.data.secure == false
        && request.resource.data.revision >= resource.data.revision
        && checkpointCarriesNoGrade(request.resource.data)
        && (
          (request.resource.data.status == 'active'
            && request.resource.data.serverAcknowledgedAt == request.time
            && (request.resource.data.candidateFinalizeAt is timestamp || request.resource.data.candidateFinalizeAt == null))
          || (request.resource.data.status == 'explicitly-submitted'
            && request.resource.data.candidateFinalizeAt == null)
        );
      // History is never deleted by the student it belongs to.
      allow delete: if false;
    }

    /*
     * UNFINISHED WORK, SO A CHROMEBOOK RESTART DOES NOT COST IT.
     *
     * This is a workspace, not a result: no attempt, no grade, no evidence, no
     * mastery, and nothing Google Classroom ever hears about — which is also
     * why it is deliberately NOT stored on the grades document, whose writes
     * wake Classroom passback.
     *
     * Owner-only in both directions. A student may not read another student's
     * unfinished work, which would otherwise be a way to read their answers.
     */
    /*
     * Deliberately NO monotonic revision check.
     *
     * A per-device revision is not a global ordering — device A's revision 15
     * and device B's revision 2 say nothing about which is newer — so a rule
     * built on one would lock a fresh Chromebook out of saving entirely.
     * Ordering is handled where it can be done correctly: the client merges
     * per draft key inside a transaction, newest `savedAt` winning, so two
     * devices editing different questions never conflict at all.
     */
    function workspaceDraftCarriesNoGrade(data) {
      return !data.keys().hasAny([
        'isCorrect', 'score', 'grade', 'record', 'gradesByAssignment',
        'classworkGradesByAssignment', 'dolGradesByAssignment',
        'evidenceEvent', 'evidence', 'mastery', 'partGrades', 'partialCredit',
        'totalAttempts', 'attemptCount', 'answerKey', 'acceptedAnswers',
        'solution', 'seed', 'classroomSyncStatusByAssignment',
      ]);
    }

    match /studentWorkspaceDrafts/{draftId} {
      // The client saves inside a transaction that READS the draft first, so a
      // student must be able to read their own draft before it exists. With no
      // document there is no resource.data to check; the id itself
      // ({studentId}__{assignmentId}) is what names the owner.
      allow read: if rootAdmin()
        || (resource == null
          ? ownsStudent(draftId.split('__')[0])
          : ownsStudent(resource.data.studentId));
      allow create: if ownsStudent(request.resource.data.studentId)
        && request.resource.data.documentId == draftId
        && request.resource.data.secure == false
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt == request.time
        && workspaceDraftCarriesNoGrade(request.resource.data);
      allow update: if ownsStudent(resource.data.studentId)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.assignmentId == resource.data.assignmentId
        && request.resource.data.documentId == draftId
        && request.resource.data.secure == false
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt == request.time
        && workspaceDraftCarriesNoGrade(request.resource.data);
      allow delete: if false;
    }

    /*
     * THE RECEIPT FOR ONE CANONICAL SUBMISSION.
     *
     * Written ONLY by the server ingestion callable, through the Admin SDK,
     * which bypasses these rules. It is the durable answer a student's device
     * retires its queue row against, so the student may read their own — and
     * nobody may write one, because a forged receipt would tell a Chromebook to
     * throw away work that never reached the gradebook.
     *
     * It carries no response and no grade: an action id, a disposition, a
     * reason and the attempt count the server itself wrote.
     */
    match /studentSubmissionReceipts/{receiptId} {
      // No authorizedTeacher() clause: a receipt carries no
      // `authorizedTeacherEmails` list, so that helper would deny rather than
      // grant. Teachers reach receipts only through the audited recovery report
      // callable, which runs on the Admin SDK and scopes them to their class.
      allow read: if rootAdmin() || ownsStudent(resource.data.studentId);
      allow create, update, delete: if false;
    }

    /*
     * WHAT ONE CHROMEBOOK IS STILL HOLDING.
     *
     * An IndexedDB queue is invisible to every server query, so the device
     * reports its own depth after it reconnects. Written only through the
     * audited student callable (Admin SDK), never directly: a client-writable
     * document here would let one student fabricate another's incident record.
     *
     * Counts and blocked-reason labels only. No responses, no records, nothing
     * that could become a grade.
     */
    match /studentDevicePersistenceReports/{reportId} {
      // Same reason as receipts above: the teacher's path is the recovery
      // report callable, not a direct read.
      allow read: if rootAdmin() || ownsStudent(resource.data.studentId);
      allow create, update, delete: if false;
    }

    /*
     * A PERSISTENCE INCIDENT A TEACHER OF RECORD HAS CLOSED.
     *
     * This record is what lets a final Classroom passback resume after a
     * session/canonical discrepancy has been proven unrecoverable, so a client
     * that could write one could release its own final grade. NOBODY writes
     * here from a client — not a student, not a teacher, not the root
     * administrator. The only writer is `resolveStudentPersistenceHold`, which
     * runs on the Admin SDK and bypasses these rules after checking that the
     * caller is the teacher of record for the class the student is actually in.
     *
     * This is also why the flag does not live on `grades/{studentId}`: the
     * teacher of record's client may write parts of that document, a student
     * may write its engagement field, and no field a client can reach may
     * ever release a final grade.
     *
     * Reads are for the audited teacher recovery report, which likewise runs
     * on the Admin SDK; a student may read their own so a device can explain
     * its own state without a second store.
     */
    match /studentPersistenceResolutions/{resolutionId} {
      allow read: if rootAdmin() || ownsStudent(resource.data.studentId);
      allow create, update, delete: if false;
    }

    // Broken or unfinished authoring drafts never enter the shared assignments
    // collection. They are visible only to the teacher who owns the draft (or
    // the root administrator). Ownership is immutable from the client so one
    // teacher cannot transfer a draft to another teacher by editing its UID.
    match /assignmentAuthoringDrafts/{draftId} {
      allow create: if rootAdmin() || (
        teacher()
        && request.resource.data.authoringReview.ownerUid == request.auth.uid
      );
      allow read, delete: if rootAdmin() || (
        teacher()
        && resource.data.authoringReview.ownerUid == request.auth.uid
      );
      allow update: if rootAdmin() || (
        teacher()
        && resource.data.authoringReview.ownerUid == request.auth.uid
        && request.resource.data.authoringReview.ownerUid == request.auth.uid
      );
    }

    // Private teacher review notes for normal Library assignments. Assignments
    // themselves are student-readable, so flags/repair notes must never be
    // stored on /assignments. The owner and assignment identity are immutable
    // so a browser cannot transfer a private review document to another user or
    // point it at a different assignment after creation.
    match /assignmentQuestionReviews/{reviewId} {
      allow create: if rootAdmin() || (
        teacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.assignmentId is string
      );
      allow read: if rootAdmin() || (
        teacher()
        && resource.data.ownerUid == request.auth.uid
      );
      allow update: if rootAdmin() || (
        teacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.assignmentId == resource.data.assignmentId
      );
      allow delete: if rootAdmin() || (
        teacher()
        && resource.data.ownerUid == request.auth.uid
      );
    }

    // Teacher review screenshots. Stored apart from both the assignment (which
    // students can read) and the review context (which is capped at 1 MiB and
    // read constantly), so the image never reaches a student and never bloats a
    // note. Ownership is pinned on create and immutable on update, exactly as
    // for the written notes these belong to.
    match /assignmentReviewScreenshots/{screenshotId} {
      allow create: if rootAdmin() || (
        teacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.assignmentId is string
      );
      allow read, delete: if rootAdmin() || (
        teacher()
        && resource.data.ownerUid == request.auth.uid
      );
      allow update: if rootAdmin() || (
        teacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.assignmentId == resource.data.assignmentId
      );
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if teacher();
    }

    // Platform transition switches (shared/assignmentPrivacy.mjs). Every
    // signed-in client may read them — the rules above read them too — and
    // only audited root-admin callables (Admin SDK) change them.
    match /platformFlags/{flagId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // Classes are the authoritative record of who teaches what course to whom,
    // so every screen may read them but only the audited admin callables may
    // write them. A teacher who could edit this collection could hand
    // themselves another teacher's roster.
    match /classes/{classId} {
      allow read: if signedIn();
      allow create, update, delete: if false;

      // Public Class Points announcements, nested under the class rather
      // than filtered by a `classId` field, so a student's own roster
      // membership is checked ONCE for the whole list instead of once per
      // matched document — the same cost shape `liveChallengeRooms/players`
      // already relies on below. They carry only a safe "First L." label,
      // never a studentId, so a classmate can never resolve one back to a
      // full identity or a private balance. Server-only: a client that could
      // write one could manufacture a fake announcement or leak another
      // class's activity into this one.
      match /classPointAnnouncements/{announcementId} {
        allow read: if rootAdmin()
          || (teacher()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherOfRecord == request.auth.token.email)
          || (signedIn()
            && request.auth.token.role == 'student'
            && get(/databases/$(database)/documents/grades/$(request.auth.token.studentId)).data.classId == classId);
        allow create, update, delete: if false;
      }
    }

    match /pathQuestionBank/{questionId} {
      allow read, create, update, delete: if teacher();
    }

    // Which standards My Math Path can actually issue a question for. Read by
    // the student wheel so it never offers a dead end, and by the teacher
    // coverage audit. Written only by the server, which computes it with the
    // same issuability check the runtime uses — a client that could write this
    // could make an uncovered standard look launchable.
    match /pathCoverage/{courseId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // Path Release V2 control plane.
    //
    // WHICH certified course release production is serving, and whether it is
    // active or mid-update. Readable by any signed-in client so a runtime or
    // status surface can tell "updating" from "active"; it holds a release id,
    // hashes and counts, never question or answer content. Only the path-admin
    // callables may write it, through the Admin SDK — a client that could write
    // this could tell every student the bank had been replaced.
    match /pathReleaseState/{releaseDocId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // The active release's id -> content-hash index, sharded. Question IDs are
    // administrative metadata rather than content, so this stays root-admin
    // read-only and is never client-writable.
    match /pathReleaseState/{releaseDocId}/documentIndex/{shardId} {
      allow read: if rootAdmin();
      allow create, update, delete: if false;
    }

    // One resumable release job per release, with the actor, the phase, the
    // change plan and any structured failure. Administrative diagnostics: root
    // admin reads them, nothing client-side writes them.
    match /pathReleaseJobs/{jobId} {
      allow read: if rootAdmin();
      allow create, update, delete: if false;
    }

    match /pathReleaseJobs/{jobId}/chunks/{chunkId} {
      allow read: if rootAdmin();
      allow create, update, delete: if false;
    }

    // Phase 6A private modeling criteria are never student-readable. Teachers
    // author them; grading reads them through the Admin SDK callable.
    match /modelingLabDefinitions/{labId} {
      allow read, create, update, delete: if teacher();
    }

    // Phase 6C exam item answer keys are teacher-authored. Runtime sessions,
    // responses, integrity logs, and submission markers are callable-only so
    // a student cannot bypass the server state machine with a direct write.
    match /examQuestionBank/{questionId} {
      allow read, create, update, delete: if teacher();
    }

    // Students can read their derived Phase 5 state but cannot forge it, and a
    // teacher reads it only for a student they are authorized for.
    match /studentMasteryProfiles/{studentId} {
      allow read: if rootAdmin() || ownsStudent(studentId) || authorizedTeacher();
      allow write: if rootAdmin() || authorizedTeacher();
    }

    match /studentRetentionSchedules/{studentId} {
      allow read: if rootAdmin() || ownsStudent(studentId) || authorizedTeacher();
      allow write: if rootAdmin() || authorizedTeacher();
    }

    /*
     * Immutable SIS transfer evidence. A teacher can create a snapshot only
     * for a class they own and can subsequently add only upload-confirmation
     * fields. Downloading never writes those fields. Students have no access.
     */
    match /gradeTransferSnapshots/{transferId} {
      allow read: if rootAdmin() || (teacher()
        && resource.data.teacherUid == request.auth.uid
        && get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherOfRecord == request.auth.token.email);
      allow create: if teacher()
        && request.resource.data.transferId == transferId
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherOfRecord == request.auth.token.email
        && request.resource.data.keys().hasAll(['classId', 'assignmentId', 'assignmentTitle', 'exportKind', 'createdAt', 'rows', 'withheld', 'fileName', 'packageId'])
        && !request.resource.data.keys().hasAny(['uploadConfirmedAt', 'uploadConfirmedByUid', 'uploadConfirmedByEmail']);
      allow update: if teacher()
        && resource.data.teacherUid == request.auth.uid
        && get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherOfRecord == request.auth.token.email
        // Confirmation is a one-way transition. Without these guards the
        // exporter could replace the audit timestamp or actor after upload.
        && !resource.data.keys().hasAny(['uploadConfirmedAt', 'uploadConfirmedByUid', 'uploadConfirmedByEmail'])
        && request.resource.data.keys().hasAll(['uploadConfirmedAt', 'uploadConfirmedByUid', 'uploadConfirmedByEmail'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uploadConfirmedAt', 'uploadConfirmedByUid', 'uploadConfirmedByEmail'])
        && request.resource.data.uploadConfirmedAt == request.time
        && request.resource.data.uploadConfirmedByUid == request.auth.uid
        && request.resource.data.uploadConfirmedByEmail == request.auth.token.email;
      allow delete: if false;
    }

    // Authentication internals, Classroom integration, My Math Path sessions,
    // idempotency records, and mastery-application markers are server-only.
    match /teacherIntegrations/{docId} { allow read, write: if false; }
    match /oauthStates/{stateId} { allow read, write: if false; }
    match /classroomLinks/{publicationId} { allow read, write: if false; }
    match /classroomRosterLinks/{rosterLinkId} { allow read, write: if false; }
    match /classroomGradeSyncs/{syncId} { allow read, write: if false; }
    match /studentCredentials/{docId} { allow read, write: if false; }
    match /studentAliases/{docId} { allow read, write: if false; }
    match /studentDirectory/{docId} { allow read, write: if false; }
    match /teacherDirectory/{docId} { allow read, write: if false; }
    match /adminAuditLog/{docId} { allow read, write: if false; }
    // Full-audit actor metadata, question history and platform defect reports
    // are callable-only. /assignments is student-readable and must never carry
    // this private maintenance evidence.
    match /assignmentRepairAudits/{docId} { allow read, write: if false; }
    match /assignmentRepairHistory/{docId} { allow read, write: if false; }
    match /assignmentPlatformIssues/{docId} { allow read, write: if false; }
    match /assignmentVersionEvents/{docId} { allow read, write: if false; }
    match /classJoinCodes/{docId} { allow read, write: if false; }
    match /authThrottle/{docId} { allow read, write: if false; }
    match /activePathLocks/{docId} { allow read, write: if false; }
    match /weeklyPathGoalSnapshots/{docId} { allow read, write: if false; }
    match /pathSessions/{docId} { allow read, write: if false; }
    match /pathSubmissions/{docId} { allow read, write: if false; }
    match /masteryEvidenceApplications/{docId} { allow read, write: if false; }
    match /modelingLabSubmissions/{docId} { allow read, write: if false; }
    match /examSessions/{docId} { allow read, write: if false; }
    // The Test Cycle's canonical record, its generated correction plans and its
    // generated retest plans. All three are Admin-SDK territory: the record is
    // the single source of a recorded grade, and the two plan documents hold
    // the approved families, generator seeds and private grading for questions
    // a student has not reached yet. A teacher reads them through the
    // authenticated Test Cycle callables, never from a client.
    match /testCycleRecords/{docId} { allow read, write: if false; }
    match /testCycleCorrectionPlans/{docId} { allow read, write: if false; }
    // Secure Test manifests include blueprint family ids and issuance metadata.
    // Assignments expose only an opaque reference; Functions resolve it.
    match /secureTestManifests/{docId} { allow read, write: if false; }
    match /testCycleRetestPlans/{docId} { allow read, write: if false; }
    match /examSubmissions/{docId} { allow read, write: if false; }
    // Who deleted which assignment, written by manageAssignmentLifecycle after
    // it has proved no student evidence existed. An audit trail is only worth
    // something if no client can write or erase it.
    match /assignmentDeletionLog/{docId} { allow read, write: if false; }
    match /examIntegrityEvents/{docId} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
