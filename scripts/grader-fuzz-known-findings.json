{
  "about": "Findings of the grader fuzz harness (scripts/lib/graderFuzz) that are understood and not fixed yet. A signature listed here does not fail a run; any other 'fail' finding does. Each entry says what it is, why it is left, and where it is tracked. Each entry carries a `repro` case; tests/platform/graderFuzzParity.test.mjs replays it and fails once it no longer reproduces, so an entry is deleted with the change that fixes it. An entry marked `replay: timed` depends on the machine's speed and is replayed only by hand (node scripts/fuzz-graders.mjs --replay). See docs/architecture/GRADER_FUZZ.md.",
  "findings": {
    "typedFields/unfinished-not-right/sign-after": {
      "what": "A key with a + or − left after it (`12 +`, `x=5-`) is marked right by every typed-field grader: constantTermsLast (functions/shared/answerEquivalence.mjs) drops a sign that has no term.",
      "whyLeft": "Refusing it lowers verdicts already given. It needs the owner's decision and a re-grade plan, not a quiet change.",
      "tracked": "https://github.com/matthewhawkinsus1-crypto/mathmaster-platform/issues/557",
      "repro": {
        "target": "typedFields",
        "source": "known-finding",
        "field": {
          "id": "answer",
          "label": "Answer",
          "inputProfile": "number",
          "expected": 16
        },
        "input": {
          "text": "16 +",
          "inputClass": "brokenKey",
          "detail": null
        }
      }
    },
    "typedFields/unfinished-not-right/product-sign-after": {
      "what": "A key with a product sign left after it (`4*`, `102\\times`, `1\\cdot`) is marked right: commutedProduct reads a product sign with no factor after it as nothing.",
      "whyLeft": "As above: refusing it lowers verdicts already given.",
      "tracked": "https://github.com/matthewhawkinsus1-crypto/mathmaster-platform/issues/557",
      "repro": {
        "target": "typedFields",
        "source": "known-finding",
        "field": {
          "id": "answer",
          "label": "Answer",
          "inputProfile": "number",
          "expected": 4
        },
        "input": {
          "text": "4*",
          "inputClass": "brokenKey",
          "detail": null
        }
      }
    },
    "typedFields/unfinished-not-right/product-sign-before": {
