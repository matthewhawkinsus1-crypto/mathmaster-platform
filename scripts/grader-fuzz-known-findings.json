    "typedFields/device-server-parity/over-240-characters": {
      "what": "A typed box travels to the server cut to 240 characters (normalizeOrdinaryResponse, and the attempt record), while the screen grades all of it. A right answer longer than that is right on the screen and wrong on the server. Reached only with padding (255 plus signs, brackets, spaces); no bank key's own spelling is that long.",
      "whyLeft": "The limit is part of the stored attempt record's shape; raising it, or refusing a longer answer on the screen, is a contract change.",
      "tracked": "https://github.com/matthewhawkinsus1-crypto/mathmaster-platform/issues/558",
      "repro": {
        "target": "typedFields",
        "source": "known-finding",
        "field": {
          "id": "answer",
          "label": "Answer",
          "inputProfile": "number",
          "expected": -5
        },
        "input": {
          "text": "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-5",
          "inputClass": "paddedKey",
          "detail": null
        }
      }
    },
